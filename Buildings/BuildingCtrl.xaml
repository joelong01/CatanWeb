<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.BuildingCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="White" BorderThickness="0"
            Background="Transparent" Opacity="1"
            Width="{x:Bind BuildingViewModel.Layout.BuildingSize, Mode=OneWay}"
            Height="{x:Bind BuildingViewModel.Layout.BuildingSize, Mode=OneWay}">
        <Ellipse Width="10" HorizontalAlignment="Center"
                VerticalAlignment="Center" Height="10" Fill="Red" Opacity=".75"
                Visibility="Collapsed" />
        <Ellipse Fill="{x:Bind BuildingViewModel.Background, Mode=OneWay}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Viewbox Stretch="Uniform" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="5">
            <Grid Margin="1" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <TextBlock
                        Text="{x:Bind BIND_GetStateGlyph(BuildingViewModel.Stars, BuildingViewModel.Building.BuildingState), Mode=OneWay}"
                        FontFamily="{StaticResource CatanFont}"
                        Margin="-1,0,0,1" RenderTransformOrigin="0.5 0.5"
                        TextAlignment="Center"
                        Foreground="{x:Bind BuildingViewModel.Foreground, Mode=OneWay}">
                    <TextBlock.RenderTransform>
                        <ScaleTransform
                                ScaleX="{x:Bind BuildingViewModel.Building.Metropolis, Converter={StaticResource MetroToScaleConverter}, Mode=OneWay}"
                                ScaleY="{x:Bind BuildingViewModel.Building.Metropolis, Converter={StaticResource MetroToScaleConverter}, Mode=OneWay}" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="{x:Bind LaurelGlyph}"
                        Foreground="{x:Bind BuildingViewModel.Foreground, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin=".5 .5"
                        FontFamily="{StaticResource CatanFont}"
                        FontWeight="Bold" TextAlignment="Center"
                        Visibility="{x:Bind BuildingViewModel.Building.Metropolis,Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Viewbox>

        <Grid Visibility="Collapsed">
            <Rectangle Stroke="Red" Width="3" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Fill="Red" />
            <Rectangle Stroke="Red" Height="3" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" Fill="Red" />
        </Grid>

    </Grid>
</UserControl>
