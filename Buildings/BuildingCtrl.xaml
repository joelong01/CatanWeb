<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.BuildingCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Name="LayoutRoot" HorizontalAlignment="Left" VerticalAlignment="Top"
            CornerRadius="20" BorderThickness="0"
            Opacity="{x:Bind BuildingViewModel.Opacity(BuildingViewModel.Building.Buildable), Mode=OneWay}"
            Width="{x:Bind BuildingViewModel.Layout.BuildingSize, Mode=OneWay}"
            Height="{x:Bind BuildingViewModel.Layout.BuildingSize, Mode=OneWay}"
            Background="{x:Bind BuildingViewModel.GetBackgroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}"
            BorderBrush="{x:Bind BuildingViewModel.GetForegroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
            PointerPressed="OnPointerPressed">
        <Ellipse Width="10" HorizontalAlignment="Center"
                VerticalAlignment="Center" Height="10" Fill="Red" Opacity=".75"
                Visibility="Collapsed" />
        <Ellipse Name="Ellipse_Background" Visibility="Collapsed"
                Fill="{x:Bind BuildingViewModel.GetBackgroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Stroke="{x:Bind BuildingViewModel.GetForegroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}"
                StrokeThickness="0" />

        <Viewbox Stretch="Uniform" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="5">
            <Grid Margin="1"
                    Width="{x:Bind BuildingViewModel.Layout.BuildingSize, Mode=OneWay}"
                    Height="{x:Bind BuildingViewModel.Layout.BuildingSize, Mode=OneWay}">
                <Viewbox Stretch="Uniform" Margin="-5, 0, 0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TXT_StateGlyph"
                            Text="{x:Bind BuildingViewModel.GetStateGlyph(BuildingViewModel.Building.BuildingState), Mode=OneWay}"
                            FontFamily="{StaticResource CatanFont}"
                            Margin="-1,0,0,1" RenderTransformOrigin="0.5 0.5"
                            TextAlignment="Center"
                            Foreground="{x:Bind BuildingViewModel.GetForegroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}">
                        <TextBlock.RenderTransform>
                            <ScaleTransform
                                    ScaleX="{x:Bind BuildingViewModel.Building.Metropolis, Converter={StaticResource MetroToScaleConverter}, Mode=OneWay}"
                                    ScaleY="{x:Bind BuildingViewModel.Building.Metropolis, Converter={StaticResource MetroToScaleConverter}, Mode=OneWay}" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Viewbox>
                <Viewbox HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Height="25">
                    <TextBlock Name="TB_BuildIndex" IsHitTestVisible="False"
                            Foreground="{x:Bind BuildingViewModel.GetForegroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}"
                            Text="{x:Bind BuildingViewModel.Building.BuildIndex, Mode=OneWay}"
                            Visibility="{x:Bind BuildingViewModel.ShowBuildIndex(BuildingViewModel.Building), Mode=OneWay}" />
                </Viewbox>
                <TextBlock Text="{x:Bind LaurelGlyph}"
                        Foreground="{x:Bind BuildingViewModel.GetForegroundBrush(BuildingViewModel.Building.BuildingState, BuildingViewModel.Building.OwnerId, BuildingViewModel.CurrentPlayer), Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin=".5 .5"
                        FontFamily="{StaticResource CatanFont}"
                        FontWeight="Bold" TextAlignment="Center"
                        Visibility="{x:Bind BuildingViewModel.Building.Metropolis,Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Viewbox>

        <Grid Visibility="Collapsed">
            <Rectangle Stroke="Red" Width="3" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Fill="Red" />
            <Rectangle Stroke="Red" Height="3" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" Fill="Red" />
        </Grid>

    </Grid>
</UserControl>
