{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Catan Desktop",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/DesktopApp/bin/x64/Debug/net9.0-windows10.0.22621.0/win-x64/Catan Desktop.exe",
            "args": [],
            "cwd": "${workspaceFolder}/DesktopApp",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Debug UI Test - RegularGameTest",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Tests.DesktopApp.UI/Tests.DesktopApp.UI.csproj",
                "--no-build",
                "--",
                "--test-file", "RegularGameTest.catan_test"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "externalTerminal",
            "env": {
                "CATAN_TEST_FILE": "Regular Game Test.catan_test"
            }
        },
        {
            "name": "Debug UI Test with App Attach - RegularGameTest",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Tests.DesktopApp.UI/Tests.DesktopApp.UI.csproj",
                "--no-build",
                "--",
                "--test-file", "RegularGameTest.catan_test"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "externalTerminal",
            "env": {
                "CATAN_TEST_FILE": "Regular Game Test.catan_test",
                "CATAN_DEBUG_WAIT": "true"
            }
        },
        {
            "name": "Debug UI Test - Default (Expansion-Test)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Tests.DesktopApp.UI/Tests.DesktopApp.UI.csproj",
                "--no-build"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "externalTerminal"
        },
        {
            "name": "Debug UI Test - Select File",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Tests.DesktopApp.UI/Tests.DesktopApp.UI.csproj",
                "--no-build",
                "--",
                "--test-file", "${input:testFileName}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "externalTerminal"
        },
        {
            "name": "Attach to Catan Desktop",
            "type": "coreclr",
            "request": "attach",
            "processName": "Catan Desktop.exe",
            "justMyCode": false
        },
        {
            "name": "Expansion-Replay-Test",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Tests.GameService/Tests.GameService.csproj",
                "--no-build",
                "--filter",
                "FullyQualifiedName~ReplaySharedExpansionTestFile",
                "-v",
                "normal",
                "--logger",
                "console;verbosity=detailed"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": false
        },
        {
            "name": "Debug GameService",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Catan3.GameService/bin/Debug/net9.0/Catan3.GameService.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Catan3.GameService",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole"
        },
        {
            "name": "Debug WebUI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-webui",
            "program": "${workspaceFolder}/WebUI/bin/Debug/net9.0/Catan3.WebUI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/WebUI",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole"
        },
        {
            "name": "Debug WebUI (with GameService)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "run-gameservice",
            "program": "${workspaceFolder}/WebUI/bin/Debug/net9.0/Catan3.WebUI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/WebUI",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole"
        }
    ],
    "compounds": [
        {
            "name": "WebUI + GameService",
            "configurations": ["Debug GameService", "Debug WebUI"],
            "stopAll": true
        }
    ],
    "inputs": [
        {
            "id": "testFileName",
            "type": "pickString",
            "description": "Select the test file to run",
            "options": [
                "RegularGameTest.catan_test",
                "Expansion-Test.catan_test"
            ],
            "default": "RegularGameTest.catan_test"
        }
    ]
} 