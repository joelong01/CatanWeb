{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Catan.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-desktop",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/DesktopApp/Catan Desktop.csproj",
                "-c", "Debug",
                "-p:Platform=x64",
                "--self-contained",
                "-r", "win-x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-and-publish",
            "dependsOrder": "sequence",
            "dependsOn": ["build", "publish-desktop"]
        }
    ]
} 