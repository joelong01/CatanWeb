<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Catan3.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3" x:Name="PAGE_MainPage"
        xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" RightTapped="OnRightButtonTapped" KeyUp="OnKeyUp"
        xmlns:c="using:Catan3.Controls" Background="DarkGray"
        xmlns:models="using:Catan3.Models"
        d:DataContext="{d:DesignInstance Type=models:GameViewModel}">
    <Page.Resources>
        <Style TargetType="Rectangle" x:Key="RECT_ResourceCard">

            <Setter Property="Width" Value="67" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="RadiusX" Value="5" />
            <Setter Property="RadiusY" Value="5" />
            <Setter Property="Margin" Value="1" />
        </Style>

    </Page.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="DarkGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*" x:Name="CD_ColumnOne" />
            <ColumnDefinition Width="Auto" MinWidth="5" />
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="Auto" MinWidth="5" />
            <ColumnDefinition Width="25*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto" VerticalAlignment="Top"
                HorizontalAlignment="Left">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                    ScrollViewer.VerticalScrollMode="Auto" Margin="10">
                <TextBlock FontSize="20"
                        Text="{x:Bind MainPageModel.GameViewModel.Id, Mode=OneWay}" />
                <Button Content="New Game" Click="OnNewGame" Background="Black"
                        Foreground="White" />
                <Button Content="Shuffle"
                        Command="{x:Bind MainPageModel.GameViewModel.ShuffleCommand, Mode=OneWay}"
                        Background="Black" Foreground="White" />

                <Button Content="Update Layout" Click="OnUpdateLayout" />

                <!--Availabe Players-->
                <TextBlock Text="Players" Foreground="Black" />
                <ComboBox ItemsSource="{x:Bind AvailablePlayers, Mode=OneWay}"
                        Foreground="Black" HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="200">

                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <CheckBox HorizontalAlignment="Right"
                                        IsChecked="{Binding Playing, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--Current Player (and Playing Players)-->
                <TextBlock Text="Current Player" Foreground="Black" />
                <ComboBox
                        ItemsSource="{x:Bind MainPageModel.GameViewModel.Players, Mode=OneWay}"
                        SelectedItem="{x:Bind MainPageModel.GameViewModel.CurrentPlayer, Mode=OneWay}"
                        DisplayMemberPath="Name" Foreground="Black"
                        HorizontalAlignment="Left" VerticalAlignment="Top">

                </ComboBox>

                <!--Rolls -->

                <StackPanel HorizontalAlignment="Stretch" Background="Blue"
                        CornerRadius="5">
                    <Viewbox Height="120" Stretch="Uniform">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Stretch">
                            <c:SingleRoll Number="2"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="3"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="4"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                        </StackPanel>
                    </Viewbox>
                    <Viewbox Height="120" Stretch="Uniform">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Stretch">
                            <c:SingleRoll Number="5"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="6"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="7"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                        </StackPanel>
                    </Viewbox>
                    <Viewbox Height="120" Stretch="Uniform">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Stretch">
                            <c:SingleRoll Number="8"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="9"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="10"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                        </StackPanel>
                    </Viewbox>
                    <Viewbox Height="120" Stretch="Uniform">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Stretch">
                            <c:SingleRoll Number="11"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                            <c:SingleRoll Number="12"
                                    GameRolls="{x:Bind MainPageModel.GameViewModel.GameRollViewModel, Mode=OneWay}"
                                    TurnRoll="{x:Bind MainPageModel.GameViewModel.TurnRollViewModel, Mode=OneWay}" />
                        </StackPanel>
                    </Viewbox>

                </StackPanel>
                <Button
                        Command="{x:Bind MainPageModel.GameViewModel.NextPlayerCommand, Mode=OneWay}"
                        Content="Next Player" />
                <!--Game Type-->
                <TextBlock Text="Game Type" Foreground="Black" />
                <ComboBox ItemsSource="{x:Bind Games, Mode=OneWay}"
                        SelectedItem="{x:Bind SelectedGame, Mode=TwoWay}"
                        Foreground="Black" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Width="200" />

                <Button Content="Flip Orientation"
                        Command="{x:Bind MainPageModel.GameViewModel.FlipOrientationCommand, Mode=OneWay}"
                        Background="Black" Foreground="White" />
                <Button Content="Do Misc" Click="OnHitMe" Background="Black"
                        Foreground="White" />
                <Button Content="Save" Background="Black" Foreground="White"
                        Command="{x:Bind MainPageModel.SaveCommand, Mode=OneWay}" />
                <Button Content="Save As..." Background="Black"
                        Foreground="White"
                        Command="{x:Bind MainPageModel.SaveAsCommand, Mode=OneWay}" />
                <Button Content="Open..." Background="Black" Foreground="White"
                        Command="{x:Bind MainPageModel.OpenCommand, Mode=OneWay}" />

            </StackPanel>

        </ScrollViewer>

        <c:GameControls ViewModel="{x:Bind MainPageModel, Mode=OneWay}"
                Grid.Column="2" Canvas.ZIndex="9999" HorizontalAlignment="Left"
                VerticalAlignment="Top" />

        <Border BorderBrush="Blue" BorderThickness="0" Grid.Column="2"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Grid.ColumnSpan="1">
            <Viewbox Stretch="Uniform" Margin="2">
                <c:GameBoardCtrl
                        GameViewModel="{x:Bind MainPageModel.GameViewModel, Mode=OneWay}" />
            </Viewbox>
        </Border>

        <Border BorderBrush="Black" BorderThickness="2"
                Background="{x:Bind MainPageModel.GameViewModel.CurrentPlayer.GetBrush(MainPageModel.GameViewModel.CurrentPlayer.Background, x:False), Mode=OneWay}"
                VerticalAlignment="Bottom">
            <c:BoardMeasurementCtrl
                    GameViewModel="{x:Bind MainPageModel.GameViewModel, Mode=OneWay}" />
        </Border>
        <!--The far right column that has the total resources for the game and a list of player information-->
        <StackPanel Grid.Column="4" HorizontalAlignment="Stretch"
                Background="DarkOliveGreen">
            <c:TrackedResourcesCtrl
                    ResourcesViewModel="{x:Bind MainPageModel.GameViewModel.GameResources, Mode=OneWay}" />
            <ItemsControl
                    ItemsSource="{x:Bind MainPageModel.GameViewModel.Players, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Stretch"
                                Margin="10,0,0,0" Padding="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Padding" Value="0" />

                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PlayerViewModel">
                        <c:PlayerCtrl PlayerViewModel="{x:Bind Mode=OneWay}" />
                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </StackPanel>

        <toolkit:GridSplitter Grid.Column="1" Width="5"
                HorizontalAlignment="Stretch" Background="Gray">
            <toolkit:GridSplitter.RenderTransform>
                <CompositeTransform TranslateX="-5" />
            </toolkit:GridSplitter.RenderTransform>
        </toolkit:GridSplitter>
        <toolkit:GridSplitter Grid.Column="3" Width="5"
                HorizontalAlignment="Stretch" Background="Gray">
            <toolkit:GridSplitter.RenderTransform>
                <CompositeTransform TranslateX="5" />
            </toolkit:GridSplitter.RenderTransform>
        </toolkit:GridSplitter>
    </Grid>
</Page>
