<UserControl x:Class="Catan3.Controls.RoadCtrl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:c="using:Catan3.Controls"
        xmlns:models="using:Catan3.Models" d:DataContext="{d:DesignInstance Type=models:RoadViewModel}" mc:Ignorable="d"
        d:DesignHeight="12" d:DesignWidth="70.8">
    <UserControl.Resources>
        <Style x:Key="RoadLineStyle" TargetType="Line">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeEndLineCap" Value="Triangle" />
            <Setter Property="StrokeStartLineCap" Value="Triangle" />
        </Style>
    </UserControl.Resources>

    <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.ZIndex="100" 
            PointerPressed="Grid_PointerPressed" IsHitTestVisible="True" 
            RenderTransformOrigin=".5 .5">
        <Polygon Fill="{x:Bind ViewModel.Background, Mode=TwoWay}" Points="{x:Bind ViewModel.RoadPolygon, Mode=OneWay}" 
                Stroke="HotPink" StrokeThickness="{x:Bind ViewModel.Layout.RoadStrokeThickness, Mode=OneWay}" />
        <Ellipse Width="10" Height="10" Fill="Green" />
        <!--<Viewbox Stretch="Uniform" Height="20" HorizontalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.PositionShortName, Mode=OneWay}" FontSize="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
        </Viewbox>-->
        <Canvas.RenderTransform>
            <RotateTransform Angle="{Binding Angle, Mode=OneWay}" />
        </Canvas.RenderTransform>
    </Canvas>

</UserControl>
