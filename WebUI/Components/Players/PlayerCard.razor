@using Catan3.Shared.Models
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services

@inject GameServiceConfig Config

<div class="player-card @GetFlipClass() @(IsPortrait ? "portrait" : "")" data-testid="player-card-@Player.Id">
    <div class="card-inner">
        <!-- Front: Normal player tile with stats -->
        <div class="card-front">
            <PlayerTile Player="@Player"
                        GameModel="@GameModel"
                        PlayerColors="@PlayerColors"
                        PlayerProfile="@PlayerProfile"
                        IsPortrait="@IsPortrait" />
        </div>

        <!-- Back: Either GoFirst or Supplemental, depending on FlipMode -->
        @if (FlipMode == CardFlipMode.GoFirst)
        {
            <!-- GoFirst back: Go First button + avatar + name -->
            <div class="card-back card-back-gofirst" style="@GetBackgroundStyle()">
                <button class="go-first-btn" @onclick="OnGoFirstClick" data-testid="go-first-@Player.Id">
                    Go First
                </button>
                <div class="player-avatar">
                    @if (!string.IsNullOrEmpty(GetPlayerImageUrl()))
                    {
                        <img src="@GetPlayerImageUrl()" alt="@Player.Name" />
                    }
                    else
                    {
                        <div class="avatar-placeholder">@GetInitial()</div>
                    }
                </div>
                <div class="player-name">@Player.Name</div>
            </div>
        }
        else if (FlipMode == CardFlipMode.Supplemental)
        {
            <!-- Supplemental back: Checkbox + avatar + name -->
            <div class="card-back card-back-supplemental @(IsCurrentPlayer ? "disabled" : "")" style="@GetBackgroundStyle()">
                <div class="supplemental-checkbox-area">
                    <label class="supplemental-checkbox @(IsCurrentPlayer ? "disabled" : "")">
                        <input type="checkbox"
                               checked="@Player.ParticipatingInSupplemental"
                               disabled="@IsCurrentPlayer"
                               @onchange="OnSupplementalCheckChanged" />
                        <span class="checkmark"></span>
                        <span class="checkbox-label">Participate in Supplemental</span>
                    </label>
                </div>
                <div class="player-avatar @(IsCurrentPlayer ? "grayed" : "")">
                    @if (!string.IsNullOrEmpty(GetPlayerImageUrl()))
                    {
                        <img src="@GetPlayerImageUrl()" alt="@Player.Name" />
                    }
                    else
                    {
                        <div class="avatar-placeholder">@GetInitial()</div>
                    }
                </div>
                <div class="player-name @(IsCurrentPlayer ? "grayed" : "")">@Player.Name</div>
            </div>
        }
        else if (FlipMode == CardFlipMode.VictoryPoints)
        {
            <!-- Victory Points back: VP entry + avatar + name -->
            <div class="card-back card-back-vp" style="@GetBackgroundStyle()">
                <div class="vp-input-area">
                    <label class="vp-label">Victory Points:</label>
                    <input type="number"
                           class="vp-input"
                           min="0"
                           max="5"
                           value="@VictoryPointsValue"
                           @onchange="HandleVictoryPointsChanged"
                           data-testid="vp-input-@Player.Id" />
                </div>
                <div class="player-avatar">
                    @if (!string.IsNullOrEmpty(GetPlayerImageUrl()))
                    {
                        <img src="@GetPlayerImageUrl()" alt="@Player.Name" />
                    }
                    else
                    {
                        <div class="avatar-placeholder">@GetInitial()</div>
                    }
                </div>
                <div class="player-name">@Player.Name</div>
            </div>
        }
        else
        {
            <!-- Normal (hidden) back - just a placeholder for non-flipped state -->
            <div class="card-back" style="@GetBackgroundStyle()"></div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Defines the flip modes for the player card.
    /// </summary>
    public enum CardFlipMode
    {
        /// <summary>Normal display - no flip, showing player stats.</summary>
        None,
        /// <summary>Flip to show "Go First" button for roll order selection.</summary>
        GoFirst,
        /// <summary>Flip to show supplemental participation checkbox.</summary>
        Supplemental,
        /// <summary>Flip to show Victory Point entry at game end.</summary>
        VictoryPoints
    }

    /// <summary>
    /// The player model for this card.
    /// </summary>
    [Parameter, EditorRequired]
    public PlayerModel Player { get; set; } = null!;

    /// <summary>
    /// The current game model for calculating derived stats.
    /// </summary>
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = null!;

    /// <summary>
    /// The player's gradient colors for visual styling.
    /// </summary>
    [Parameter]
    public PlayerColors? PlayerColors { get; set; }

    /// <summary>
    /// The player's profile information including image URI.
    /// </summary>
    [Parameter]
    public PlayerProfile? PlayerProfile { get; set; }

    /// <summary>
    /// The flip mode for this card (None, GoFirst, or Supplemental).
    /// </summary>
    [Parameter]
    public CardFlipMode FlipMode { get; set; } = CardFlipMode.None;

    /// <summary>
    /// Whether this is the current player (used for supplemental - current player can't participate).
    /// </summary>
    [Parameter]
    public bool IsCurrentPlayer { get; set; }

    /// <summary>
    /// Callback when the "Go First" button is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnGoFirst { get; set; }

    /// <summary>
    /// Callback when the supplemental participation checkbox changes.
    /// </summary>
    [Parameter]
    public EventCallback<(string PlayerId, bool Participating)> OnSupplementalChanged { get; set; }

    /// <summary>
    /// Callback when the Victory Points value changes.
    /// </summary>
    [Parameter]
    public EventCallback<(string PlayerId, int VictoryPoints)> OnVictoryPointsChanged { get; set; }

    /// <summary>
    /// The current VP value to display (from parent's local storage).
    /// </summary>
    [Parameter]
    public int VictoryPointsValue { get; set; }

    /// <summary>
    /// Whether the layout is in portrait mode (affects sizing).
    /// </summary>
    [Parameter]
    public bool IsPortrait { get; set; }

    /// <summary>
    /// Gets the CSS class for the flip state.
    /// </summary>
    private string GetFlipClass()
    {
        return FlipMode != CardFlipMode.None ? "flipped" : "";
    }

    /// <summary>
    /// Gets inline CSS style for the card back using player colors.
    /// </summary>
    private string GetBackgroundStyle()
    {
        if (PlayerColors == null) return "background: #666;";
        return $"background: {PlayerColors.CssGradient}; border-color: {PlayerColors.Foreground};";
    }

    /// <summary>
    /// Gets the full URL for the player's profile image.
    /// </summary>
    private string GetPlayerImageUrl()
    {
        if (PlayerProfile != null && !string.IsNullOrEmpty(PlayerProfile.ImageUri))
        {
            return $"{Config.BaseUrl}{PlayerProfile.ImageUri}";
        }
        return string.Empty;
    }

    /// <summary>
    /// Gets the first character of the player's name for the avatar placeholder.
    /// </summary>
    private string GetInitial()
    {
        return string.IsNullOrEmpty(Player.Name) ? "?" : Player.Name.Substring(0, 1).ToUpper();
    }

    /// <summary>
    /// Handles the Go First button click.
    /// </summary>
    private async Task OnGoFirstClick()
    {
        await OnGoFirst.InvokeAsync(Player.Id);
    }

    /// <summary>
    /// Handles the supplemental checkbox change.
    /// </summary>
    private async Task OnSupplementalCheckChanged(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        await OnSupplementalChanged.InvokeAsync((Player.Id, isChecked));
    }

    /// <summary>
    /// Handles the Victory Points input change.
    /// </summary>
    private async Task HandleVictoryPointsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var vpCount))
        {
            // Clamp to valid range
            vpCount = Math.Max(0, Math.Min(5, vpCount));
            await OnVictoryPointsChanged.InvokeAsync((Player.Id, vpCount));
        }
    }
}
