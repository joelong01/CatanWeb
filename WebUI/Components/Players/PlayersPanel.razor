@using Catan3.Shared.Models
@using Catan3.Shared.Profiles
@using static Catan3.WebUI.Components.Players.PlayerCard

<div class="players-panel @(IsSupplementalPhase ? "supplemental-phase" : "") @(IsPickingSupplemental ? "picking-supplemental" : "") @(IsPortrait ? "portrait" : "")" data-testid="players-panel">
    @* Done button for PickSupplementalPlayers or VP entry - same size as a player card *@
    @if (IsPickingSupplemental)
    {
        <button class="supplemental-done-button" @onclick="OnDoneClicked">
            Done
        </button>
    }
    @if (IsVPEntryPhase && HasPlayersWithDevCards())
    {
        <button class="supplemental-done-button" @onclick="OnVPDoneClicked">
            Done
        </button>
    }
    @foreach (var player in GetVisiblePlayers())
    {
        var playerColors = GetPlayerColors(player.Id);
        var playerProfile = GetPlayerProfile(player.Id);
        var flipMode = GetFlipMode(player);
        var isCurrentPlayer = player.Id == GameModel.CurrentPlayerId;
        <PlayerCard Player="@player"
                    GameModel="@GameModel"
                    PlayerColors="@playerColors"
                    PlayerProfile="@playerProfile"
                    FlipMode="@flipMode"
                    IsCurrentPlayer="@isCurrentPlayer"
                    IsPortrait="@IsPortrait"
                    OnGoFirst="@OnGoFirst"
                    OnSupplementalChanged="@OnSupplementalChanged"
                    OnVictoryPointsChanged="@HandleLocalVPChange"
                    VictoryPointsValue="@GetLocalVPValue(player.Id)" />
    }
</div>

@code {
    /// <summary>
    /// The current game model containing all players and game state.
    /// </summary>
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = null!;

    /// <summary>
    /// Dictionary mapping player IDs to their PlayerColors for gradient display.
    /// </summary>
    [Parameter, EditorRequired]
    public Dictionary<string, PlayerColors> PlayerColorMap { get; set; } = new();

    /// <summary>
    /// Dictionary mapping player IDs to their full PlayerProfile data.
    /// </summary>
    [Parameter, EditorRequired]
    public Dictionary<string, PlayerProfile> PlayerProfiles { get; set; } = new();

    /// <summary>
    /// Callback when a player clicks "Go First" during roll order selection.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnGoFirst { get; set; }

    /// <summary>
    /// Callback when a player's supplemental participation changes.
    /// </summary>
    [Parameter]
    public EventCallback<(string PlayerId, bool Participating)> OnSupplementalChanged { get; set; }

    /// <summary>
    /// Callback when the Done button is clicked during PickSupplementalPlayers.
    /// Calls Next on the service and switches back to Board tab.
    /// </summary>
    [Parameter]
    public EventCallback OnPickingSupplementalDone { get; set; }

    /// <summary>
    /// Callback when VP entry is complete. Passes dictionary of PlayerId -> VP count.
    /// </summary>
    [Parameter]
    public EventCallback<Dictionary<string, int>> OnVictoryPointsDone { get; set; }

    /// <summary>
    /// Local storage for VP entries before submission.
    /// </summary>
    private Dictionary<string, int> _localVPEntries = new();

    /// <summary>
    /// Whether the layout is in portrait mode (affects sizing and alignment).
    /// </summary>
    [Parameter]
    public bool IsPortrait { get; set; }

    /// <summary>
    /// Whether we're in the VP entry phase (after winner confirmed, before API call).
    /// Passed from parent - triggers VP entry UI for players with dev cards.
    /// </summary>
    [Parameter]
    public bool IsVPEntryPhase { get; set; }

    /// <summary>
    /// Whether we're in the Supplemental build phase (not PickSupplementalPlayers).
    /// </summary>
    private bool IsSupplementalPhase => GameModel.GameState == GameState.Supplemental;

    /// <summary>
    /// Whether we're picking supplemental players.
    /// </summary>
    private bool IsPickingSupplemental => GameModel.GameState == GameState.PickSupplementalPlayers;

    /// <summary>
    /// Gets the players to display.
    /// - During PickSupplementalPlayers: exclude current player (they can't participate)
    /// - During Supplemental build phase: only show participating players
    /// </summary>
    private IEnumerable<PlayerModel> GetVisiblePlayers()
    {
        // During PickSupplementalPlayers, exclude the current player (they can't participate anyway)
        if (IsPickingSupplemental)
        {
            return GameModel.Players.Where(p => p.Id != GameModel.CurrentPlayerId);
        }
        // During the Supplemental build phase, only show participating players
        if (IsSupplementalPhase)
        {
            return GameModel.Players.Where(p => p.ParticipatingInSupplemental);
        }
        // All other states show all players
        return GameModel.Players;
    }

    /// <summary>
    /// Handles the Done button click during PickSupplementalPlayers.
    /// </summary>
    private async Task OnDoneClicked()
    {
        await OnPickingSupplementalDone.InvokeAsync();
    }

    /// <summary>
    /// Determines the flip mode based on game state and player.
    /// </summary>
    /// <param name="player">The player to determine flip mode for.</param>
    private CardFlipMode GetFlipMode(PlayerModel player)
    {
        if (GameModel.GameState == GameState.FinishedRollOrder)
        {
            return CardFlipMode.GoFirst;
        }
        if (GameModel.GameState == GameState.PickSupplementalPlayers)
        {
            return CardFlipMode.Supplemental;
        }
        // VP entry phase is triggered by parent (after winner confirm, before API call)
        if (IsVPEntryPhase)
        {
            // Only flip cards for players who have dev cards
            var devCardCount = player.SpentEntitlementsThisGame.Count(e => e == Entitlement.DevCard);
            if (devCardCount > 0)
            {
                return CardFlipMode.VictoryPoints;
            }
        }
        return CardFlipMode.None;
    }

    /// <summary>
    /// Gets the PlayerColors for a specific player ID.
    /// </summary>
    /// <param name="playerId">The player ID to look up colors for.</param>
    /// <returns>PlayerColors if found in map, null otherwise.</returns>
    private PlayerColors? GetPlayerColors(string playerId)
    {
        return PlayerColorMap.TryGetValue(playerId, out var colors) ? colors : null;
    }

    /// <summary>
    /// Gets the PlayerProfile for a specific player ID.
    /// </summary>
    /// <param name="playerId">The player ID to look up profile for.</param>
    /// <returns>PlayerProfile if found in map, null otherwise.</returns>
    private PlayerProfile? GetPlayerProfile(string playerId)
    {
        return PlayerProfiles.TryGetValue(playerId, out var profile) ? profile : null;
    }

    /// <summary>
    /// Checks if any players have dev cards (need VP entry).
    /// </summary>
    private bool HasPlayersWithDevCards()
    {
        return GameModel.Players.Any(p =>
            p.SpentEntitlementsThisGame.Count(e => e == Entitlement.DevCard) > 0);
    }

    /// <summary>
    /// Handles local VP change - stores in dictionary without sending to server.
    /// </summary>
    private void HandleLocalVPChange((string PlayerId, int VictoryPoints) args)
    {
        _localVPEntries[args.PlayerId] = args.VictoryPoints;
    }

    /// <summary>
    /// Gets the local VP value for a player, or their current model value.
    /// </summary>
    private int GetLocalVPValue(string playerId)
    {
        if (_localVPEntries.TryGetValue(playerId, out var vp))
        {
            return vp;
        }
        var player = GameModel.Players.FirstOrDefault(p => p.Id == playerId);
        return player?.VictoryPointCards ?? 0;
    }

    /// <summary>
    /// Handles Done button click for VP entry - submits all VP values.
    /// </summary>
    private async Task OnVPDoneClicked()
    {
        // Build dictionary of all players with dev cards and their VP values
        var vpSubmission = new Dictionary<string, int>();
        foreach (var player in GameModel.Players)
        {
            var devCardCount = player.SpentEntitlementsThisGame.Count(e => e == Entitlement.DevCard);
            if (devCardCount > 0)
            {
                vpSubmission[player.Id] = GetLocalVPValue(player.Id);
            }
        }

        await OnVictoryPointsDone.InvokeAsync(vpSubmission);

        // Clear local entries after submission
        _localVPEntries.Clear();
    }
}
