@using Catan3.Shared.Models
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering

@*
    BaseLayer - Renders tiles (including gold tile backgrounds), numbers, and harbors.
    Re-renders when tile layout changes OR when tiles become gold.
    GoldTilesLayer renders the small resource card indicator on gold tiles.
*@

<g class="base-layer">
    @* Background rect *@
    <rect width="100%" height="100%" fill="@BoardSvgConstants.BackgroundColor" />

    @* Render tiles (including gold backgrounds when TemporarilyGold is true) *@
    @{ var tileIndex = 1; }
    @foreach (var tile in Tiles)
    {
        @((MarkupString)RenderTile(tile, tileIndex++))
    }

    @* Render harbors *@
    @foreach (var harbor in Harbors)
    {
        @((MarkupString)harbor.RenderSvg())
    }
</g>

@code {
    /// <summary>
    /// List of tile models to render.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TileModel> Tiles { get; set; } = [];

    /// <summary>
    /// List of harbor models to render.
    /// </summary>
    [Parameter]
    public IReadOnlyList<HarborModel> Harbors { get; set; } = [];

    /// <summary>
    /// Asset service for theme-aware path resolution.
    /// </summary>
    [Parameter]
    public IAssetService? AssetService { get; set; }

    /// <summary>
    /// The last rolled number (2-12). When set, tiles not matching this number are dimmed.
    /// </summary>
    [Parameter]
    public int? RolledNumber { get; set; }

    // Track previous state for ShouldRender optimization
    private int _previousTileHash;
    private int _previousHarborHash;

    // Track previous rolled number for ShouldRender
    private int? _previousRolledNumber;

    /// <summary>
    /// Re-render when tile/harbor layout changes, tiles become gold, OR rolled number changes.
    /// </summary>
    protected override bool ShouldRender()
    {
        var tileHash = ComputeTileHash(Tiles);
        var harborHash = ComputeHarborHash(Harbors);
        var rolledNumberChanged = RolledNumber != _previousRolledNumber;

        if (tileHash != _previousTileHash || harborHash != _previousHarborHash || rolledNumberChanged)
        {
            Console.WriteLine($"[BaseLayer] RE-RENDERING: tileHash changed={tileHash != _previousTileHash}, harborHash changed={harborHash != _previousHarborHash}, rolledNumber changed={rolledNumberChanged}");
            _previousTileHash = tileHash;
            _previousHarborHash = harborHash;
            _previousRolledNumber = RolledNumber;
            return true;
        }
        return false;
    }

    /// <summary>
    /// Renders a tile including gold background if TemporarilyGold is true.
    /// Includes tile index label (visibility controlled by CSS class on parent).
    /// Dims tiles that don't match the rolled number.
    /// </summary>
    private string RenderTile(TileModel tile, int index)
    {
        // Dim tiles that don't match the rolled number (if a number was rolled)
        var isDimmed = RolledNumber.HasValue && tile.Number != RolledNumber.Value && tile.Number > 0;
        return tile.RenderSvg(isDimmed: isDimmed, index: index);
    }

    /// <summary>
    /// Computes hash based on tile layout (position, resource type, number, gold state).
    /// Includes TemporarilyGold so TileSvgRenderer can render gold backgrounds.
    /// </summary>
    private static int ComputeTileHash(IReadOnlyList<TileModel> tiles)
    {
        unchecked
        {
            int hash = 17;
            foreach (var tile in tiles)
            {
                hash = hash * 31 + (int)tile.ResourceTileType;
                hash = hash * 31 + tile.Number;
                hash = hash * 31 + tile.TileKey.Q;
                hash = hash * 31 + tile.TileKey.R;
                // Include Highlighted state since it affects tile border
                hash = hash * 31 + (tile.Highlighted ? 1 : 0);
                // Include TemporarilyGold so TileSvgRenderer renders gold backgrounds
                hash = hash * 31 + (tile.TemporarilyGold ? 1 : 0);
            }
            return hash;
        }
    }

    /// <summary>
    /// Computes hash based on harbor layout (position, type).
    /// </summary>
    private static int ComputeHarborHash(IReadOnlyList<HarborModel> harbors)
    {
        unchecked
        {
            int hash = 17;
            foreach (var harbor in harbors)
            {
                hash = hash * 31 + (int)harbor.HarborKey.HarborType;
                hash = hash * 31 + harbor.HarborKey.HexCoordinates.Q;
                hash = hash * 31 + harbor.HarborKey.HexCoordinates.R;
                hash = hash * 31 + (int)harbor.HarborKey.Side;
            }
            return hash;
        }
    }
}
