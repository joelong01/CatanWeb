@using Catan3.Shared.Models
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering

@*
    GoldTilesLayer - Renders gold tile overlays when tiles are temporarily gold.
    Only re-renders when the set of gold tiles changes (turn start/end).
*@

<g class="gold-tiles-layer">
    @foreach (var tile in GoldTiles)
    {
        @((MarkupString)RenderGoldOverlay(tile))
    }
</g>

@code {
    /// <summary>
    /// List of all tile models (we filter for TemporarilyGold tiles).
    /// </summary>
    [Parameter]
    public IReadOnlyList<TileModel> Tiles { get; set; } = [];

    /// <summary>
    /// Asset service for theme-aware path resolution.
    /// </summary>
    [Parameter]
    public IAssetService? AssetService { get; set; }

    /// <summary>
    /// Filtered list of tiles that are currently gold.
    /// </summary>
    private IEnumerable<TileModel> GoldTiles => Tiles.Where(t => t.TemporarilyGold);

    // Track previous state for ShouldRender optimization
    private HashSet<HexCoordinates>? _previousGoldTileKeys;

    /// <summary>
    /// Only re-render when the set of gold tiles changes.
    /// </summary>
    protected override bool ShouldRender()
    {
        var currentGoldKeys = Tiles
            .Where(t => t.TemporarilyGold)
            .Select(t => t.TileKey)
            .ToHashSet();

        if (!SetEquals(_previousGoldTileKeys, currentGoldKeys))
        {
            _previousGoldTileKeys = currentGoldKeys;
            return true;
        }
        return false;
    }

    /// <summary>
    /// Renders the gold overlay for a tile - just the original resource card indicator.
    /// The gold mine background is already rendered by TileSvgRenderer when TemporarilyGold is true.
    /// We do NOT render a hex overlay here as it would cover the number token.
    /// </summary>
    private string RenderGoldOverlay(TileModel tile)
    {
        var sb = new System.Text.StringBuilder();
        var (x, y) = BoardGeometry.AxialToPixel(tile.TileKey.Q, tile.TileKey.R);

        sb.AppendLine($@"  <g class=""gold-overlay"" data-q=""{tile.TileKey.Q}"" data-r=""{tile.TileKey.R}"">");

        // Small card showing original resource type (number token stays in place from BaseLayer)
        RenderOriginalResourceCard(sb, x, y, tile.ResourceTileType);

        sb.AppendLine("  </g>");
        return sb.ToString();
    }

    /// <summary>
    /// Renders a small card showing the original resource type before it became gold.
    /// Matches the style of resource cards - just the image, no white border.
    /// </summary>
    private void RenderOriginalResourceCard(System.Text.StringBuilder sb, double x, double y, ResourceType originalResource)
    {
        const double cardWidth = 40;
        const double cardHeight = 60;
        const double cornerRadius = 4;
        var cardX = x - cardWidth / 2;
        // Positioned below number token, moved up by half road width so it doesn't sit under roads
        var cardY = y + 30 - BoardSvgConstants.InnerHexStrokeThickness / 2;

        var imagePath = GetResourceCardPath(originalResource);
        var clipId = $"gold-card-clip-{x:F0}-{y:F0}";

        // Define clip path for rounded corners
        sb.AppendLine($@"    <defs>");
        sb.AppendLine($@"      <clipPath id=""{clipId}"">");
        sb.AppendLine($@"        <rect x=""{cardX}"" y=""{cardY}"" width=""{cardWidth}"" height=""{cardHeight}"" rx=""{cornerRadius}""/>");
        sb.AppendLine($@"      </clipPath>");
        sb.AppendLine($@"    </defs>");

        // Resource image with rounded corners, no border
        sb.AppendLine($@"    <image href=""{imagePath}"" x=""{cardX}"" y=""{cardY}"" width=""{cardWidth}"" height=""{cardHeight}"" preserveAspectRatio=""xMidYMid slice"" clip-path=""url(#{clipId})"" class=""gold-indicator""/>");
    }

    private string GetResourceCardPath(ResourceType resourceType)
    {
        if (AssetService == null) return "";

        var assetName = resourceType switch
        {
            ResourceType.Brick => AssetName.CardBrick,
            ResourceType.Wheat => AssetName.CardWheat,
            ResourceType.Wood => AssetName.CardWood,
            ResourceType.Ore => AssetName.CardOre,
            ResourceType.Sheep => AssetName.CardSheep,
            _ => AssetName.CardBack
        };
        return AssetService.GetAssetPath(assetName);
    }

    private static bool SetEquals<T>(HashSet<T>? a, HashSet<T>? b)
    {
        if (a == null && b == null) return true;
        if (a == null || b == null) return false;
        if (a.Count != b.Count) return false;
        return a.SetEquals(b);
    }
}
