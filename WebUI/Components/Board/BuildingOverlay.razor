@using Catan3.Shared.Models
@using Catan3.Shared.Extensions
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services.Rendering

@*
    BuildingOverlay - Renders ALL buildings as SVG elements using transform for positioning.

    Renders:
    - Owned buildings (settlements/cities) with owner colors and Catan font glyph
    - Buildable spots with current player colors and star count
    - During PickingBoard: shows stars for evaluating board quality

    Uses SVG coordinate system (same as tiles/robber) for perfect alignment.
*@

<g class="buildings-overlay">
    @* Render owned buildings *@
    @foreach (var building in GetOwnedBuildings())
    {
        var ownerColors = GetOwnerColors(building.OwnerId);
        var (x, y) = BoardGeometry.GetVertexPosition(building.BuildingKey);
        var playerId = building.OwnerId ?? "default";
        var glyph = GetBuildingGlyph(building);

        <g class="building-owned" transform="translate(@x.ToString("F1"), @y.ToString("F1"))">
            @* Background circle with player gradient *@
            <circle r="@BuildingRadius"
                    fill="url(#gradient-@playerId)"
                    stroke="@(ownerColors?.Secondary ?? "#333")"
                    stroke-width="2" />
            @* Building glyph sized to fit circle with margin *@
            <text x="0" y="0"
                  text-anchor="middle"
                  dominant-baseline="central"
                  font-family="Catan"
                  font-size="@GlyphFontSize"
                  fill="@(ownerColors?.Foreground ?? "#fff")">@glyph</text>
        </g>
    }

    @* Render buildable/star spots *@
    @foreach (var spot in GetBuildableSpots())
    {
        var colors = CurrentPlayer?.Colors;
        var playerId = CurrentPlayer?.Id ?? "default";

        <g class="building-spot @GetSpotClass(spot)"
           transform="translate(@spot.X.ToString("F1"), @spot.Y.ToString("F1"))"
           @onclick="() => OnSpotClick(spot)"
           style="cursor: @(spot.IsBuildable ? "pointer" : "default")">
            @* Background circle with player gradient *@
            <circle r="@SpotRadius"
                    fill="url(#gradient-@playerId)"
                    stroke="@(colors?.Foreground ?? "#fff")"
                    stroke-width="2" />

            @* Text: build index or star count *@
            <text x="0" y="0"
                  text-anchor="middle"
                  dominant-baseline="central"
                  font-family="Segoe UI, sans-serif"
                  font-size="@SpotFontSize"
                  font-weight="bold"
                  fill="@(colors?.Foreground ?? "#fff")">@(spot.BuildIndex ?? spot.Stars.ToString())</text>
        </g>
    }
</g>

@code {
    // Catan font glyph codes
    private const string SettlementGlyph = "\uE926";
    private const string CityGlyph = "\uE900";

    // Building circle radius (SVG units) - same for settlement and city
    private const double BuildingRadius = 24;
    // Font size as percentage of diameter (leaves visible border)
    private const double GlyphFontSize = BuildingRadius * 1.4;

    // Buildable spot sizes
    private const double SpotRadius = 18;
    private const double SpotFontSize = 20;

    [Parameter]
    public IReadOnlyList<BuildingModel> Buildings { get; set; } = [];

    [Parameter]
    public GameModel? GameModel { get; set; }

    [Parameter]
    public int ShownStars { get; set; }

    [Parameter]
    public HashSet<ResourceType>? FilteredResources { get; set; }

    [Parameter]
    public PlayerViewModel? CurrentPlayer { get; set; }

    [Parameter]
    public IReadOnlyList<PlayerViewModel> Players { get; set; } = [];

    [Parameter]
    public EventCallback<BuildingKey> OnBuildingClick { get; set; }

    /// <summary>
    /// Gets the Catan font glyph for a building.
    /// </summary>
    private string GetBuildingGlyph(BuildingModel building)
    {
        return building.BuildingState == BuildingState.City ? CityGlyph : SettlementGlyph;
    }

    /// <summary>
    /// Gets the owner's player colors.
    /// </summary>
    private PlayerColors? GetOwnerColors(string? ownerId)
    {
        if (ownerId == null) return CurrentPlayer?.Colors;
        return Players.FirstOrDefault(p => p.Id == ownerId)?.Colors;
    }

    /// <summary>
    /// Gets all owned buildings (settlements and cities).
    /// </summary>
    private IEnumerable<BuildingModel> GetOwnedBuildings()
    {
        return Buildings.Where(b => b.OwnerId != null &&
            (b.BuildingState == BuildingState.Settlement || b.BuildingState == BuildingState.City));
    }

    /// <summary>
    /// Represents a buildable/star spot.
    /// </summary>
    private record BuildingSpot(BuildingModel Building, int Stars, double X, double Y, bool IsBuildable, bool IsHidden, string? BuildIndex = null);

    /// <summary>
    /// Gets buildable spots and star indicators.
    /// Matches Desktop GameViewModel logic for building visibility.
    /// Returns settlement spots (numbered 1..n) and city upgrade spots (lettered A..Z).
    /// </summary>
    private IEnumerable<BuildingSpot> GetBuildableSpots()
    {
        if (GameModel == null) yield break;

        var currentPlayer = GameModel.CurrentPlayer();
        var hasSettlementEntitlement = currentPlayer.UnspentEntitlements.Contains(Entitlement.Settlement);
        var hasCityEntitlement = currentPlayer.UnspentEntitlements.Contains(Entitlement.City);
        var isPickingBoard = GameModel.GameState == GameState.PickingBoard;
        var isPickingResources = GameModel.Phase() == GamePhase.PickingResources;
        var filteredResources = FilteredResources ?? new HashSet<ResourceType>();

        // Track build indexes - settlements get numbers, cities get letters
        int settlementIndex = 1;
        char cityIndex = 'A';

        foreach (var building in Buildings)
        {
            // Handle city upgrades: player's settlements that can be upgraded
            if (hasCityEntitlement &&
                building.BuildingState == BuildingState.Settlement &&
                building.OwnerId == currentPlayer.Id)
            {
                var (x, y) = BoardGeometry.GetVertexPosition(building.BuildingKey);
                var stars = GameModel.TilesForBuildings(building.BuildingKey).Stars();
                yield return new BuildingSpot(building, stars, x, y, IsBuildable: true, IsHidden: false, BuildIndex: cityIndex.ToString());
                cityIndex++;
                continue;
            }

            // Skip owned buildings (rendered separately unless they're upgrade candidates above)
            if (building.OwnerId != null) continue;

            // Only process PossibleSettlement during allocation/play
            // During PickingBoard, also show NotBuildable spots for star evaluation
            if (building.BuildingState == BuildingState.NotBuildable)
            {
                if (!isPickingBoard) continue; // NotBuildable only shown during PickingBoard
            }
            else if (building.BuildingState != BuildingState.PossibleSettlement)
            {
                continue;
            }

            var spotStars = GameModel.TilesForBuildings(building.BuildingKey).Stars();

            // During PickingBoard: skip 0-star spots (no production value to evaluate)
            // During allocation/gameplay: allow 0-star spots if buildable (e.g., harbor access)
            if (spotStars <= 0 && isPickingBoard) continue;

            // Apply resource filter
            if (filteredResources.Count > 0)
            {
                var adjacentTiles = GameModel.TilesForBuildings(building.BuildingKey);
                var tileResources = adjacentTiles
                    .Select(t => t.ResourceTileType)
                    .Where(rt => rt != ResourceType.Desert && rt != ResourceType.Sea)
                    .ToHashSet();

                if (!filteredResources.All(resource => tileResources.Contains(resource)))
                    continue;
            }

            // Determine visibility based on game state:
            // - During PickingBoard: show if stars >= threshold
            // - When buildable: always render, but hidden if below threshold (hover reveals)
            // - Otherwise: don't show
            bool isBuildable;
            bool shouldShow;
            bool isHidden = false;
            string? buildIndex = null;

            if (isPickingBoard)
            {
                // PickingBoard: show stars for board evaluation
                shouldShow = spotStars >= ShownStars;
                isBuildable = false; // Can't build during board picking
            }
            else if (hasSettlementEntitlement && building.BuildingState == BuildingState.PossibleSettlement)
            {
                // Buildable settlement spot
                shouldShow = true;
                isBuildable = true;

                // Only show numbered build indexes during regular gameplay (NOT allocation phase)
                if (!isPickingResources)
                {
                    // When build index is shown, all spots visible at 50% opacity (no hiding)
                    buildIndex = settlementIndex.ToString();
                    settlementIndex++;
                    isHidden = false;
                }
                else
                {
                    // During allocation: use star threshold for default visibility
                    // Spots >= ShownStars: always visible with star count
                    // Spots < ShownStars: hidden but hoverable (CSS reveals on hover)
                    // All buildable spots remain clickable regardless of visibility
                    isHidden = spotStars < ShownStars;
                }
            }
            else
            {
                // Not buildable, not picking board - don't show
                shouldShow = false;
                isBuildable = false;
            }

            if (!shouldShow) continue;

            var (posX, posY) = BoardGeometry.GetVertexPosition(building.BuildingKey);

            yield return new BuildingSpot(building, spotStars, posX, posY, isBuildable, isHidden, buildIndex);
        }
    }

    /// <summary>
    /// Gets the CSS class for a buildable spot.
    /// </summary>
    private string GetSpotClass(BuildingSpot spot)
    {
        var classes = new List<string>();

        if (spot.IsBuildable)
            classes.Add("building-spot-buildable");
        else
            classes.Add("building-spot-stars");

        if (spot.IsHidden)
            classes.Add("building-spot-hidden");

        // Spots with build indexes show at 50% opacity
        if (!string.IsNullOrEmpty(spot.BuildIndex))
            classes.Add("building-spot-indexed");

        return string.Join(" ", classes);
    }

    /// <summary>
    /// Handle click on a buildable spot.
    /// </summary>
    private async Task OnSpotClick(BuildingSpot spot)
    {
        if (spot.IsBuildable && OnBuildingClick.HasDelegate)
        {
            await OnBuildingClick.InvokeAsync(spot.Building.BuildingKey);
        }
    }
}
