@using Catan3.Shared.Models
@using Catan3.Shared.Utility
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services.Rendering

@*
    RoadOverlay - Renders ALL roads as SVG elements using transform for positioning.

    Renders:
    - Owned roads with owner colors (fully visible)
    - Buildable roads with current player colors (50% opacity, clickable)

    Uses SVG coordinate system (same as tiles/robber) for perfect alignment.
*@

<g class="roads-overlay">
    @foreach (var road in GetVisibleRoads())
    {
        var colors = GetRoadColors(road);
        var playerId = road.OwnerId ?? CurrentPlayer?.Id ?? "default";
        var (midX, midY) = GetRoadMidpoint(road.RoadKey);
        var angle = BoardSvgConstants.RoadEdgeAngles[road.RoadKey.HexSide];

        <g class="road @GetRoadClass(road)"
           @onclick="() => HandleRoadClick(road)"
           style="cursor: @(road.RoadState == RoadState.Buildable ? "pointer" : "default")">
            @* Road polygon using canonical shape with transform for position/rotation *@
            <polygon points="@BoardSvgConstants.CanonicalRoadPolygon"
                     transform="translate(@midX.ToString("F1"), @midY.ToString("F1")) rotate(@angle.ToString("F0"))"
                     fill="url(#gradient-@playerId)"
                     stroke="@(colors?.Secondary ?? "#666")"
                     stroke-width="@BoardSvgConstants.RoadStrokeThickness"
                     opacity="@(road.OwnerId != null ? "1" : "0.5")" />

            @if (road.BuildIndex > 0)
            {
                @* Build index label centered on road *@
                <g transform="translate(@midX.ToString("F1"), @midY.ToString("F1"))">
                    <rect x="-18" y="-14" width="36" height="28" rx="6" fill="black" />
                    <text x="0" y="0"
                          text-anchor="middle"
                          dominant-baseline="central"
                          font-family="Segoe UI, sans-serif"
                          font-size="24"
                          font-weight="bold"
                          fill="white">@road.BuildIndex</text>
                </g>
            }
        </g>
    }
</g>

@code {
    [Parameter]
    public IReadOnlyList<RoadModel> Roads { get; set; } = [];

    [Parameter]
    public PlayerViewModel? CurrentPlayer { get; set; }

    [Parameter]
    public IReadOnlyList<PlayerViewModel> Players { get; set; } = [];

    [Parameter]
    public EventCallback<RoadKey> OnRoadClick { get; set; }

    /// <summary>
    /// Gets roads that should be visible (owned or buildable).
    /// </summary>
    private IEnumerable<RoadModel> GetVisibleRoads()
    {
        return Roads.Where(r => r.OwnerId != null || r.RoadState == RoadState.Buildable);
    }

    /// <summary>
    /// Gets the player colors for a road.
    /// </summary>
    private PlayerColors? GetRoadColors(RoadModel road)
    {
        if (road.OwnerId != null)
        {
            return Players.FirstOrDefault(p => p.Id == road.OwnerId)?.Colors;
        }
        return CurrentPlayer?.Colors;
    }

    /// <summary>
    /// Gets the CSS class for a road.
    /// </summary>
    private string GetRoadClass(RoadModel road)
    {
        if (road.OwnerId != null)
            return "road-owned";
        if (road.RoadState == RoadState.Buildable)
            return "road-buildable";
        return "";
    }

    /// <summary>
    /// Gets the midpoint of an edge for positioning the road polygon.
    /// Uses precomputed offsets from BoardSvgConstants.
    /// </summary>
    private (double x, double y) GetRoadMidpoint(RoadKey roadKey)
    {
        var (tileX, tileY) = BoardGeometry.AxialToPixel(roadKey.TileKey.Q, roadKey.TileKey.R);
        var (dx, dy) = BoardSvgConstants.RoadEdgeMidpointOffsets[roadKey.HexSide];
        return (tileX + dx, tileY + dy);
    }

    /// <summary>
    /// Handle click on a buildable road.
    /// </summary>
    private async Task HandleRoadClick(RoadModel road)
    {
        if (road.RoadState == RoadState.Buildable && OnRoadClick.HasDelegate)
        {
            await OnRoadClick.InvokeAsync(road.RoadKey);
        }
    }
}
