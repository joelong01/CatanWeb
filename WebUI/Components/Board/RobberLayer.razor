@using Catan3.Shared.Models
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering

@*
    RobberLayer - Renders the robber piece on its current tile.
    Uses CatanFont glyphs (SolidShield + Pirate) with player colors.
    Covers 75% of the tile, shows resources stolen count.

    Animation: When PreviousCoordinates is set, renders at previous position first,
    then animates to new position via CSS transition on next frame.
*@

<g class="robber-layer">
    @{
        // Determine render position based on animation phase
        var hasValidCoords = RobberCoordinates != HexCoordinates.Default;
        var renderCoords = GetRenderCoordinates();
        var (x, y) = hasValidCoords || _animationPending || _fakeOutPhase != FakeOutPhase.None
            ? BoardGeometry.AxialToPixel(renderCoords.Q, renderCoords.R)
            : (0.0, 0.0);
        var colors = GetMovedByColors();
        var visibility = hasValidCoords ? "visible" : "hidden";
    }

    @* Robber using CatanFont glyphs - background shield + foreground pirate *@
    @* Element is always rendered to enable CSS transition animation on transform *@
    <g class="robber"
       style="-webkit-transform: translate(@(x.ToString("F1"))px, @(y.ToString("F1"))px); transform: translate(@(x.ToString("F1"))px, @(y.ToString("F1"))px); visibility: @visibility;"
       opacity="0.75">
        @* Background: SolidShield glyph (E925) with player gradient *@
        <text class="robber-shield"
              x="0" y="0"
              text-anchor="middle"
              dominant-baseline="central"
              font-family="Catan"
              font-size="@RobberFontSize"
              fill="url(#gradient-@MovedByPlayerId)">&#xE925;</text>

        @* Foreground: Pirate glyph (E90C) with player foreground color *@
        <text class="robber-pirate"
              x="0" y="0"
              text-anchor="middle"
              dominant-baseline="central"
              font-family="Catan"
              font-size="@(RobberFontSize * 0.8)"
              fill="@colors.Foreground">&#xE90C;</text>

        @* Resources stolen count *@
        @((MarkupString)RenderResourcesStolen(colors.Foreground))
    </g>
</g>

@code {
    /// <summary>
    /// The robber's current tile coordinates.
    /// </summary>
    [Parameter]
    public HexCoordinates RobberCoordinates { get; set; } = HexCoordinates.Default;

    /// <summary>
    /// The robber's previous coordinates (for animation).
    /// When set, robber animates from this position to RobberCoordinates.
    /// </summary>
    [Parameter]
    public HexCoordinates? PreviousCoordinates { get; set; }

    /// <summary>
    /// ID of the player who last moved the robber.
    /// </summary>
    [Parameter]
    public string? MovedByPlayerId { get; set; }

    /// <summary>
    /// Number of resources stolen by the robber.
    /// </summary>
    [Parameter]
    public int ResourcesStolen { get; set; }

    /// <summary>
    /// List of all players for color lookup.
    /// </summary>
    [Parameter]
    public IReadOnlyList<PlayerViewModel> Players { get; set; } = [];

    /// <summary>
    /// Fake-out coordinates for "Grief Dodgy" animation.
    /// When set, robber animates here first, pauses, then to final position.
    /// </summary>
    [Parameter]
    public HexCoordinates? FakeOutCoordinates { get; set; }

    /// <summary>
    /// Whether the GriefDodgy feature is enabled (house rule on AND Dodgy-001 is playing).
    /// When false, all animation logic is skipped.
    /// </summary>
    [Parameter]
    public bool GriefDodgyEnabled { get; set; }

    // Animation state
    private bool _animationPending;
    private HexCoordinates _animationStartCoords = HexCoordinates.Default;

    // Fake-out animation state (Grief Dodgy)
    private enum FakeOutPhase { None, AnimatingToFake, HoldingAtFake, AnimatingToFinal }
    private FakeOutPhase _fakeOutPhase = FakeOutPhase.None;
    private HexCoordinates _fakeOutTargetCoords = HexCoordinates.Default;

    /// <summary>
    /// Font size for the robber glyph - 50% of hex height (smaller to show tile number).
    /// </summary>
    private double RobberFontSize => BoardSvgConstants.HexHeight * 0.50;

    /// <summary>
    /// Check for animation trigger when parameters change.
    /// All animation logic is skipped when GriefDodgy is disabled.
    /// </summary>
    protected override void OnParametersSet()
    {
        // Skip all animation logic if GriefDodgy is disabled
        if (!GriefDodgyEnabled)
        {
            _animationPending = false;
            _fakeOutPhase = FakeOutPhase.None;
            _fakeOutTargetCoords = HexCoordinates.Default;
            return;
        }

        // Check for fake-out animation (Grief Dodgy) - can trigger even without previous coords
        if (FakeOutCoordinates is HexCoordinates fakeCoords &&
            fakeCoords != HexCoordinates.Default &&
            !fakeCoords.Equals(RobberCoordinates))
        {
            // Fake-out animation: start from previous position (or off-screen if first move)
            var startCoords = PreviousCoordinates is HexCoordinates prevCoords && prevCoords != HexCoordinates.Default
                ? prevCoords
                : fakeCoords; // If no previous, start directly at fake-out position

            _animationStartCoords = startCoords;
            _fakeOutPhase = FakeOutPhase.AnimatingToFake;
            _fakeOutTargetCoords = fakeCoords;
            _animationPending = true;
        }
        // Normal animation: If PreviousCoordinates is set and different from current
        else if (PreviousCoordinates is HexCoordinates prevCoords &&
            prevCoords != HexCoordinates.Default &&
            !prevCoords.Equals(RobberCoordinates))
        {
            _animationStartCoords = prevCoords;
            _fakeOutPhase = FakeOutPhase.None;
            _animationPending = true;
        }
        else
        {
            // No animation coordinates - reset animation state
            _animationPending = false;
            _fakeOutPhase = FakeOutPhase.None;
            _fakeOutTargetCoords = HexCoordinates.Default;
        }
    }

    /// <summary>
    /// Gets the current render coordinates based on animation phase.
    /// </summary>
    private HexCoordinates GetRenderCoordinates()
    {
        // If animation is pending, render at start position for CSS transition
        if (_animationPending)
        {
            return _animationStartCoords;
        }

        // During fake-out phases, render at appropriate position
        return _fakeOutPhase switch
        {
            FakeOutPhase.AnimatingToFake => _fakeOutTargetCoords,
            FakeOutPhase.HoldingAtFake => _fakeOutTargetCoords,
            FakeOutPhase.AnimatingToFinal => RobberCoordinates,
            _ => RobberCoordinates
        };
    }

    /// <summary>
    /// After rendering at start position, trigger move to end position.
    /// Handles multi-phase fake-out animation for Grief Dodgy.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_animationPending)
        {
            _animationPending = false;
            // Small delay to ensure browser has rendered at start position
            await Task.Delay(20);
            // Trigger re-render - CSS will animate to next position
            StateHasChanged();
            return;
        }

        // Handle fake-out animation phases
        switch (_fakeOutPhase)
        {
            case FakeOutPhase.AnimatingToFake:
                // Wait for animation to complete (1.2s CSS transition)
                await Task.Delay(1250);
                _fakeOutPhase = FakeOutPhase.HoldingAtFake;
                StateHasChanged();
                break;

            case FakeOutPhase.HoldingAtFake:
                // Hold at fake position for 1 second
                await Task.Delay(1000);
                _fakeOutPhase = FakeOutPhase.AnimatingToFinal;
                StateHasChanged();
                break;

            case FakeOutPhase.AnimatingToFinal:
                // Wait for final animation to complete
                await Task.Delay(1250);
                _fakeOutPhase = FakeOutPhase.None;
                _fakeOutTargetCoords = HexCoordinates.Default;
                break;
        }
    }

    /// <summary>
    /// Gets the player colors for the player who moved the robber.
    /// </summary>
    private PlayerColors GetMovedByColors()
    {
        if (MovedByPlayerId != null)
        {
            var player = Players.FirstOrDefault(p => p.Id == MovedByPlayerId);
            if (player != null)
            {
                return player.Colors;
            }
        }
        // Default colors if no player (red foreground on black/white gradient)
        return new PlayerColors("#000000", "#FFFFFF", "#FF0000");
    }

    /// <summary>
    /// Renders the resources stolen count SVG text element.
    /// Separate method to avoid Razor <text> directive conflict.
    /// </summary>
    private string RenderResourcesStolen(string foregroundColor)
    {
        if (ResourcesStolen <= 0) return "";

        var y = RobberFontSize * 0.35;
        return $@"<text class=""robber-count"" x=""0"" y=""{y:F1}"" text-anchor=""middle"" dominant-baseline=""central"" font-family=""Segoe UI, sans-serif"" font-size=""22"" font-weight=""bold"" fill=""{foregroundColor}"">{ResourcesStolen}</text>";
    }

    /// <summary>
    /// Always re-render to support animation (animation logic handles efficiency).
    /// </summary>
    protected override bool ShouldRender() => true;
}
