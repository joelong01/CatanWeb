@using Catan3.Shared.Models
@using Catan3.Shared.Extensions
@using Catan3.WebUI.Components.Resources
@using Catan3.WebUI.Components.Shared

<div class="board-measurement-panel" data-testid="board-measurement-panel">
    <!-- Resource Cards Row -->
    <div class="resource-cards-row">
        @foreach (var resourceType in GetDisplayedResources())
        {
            <ResourceCard
                Resource="@resourceType"
                Count="@GameModel.StarCount(resourceType)"
                IsSelected="@SelectedResources.Contains(resourceType)"
                OnToggleSelection="@HandleResourceToggle" />
        }
    </div>

    <!-- Star Counters Row -->
    <div class="star-counters-row">
        @foreach (var starValue in new[] { 13, 12, 11, 10 })
        {
            var count = GetStarCount(starValue);
            <StarCounter StarValue="@starValue" Count="@count" />
        }
    </div>

    <!-- Action Buttons Row -->
    <div class="action-buttons-row">
        <IconButton Icon="&#xE10E;"
                    Label="Previous Board"
                    OnClick="OnUndo"
                    AutomationId="btn-undo-board" />
        <IconButton Icon="&#xE10D;"
                    Label="Shuffle"
                    OnClick="OnShuffle"
                    AutomationId="btn-shuffle-board" />
    </div>

    <!-- Star Threshold Slider -->
    <div class="star-slider-container">
        <label for="star-slider" class="slider-label">Show Buildings (Stars)</label>
        <input type="range"
               id="star-slider"
               class="star-slider"
               min="0"
               max="14"
               value="@ShownStars"
               @oninput="HandleSliderInput"
               data-testid="star-threshold-slider" />
        <div class="slider-value">@ShownStars</div>
    </div>
</div>

@code {
    /// <summary>
    /// The current game model containing board and tile data.
    /// </summary>
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = null!;

    /// <summary>
    /// Event callback triggered when the shuffle button is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnShuffle { get; set; }

    /// <summary>
    /// Event callback triggered when the undo (previous board) button is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>
    /// The current star threshold value for building visibility (0-14).
    /// </summary>
    [Parameter]
    public int ShownStars { get; set; } = 0;

    /// <summary>
    /// Event callback triggered when the ShownStars value changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> ShownStarsChanged { get; set; }

    /// <summary>
    /// Event callback triggered when the selected resources change.
    /// </summary>
    [Parameter]
    public EventCallback<HashSet<ResourceType>> SelectedResourcesChanged { get; set; }

    /// <summary>
    /// Set of currently selected resources for filtering buildings (max 3).
    /// </summary>
    private HashSet<ResourceType> SelectedResources { get; set; } = new();

    /// <summary>
    /// Gets the list of resource types to display in the resource cards row.
    /// Matches Desktop order: Wheat, Wood, Sheep, Brick, Ore
    /// </summary>
    /// <returns>Array of ResourceType values for display.</returns>
    private ResourceType[] GetDisplayedResources()
    {
        return new[]
        {
            ResourceType.Wheat,
            ResourceType.Wood,
            ResourceType.Sheep,
            ResourceType.Brick,
            ResourceType.Ore
        };
    }

    /// <summary>
    /// Calculates the count of building sites with total adjacent tile stars matching the threshold.
    /// Mirrors Desktop implementation: GameViewModel.cs:392-395
    /// </summary>
    /// <param name="threshold">The star threshold to count (typically 10, 11, 12, or 13).</param>
    /// <returns>Number of buildings whose adjacent tiles sum to exactly this star value.</returns>
    private int GetStarCount(int threshold)
    {
        return GameModel.Buildings
            .Count(building =>
            {
                var adjacentTiles = GameModel.TilesForBuildings(building.BuildingKey);
                var totalStars = adjacentTiles.Stars();
                return totalStars == threshold;
            });
    }

    /// <summary>
    /// Handles slider input events and updates the ShownStars value.
    /// </summary>
    /// <param name="e">The change event arguments containing the new value.</param>
    private async Task HandleSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newValue))
        {
            ShownStars = newValue;
            await ShownStarsChanged.InvokeAsync(newValue);
        }
    }

    /// <summary>
    /// Handles resource card selection toggle events.
    /// Enforces max 3 selections (Desktop parity: DesktopApp/Resources/ResourceViewModel.cs:120-127).
    /// </summary>
    /// <param name="resource">The resource type being toggled.</param>
    private async Task HandleResourceToggle(ResourceType resource)
    {
        if (SelectedResources.Contains(resource))
        {
            SelectedResources.Remove(resource);
        }
        else
        {
            SelectedResources.Add(resource);

            // Enforce max 3 selections (match Desktop behavior)
            if (SelectedResources.Count > 3)
            {
                // Remove oldest selection (first item in HashSet)
                var oldest = SelectedResources.First();
                SelectedResources.Remove(oldest);
            }
        }

        await SelectedResourcesChanged.InvokeAsync(SelectedResources);
    }
}
