@using Catan3.Shared.Models

<div class="star-counter star-counter-@StarValue" data-testid="star-counter-@StarValue">
    <div class="star-value">@StarValue</div>
    <div class="star-separator"></div>
    <div class="star-count">@Count</div>
</div>

@code {
    /// <summary>
    /// The star threshold value this counter represents (11, 12, or 13).
    /// </summary>
    [Parameter]
    public int StarValue { get; set; }

    /// <summary>
    /// The number of building sites on the board that meet this star threshold.
    /// </summary>
    [Parameter]
    public int Count { get; set; }
}
