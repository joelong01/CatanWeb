@using Catan3.Shared.Models
@using Catan3.WebUI.Components.Resources

<div class="resource-tracking-panel" data-testid="resource-tracking-panel">
    <div class="resource-cards-row">
        @foreach (var resourceType in GetTrackedResources())
        {
            var count = GetResourceCount(resourceType);
            <div class="resource-card-wrapper">
                <ResourceCard Resource="@resourceType" Count="@count" AutoFlip="true" CanFlip="true" />
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The current game model containing all game state.
    /// </summary>
    [Parameter, EditorRequired]
    public GameModel GameModel { get; set; } = null!;

    /// <summary>
    /// Gets the list of resource types to track (includes Gold and Robber).
    /// </summary>
    /// <returns>Array of ResourceType values: Wheat, Wood, Sheep, Brick, Ore, GoldMine, Robber</returns>
    private ResourceType[] GetTrackedResources()
    {
        return new[]
        {
            ResourceType.Wheat,
            ResourceType.Wood,
            ResourceType.Sheep,
            ResourceType.Brick,
            ResourceType.Ore,
            ResourceType.GoldMine,
            ResourceType.Robber
        };
    }

    /// <summary>
    /// Gets the count from GameResourcesModel (total resources this game for all players).
    /// </summary>
    /// <param name="resource">The resource type to get count for.</param>
    /// <returns>Total count of this resource generated in the game.</returns>
    private int GetResourceCount(ResourceType resource)
    {
        var r = GameModel.GameResourcesModel;
        return resource switch
        {
            ResourceType.Wheat => r.Wheat,
            ResourceType.Wood => r.Wood,
            ResourceType.Sheep => r.Sheep,
            ResourceType.Brick => r.Brick,
            ResourceType.Ore => r.Ore,
            ResourceType.GoldMine => r.GoldMine,
            ResourceType.Robber => r.Robber,
            _ => 0
        };
    }
}
