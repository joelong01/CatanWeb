@inherits LayoutComponentBase

<div class="page">
    <button class="hamburger-btn" @onclick="ToggleSidebar">
        ☰
    </button>

    @if (showMenu)
    {
        <div class="menu-overlay" @onclick="ToggleSidebar">
            <div class="menu-panel" @onclick:stopPropagation="true">
                <NavMenu OnMenuAction="ToggleSidebar" />
            </div>
        </div>
    }

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool showMenu = false;

    private void ToggleSidebar()
    {
        showMenu = !showMenu;
    }
}
