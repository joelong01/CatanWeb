@page "/stats"
@using Catan3.Shared.Models
@using Catan3.Shared.Profiles
@using System.Net.Http.Json
@using Catan3.WebUI.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject GameServiceConfig Config

<PageTitle>Player Statistics - Catan</PageTitle>

<div class="stats-container">
    <h1 style="color: #ffffff; text-align: center; margin-bottom: 20px; margin-top: 10px;">Player Statistics</h1>

    @if (IsLoading)
    {
        <div class="loading">Loading player statistics...</div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error">@ErrorMessage</div>
    }
    else
    {
        <div class="stats-table-wrapper">
            <table class="stats-table">
                <thead>
                    <tr style="background: #333333;">
                        <th style="text-align: left; padding: 12px 8px; color: #ffffff; font-size: 11px; position: sticky; left: 0; background: #333333; z-index: 1;">Player</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Games</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffd700; font-size: 11px;">Wins</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">L.Road</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">L.Army</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Longest Road</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Most Soldiers</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Most Stars</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Ave Stars</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Targeted</th>
                        <th style="text-align: center; padding: 12px 6px; color: #ffffff; font-size: 11px;">Robber</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in GetSortedPlayers())
                    {
                        var stats = player.LifetimeStats ?? new LifetimeStats();
                        var totals = stats.Totals;
                        var fgColor = player.ForegroundColor;
                        <tr style="background: @player.Colors.CssGradient;">
                            <td style="padding: 8px; color: @fgColor; position: sticky; left: 0; background: inherit;">
                                <div style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
                                    <div style="width: 32px; height: 32px; min-width: 32px; border-radius: 50%; overflow: hidden; border: 2px solid @fgColor; flex-shrink: 0;">
                                        @if (!string.IsNullOrEmpty(player.ImageUri))
                                        {
                                            <img src="@GetFullImageUri(player.ImageUri)" alt="@player.Name" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                                        }
                                        else
                                        {
                                            <span style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 11px; font-weight: bold; background: rgba(0,0,0,0.2); color: @fgColor;">@GetInitials(player.Name)</span>
                                        }
                                    </div>
                                    <span style="font-weight: bold; font-size: 13px; white-space: nowrap;">@if (stats.Wins > 0){<span style="margin-right: 4px;">&#x1F3C6;</span>}@player.Name</span>
                                </div>
                            </td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.GamesPlayed</td>
                            <td style="text-align: center; padding: 8px 6px; color: #ffd700; font-size: 14px; font-weight: bold;">@stats.Wins</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.LongestRoadWins</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.LargestArmyWins</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.LongestRoadRecord</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.MostSoldiersRecord</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.MostStarsRecord</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@stats.AverageStars.ToString("F1")</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@totals.TimesTargeted</td>
                            <td style="text-align: center; padding: 8px 6px; color: @fgColor; font-size: 14px;">@totals.ResourcesLostToRobber</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PlayerProfile> Players { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayersAsync();
    }

    private async Task LoadPlayersAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var response = await Http.GetFromJsonAsync<GetPlayersApiResponse>($"{Config.BaseUrl}/api/players");

            if (response?.Success == true && response.Players != null)
            {
                Players = response.Players;
            }
            else
            {
                ErrorMessage = "Failed to load players from GameService";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading players: {ex.Message}";
            Console.WriteLine($"Error loading players: {ex}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private IEnumerable<PlayerProfile> GetSortedPlayers()
    {
        // Sort by wins descending, then by win rate as tiebreaker
        return Players
            .OrderByDescending(p => p.LifetimeStats?.Wins ?? 0)
            .ThenByDescending(p => p.LifetimeStats?.WinRate ?? 0)
            .ThenBy(p => p.Name);
    }

    private string GetFullImageUri(string relativeUri)
    {
        if (string.IsNullOrEmpty(relativeUri))
            return string.Empty;

        return $"{Config.BaseUrl}{relativeUri}";
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private class GetPlayersApiResponse
    {
        public bool Success { get; set; }
        public List<PlayerProfile> Players { get; set; } = new();
        public int Count { get; set; }
        public string Timestamp { get; set; } = string.Empty;
    }
}
