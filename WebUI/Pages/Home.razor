@page "/"
@inject WebUI.Services.GameConnectionService GameConnection
@inject WebUI.Services.GameServiceConfig GameServiceConfig
@inject HttpClient Http

<PageTitle>Catan - Home</PageTitle>

<div class="home-container">
    <h1>Catan</h1>
    <p class="subtitle">Settlers of Catan - Web Edition</p>

    <div class="menu-options">
        @if (!string.IsNullOrEmpty(GameConnection.GameId))
        {
            <a href="/game/@GameConnection.GameId" class="menu-button return-game">
                <span class="icon">▶</span>
                <span class="text">Return to Game</span>
            </a>
        }

        <a href="/newgame" class="menu-button">
            <span class="icon">🎮</span>
            <span class="text">New Game</span>
        </a>

        <a href="/loadgame" class="menu-button">
            <span class="icon">📂</span>
            <span class="text">Load Game</span>
        </a>

        <a href="/editplayers" class="menu-button">
            <span class="icon">👥</span>
            <span class="text">Edit Players</span>
        </a>

        <a href="/stats" class="menu-button">
            <span class="icon">📊</span>
            <span class="text">Stats</span>
        </a>

        <div class="menu-separator"></div>

        <a href="/tests" class="menu-button utility-button">
            <span class="icon">🧪</span>
            <span class="text">Tests</span>
        </a>

        <button class="menu-button utility-button" @onclick="RunTroubleshoot" disabled="@isTroubleshooting">
            <span class="icon">🔧</span>
            <span class="text">@(isTroubleshooting ? "Running..." : "Troubleshoot")</span>
        </button>
    </div>

    @if (troubleshootResult != null)
    {
        <div class="troubleshoot-results @(troubleshootResult.ConnectionSuccessful ? "success" : "warning")">
            <h3>@troubleshootResult.Message</h3>

            @if (troubleshootResult.Checks.Any())
            {
                <div class="result-section">
                    <strong>Checks:</strong>
                    <ul>
                        @foreach (var check in troubleshootResult.Checks)
                        {
                            <li>@check</li>
                        }
                    </ul>
                </div>
            }

            @if (troubleshootResult.Fixed.Any())
            {
                <div class="result-section fixed">
                    <strong>Fixed:</strong>
                    <ul>
                        @foreach (var fix in troubleshootResult.Fixed)
                        {
                            <li>✅ @fix</li>
                        }
                    </ul>
                </div>
            }

            @if (troubleshootResult.Issues.Any())
            {
                <div class="result-section issues">
                    <strong>Issues:</strong>
                    <ul>
                        @foreach (var issue in troubleshootResult.Issues)
                        {
                            <li>⚠️ @issue</li>
                        }
                    </ul>
                </div>
            }

            @if (troubleshootResult.CannotFix.Any())
            {
                <div class="result-section cannot-fix">
                    <strong>Cannot Auto-Fix:</strong>
                    <ul>
                        @foreach (var item in troubleshootResult.CannotFix)
                        {
                            <li>ℹ️ @item</li>
                        }
                    </ul>
                </div>
            }

            <button class="dismiss-button" @onclick="DismissTroubleshoot">Dismiss</button>
        </div>
    }

    @if (troubleshootError != null)
    {
        <div class="troubleshoot-results error">
            <h3>Troubleshoot Failed</h3>
            <p>@troubleshootError</p>
            <button class="dismiss-button" @onclick="DismissTroubleshoot">Dismiss</button>
        </div>
    }

    <div class="info-section">
        <p>WebUI connected to GameService at <code>@GameServiceConfig.BaseUrl</code></p>
        <p style="font-size: 0.8rem; color: #666;">State: @GameConnection.State | GameId: @(GameConnection.GameId ?? "none")</p>
    </div>
</div>

<style>
    .home-container {
        text-align: center;
        padding: 50px 20px 20px 50px; /* top right bottom left - clear burger menu */
        max-width: 600px;
        margin: 0 auto;
    }

    h1 {
        font-size: 3rem;
        color: #8B4513;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 40px;
    }

    .menu-options {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 40px;
    }

    .menu-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 20px 30px;
        font-size: 1.2rem;
        border: 2px solid #8B4513;
        border-radius: 8px;
        background-color: #FFF8DC;
        color: #8B4513;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .menu-button:hover:not(:disabled) {
        background-color: #8B4513;
        color: white;
    }

    .menu-button.return-game {
        background-color: #228B22;
        border-color: #228B22;
        color: white;
    }

    .menu-button.return-game:hover {
        background-color: #1a6b1a;
        border-color: #1a6b1a;
    }

    .menu-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .menu-button .icon {
        font-size: 1.5rem;
    }

    .menu-separator {
        height: 1px;
        background: linear-gradient(to right, transparent, #ccc, transparent);
        margin: 10px 0;
    }

    .menu-button.utility-button {
        border-color: #666;
        background-color: #f0f0f0;
        color: #333;
    }

    .menu-button.utility-button:hover:not(:disabled) {
        background-color: #666;
        color: white;
    }

    .info-section {
        color: #888;
        font-size: 0.9rem;
    }

    .info-section code {
        background-color: #f4f4f4;
        padding: 2px 6px;
        border-radius: 3px;
    }

    .troubleshoot-results {
        margin-top: 20px;
        padding: 20px;
        border-radius: 8px;
        text-align: left;
        max-width: 100%;
    }

    .troubleshoot-results.success {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
    }

    .troubleshoot-results.warning {
        background-color: #fff3cd;
        border: 1px solid #ffeeba;
    }

    .troubleshoot-results.error {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
    }

    .troubleshoot-results h3 {
        margin-top: 0;
        margin-bottom: 15px;
        font-size: 1.1rem;
    }

    .result-section {
        margin-bottom: 15px;
    }

    .result-section ul {
        margin: 5px 0;
        padding-left: 20px;
    }

    .result-section li {
        margin: 3px 0;
        font-size: 0.9rem;
    }

    .result-section.fixed {
        color: #155724;
    }

    .result-section.issues {
        color: #856404;
    }

    .result-section.cannot-fix {
        color: #0c5460;
    }

    .dismiss-button {
        margin-top: 10px;
        padding: 8px 16px;
        border: 1px solid #666;
        border-radius: 4px;
        background-color: white;
        cursor: pointer;
    }

    .dismiss-button:hover {
        background-color: #f0f0f0;
    }

    /* ==========================================================================
       Mobile responsive - Much larger fonts and touch targets
       ========================================================================== */
    @@media (max-width: 768px), (pointer: coarse) {
        .home-container {
            padding: 50px 30px;
            max-width: 100%;
        }

        h1 {
            font-size: 9rem;
            margin-bottom: 25px;
        }

        .subtitle {
            font-size: 3.5rem;
            margin-bottom: 80px;
        }

        .menu-options {
            gap: 30px;
            margin-bottom: 80px;
        }

        .menu-button {
            padding: 36px 48px;
            font-size: 3rem;
            border-radius: 20px;
            border-width: 4px;
        }

        .menu-button .icon {
            font-size: 4rem;
        }

        .menu-separator {
            margin: 20px 0;
        }

        .info-section {
            font-size: 2rem;
        }

        .info-section p[style] {
            font-size: 1.6rem !important;
        }

        .troubleshoot-results h3 {
            font-size: 2.5rem;
        }

        .result-section li {
            font-size: 2rem;
        }

        .dismiss-button {
            padding: 20px 40px;
            font-size: 2rem;
        }
    }

    /* Slightly smaller for very small phones */
    @@media (max-width: 400px) {
        h1 {
            font-size: 6rem;
        }

        .subtitle {
            font-size: 2.5rem;
        }

        .menu-button {
            padding: 30px 36px;
            font-size: 2.4rem;
        }

        .menu-button .icon {
            font-size: 3rem;
        }
    }
</style>

@code {
    private bool isTroubleshooting = false;
    private TroubleshootResult? troubleshootResult;
    private string? troubleshootError;

    private async Task RunTroubleshoot()
    {
        isTroubleshooting = true;
        troubleshootResult = null;
        troubleshootError = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"{GameServiceConfig.BaseUrl}/api/troubleshoot", null);
            if (response.IsSuccessStatusCode)
            {
                troubleshootResult = await response.Content.ReadFromJsonAsync<TroubleshootResult>();
            }
            else
            {
                troubleshootError = $"HTTP {(int)response.StatusCode}: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            troubleshootError = ex.Message;
        }
        finally
        {
            isTroubleshooting = false;
            StateHasChanged();
        }
    }

    private void DismissTroubleshoot()
    {
        troubleshootResult = null;
        troubleshootError = null;
    }

    private class TroubleshootResult
    {
        public DateTime Timestamp { get; set; }
        public bool IsAzure { get; set; }
        public string? ServerFqdn { get; set; }
        public string? DatabaseName { get; set; }
        public string? Message { get; set; }
        public bool ConnectionSuccessful { get; set; }
        public List<string> Checks { get; set; } = new();
        public List<string> Issues { get; set; } = new();
        public List<string> Fixed { get; set; } = new();
        public List<string> CannotFix { get; set; } = new();
    }
}
