@page "/"
@inject WebUI.Services.GameConnectionService GameConnection
@inject WebUI.Services.GameServiceConfig GameServiceConfig

<PageTitle>Catan - Home</PageTitle>

<div class="home-container">
    <h1>Catan</h1>
    <p class="subtitle">Settlers of Catan - Web Edition</p>

    <div class="menu-options">
        @if (!string.IsNullOrEmpty(GameConnection.GameId))
        {
            <a href="/game/@GameConnection.GameId" class="menu-button return-game">
                <span class="icon">▶</span>
                <span class="text">Return to Game</span>
            </a>
        }

        <a href="/newgame" class="menu-button">
            <span class="icon">🎮</span>
            <span class="text">New Game</span>
        </a>

        <a href="/loadgame" class="menu-button">
            <span class="icon">📂</span>
            <span class="text">Load Game</span>
        </a>

        <a href="/editplayers" class="menu-button">
            <span class="icon">👥</span>
            <span class="text">Edit Players</span>
        </a>
    </div>

    <div class="info-section">
        <p>WebUI connected to GameService at <code>@GameServiceConfig.BaseUrl</code></p>
        <p style="font-size: 0.8rem; color: #666;">State: @GameConnection.State | GameId: @(GameConnection.GameId ?? "none")</p>
    </div>
</div>

<style>
    .home-container {
        text-align: center;
        padding: 50px 20px 20px 50px; /* top right bottom left - clear burger menu */
        max-width: 600px;
        margin: 0 auto;
    }

    h1 {
        font-size: 3rem;
        color: #8B4513;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 40px;
    }

    .menu-options {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 40px;
    }

    .menu-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 20px 30px;
        font-size: 1.2rem;
        border: 2px solid #8B4513;
        border-radius: 8px;
        background-color: #FFF8DC;
        color: #8B4513;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .menu-button:hover:not(:disabled) {
        background-color: #8B4513;
        color: white;
    }

    .menu-button.return-game {
        background-color: #228B22;
        border-color: #228B22;
        color: white;
    }

    .menu-button.return-game:hover {
        background-color: #1a6b1a;
        border-color: #1a6b1a;
    }

    .menu-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .menu-button .icon {
        font-size: 1.5rem;
    }

    .info-section {
        color: #888;
        font-size: 0.9rem;
    }

    .info-section code {
        background-color: #f4f4f4;
        padding: 2px 6px;
        border-radius: 3px;
    }
</style>
