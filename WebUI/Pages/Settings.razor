@page "/settings"
@using Catan3.Shared.Models
@using Catan3.WebUI.Services
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject GameServiceConfig Config
@inject ClientHouseRulesService ClientHouseRules

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <h1>Settings</h1>
    <p class="subtitle">Configure game preferences</p>

    @if (isLoading)
    {
        <p>Loading settings...</p>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">@errorMessage</div>
    }
    else if (settings != null)
    {
        @foreach (var category in settings.Select(s => s.Category ?? "Other").Distinct())
        {
            <div class="settings-category">
                <h2>@category</h2>
                <div class="settings-list">
                    @foreach (var setting in settings.Where(s => (s.Category ?? "Other") == category))
                    {
                        <div class="setting-item">
                            <div class="setting-header">
                                <span class="setting-description">@setting.Description</span>
                                @if (!string.IsNullOrEmpty(setting.Tooltip))
                                {
                                    <span class="setting-tooltip" title="@setting.Tooltip">?</span>
                                }
                            </div>
                            <div class="setting-control">
                                @switch (setting.InputType?.ToLowerInvariant())
                                {
                                    case "checkbox":
                                        <label class="checkbox-container">
                                            <input type="checkbox"
                                                   checked="@GetBoolValue(setting)"
                                                   @onchange="(e) => SetBoolValue(setting, (bool)e.Value!)" />
                                            <span class="checkmark"></span>
                                        </label>
                                        break;
                                    case "dropdown":
                                        <select class="dropdown-select"
                                                value="@GetStringValue(setting)"
                                                @onchange="(e) => SetStringValue(setting, e.Value?.ToString())">
                                            @if (setting.Options != null)
                                            {
                                                @foreach (var option in setting.Options)
                                                {
                                                    <option value="@option" selected="@(GetStringValue(setting) == option)">@option</option>
                                                }
                                            }
                                        </select>
                                        break;
                                    default:
                                        <input type="text"
                                               class="text-input"
                                               value="@GetStringValue(setting)"
                                               @onchange="(e) => SetStringValue(setting, e.Value?.ToString())" />
                                        break;
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="button-row">
            <button class="btn btn-secondary" @onclick="ResetToDefaults">Reset to Defaults</button>
            <button class="btn btn-primary" @onclick="SaveSettings">Save</button>
        </div>

        @if (saveMessage != null)
        {
            <div class="save-message @(saveSuccess ? "success" : "error")">@saveMessage</div>
        }
    }
</div>

@code {
    private List<SettingItem>? settings;
    private bool isLoading = true;
    private string? errorMessage;
    private string? saveMessage;
    private bool saveSuccess;
    private string? _currentGameId;
    private GameType? _currentGameType;

    protected override async Task OnInitializedAsync()
    {
        // Check if there's an active game to return to
        _currentGameId = await JS.InvokeAsync<string?>("localStorage.getItem", "current_gameId");
        var gameTypeStr = await JS.InvokeAsync<string?>("localStorage.getItem", "current_gameType");
        if (!string.IsNullOrEmpty(gameTypeStr) && Enum.TryParse<GameType>(gameTypeStr, out var gt))
        {
            _currentGameType = gt;
        }
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Load default settings from JSON
            var defaultSettings = await Http.GetFromJsonAsync<SettingsResponse>("settings.json");

            if (defaultSettings?.Settings != null)
            {
                settings = defaultSettings.Settings;

                // Override with saved values from localStorage
                foreach (var setting in settings)
                {
                    var savedValue = await JS.InvokeAsync<string?>("localStorage.getItem", $"setting_{setting.SettingName}");
                    if (!string.IsNullOrEmpty(savedValue))
                    {
                        setting.Value = setting.InputType?.ToLowerInvariant() == "checkbox"
                            ? bool.Parse(savedValue)
                            : savedValue;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading settings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            if (settings == null) return;

            // Save individual settings to localStorage for UI state
            foreach (var setting in settings)
            {
                var value = setting.Value?.ToString() ?? "";
                await JS.InvokeVoidAsync("localStorage.setItem", $"setting_{setting.SettingName}", value);
            }

            // Build HouseRules and update both localStorage and in-memory service
            var houseRules = BuildHouseRulesFromSettings();
            await ClientHouseRules.UpdateAsync(houseRules);

            // If there's a current game, update its house rules
            var currentGameId = await JS.InvokeAsync<string?>("localStorage.getItem", "current_gameId");
            if (!string.IsNullOrEmpty(currentGameId))
            {
                await UpdateCurrentGameHouseRules(currentGameId);
                saveMessage = $"Settings saved and applied to game {currentGameId}";
            }
            else
            {
                saveMessage = "Settings saved (no active game)";
            }
            saveSuccess = true;

            // Clear message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                saveMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            saveMessage = $"Error saving settings: {ex.Message}";
            saveSuccess = false;
        }
    }

    private async Task UpdateCurrentGameHouseRules(string gameId)
    {
        if (settings == null) return;

        // Use the current game's type to pick the right gold tiles setting
        var houseRules = BuildHouseRulesFromSettings(_currentGameType);

        try
        {
            await Http.PutAsJsonAsync($"{Config.BaseUrl}/api/game/{gameId}/houserules", houseRules);
        }
        catch
        {
            // Silently fail - settings are saved locally regardless
        }
    }

    private string? GetSettingValue(string settingName)
    {
        var setting = settings?.FirstOrDefault(s => s.SettingName == settingName);
        return setting?.Value?.ToString() ?? setting?.DefaultValue?.ToString();
    }

    private async Task ResetToDefaults()
    {
        if (settings == null) return;

        foreach (var setting in settings)
        {
            setting.Value = setting.DefaultValue;
            await JS.InvokeVoidAsync("localStorage.removeItem", $"setting_{setting.SettingName}");
        }

        // Update in-memory HouseRules service with defaults
        var houseRules = BuildHouseRulesFromSettings();
        await ClientHouseRules.UpdateAsync(houseRules);

        // If there's a current game, update its house rules with defaults
        var currentGameId = await JS.InvokeAsync<string?>("localStorage.getItem", "current_gameId");
        if (!string.IsNullOrEmpty(currentGameId))
        {
            await UpdateCurrentGameHouseRules(currentGameId);
        }

        saveMessage = "Settings reset to defaults";
        saveSuccess = true;

        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            saveMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private void ReturnToGame()
    {
        if (!string.IsNullOrEmpty(_currentGameId))
        {
            Navigation.NavigateTo($"/game/{_currentGameId}");
        }
    }

    private string GetStringValue(SettingItem setting)
    {
        return setting.Value?.ToString() ?? setting.DefaultValue?.ToString() ?? "";
    }

    private bool GetBoolValue(SettingItem setting)
    {
        if (setting.Value is bool boolVal) return boolVal;
        if (setting.Value is string strVal && bool.TryParse(strVal, out var parsed)) return parsed;
        if (setting.DefaultValue is bool defBool) return defBool;
        return false;
    }

    private void SetStringValue(SettingItem setting, string? value)
    {
        setting.Value = value;
    }

    private void SetBoolValue(SettingItem setting, bool value)
    {
        setting.Value = value;
    }

    /// <summary>
    /// Builds a complete HouseRules object from current settings.
    /// This is the single source of truth for converting UI settings to HouseRules.
    /// </summary>
    /// <param name="gameType">Optional game type to determine which gold tiles setting to use.
    /// If null, defaults to Expansion gold tiles (for new game creation where type isn't known yet).</param>
    private HouseRules BuildHouseRulesFromSettings(GameType? gameType = null)
    {
        // Pick gold tiles based on game type
        var goldTilesStr = gameType switch
        {
            GameType.Regular => GetSettingValue("RegularGoldTiles"),
            GameType.Expansion => GetSettingValue("ExpansionGoldTiles"),
            _ => GetSettingValue("ExpansionGoldTiles") ?? GetSettingValue("RegularGoldTiles")
        };

        return new HouseRules
        {
            GoldTiles = int.TryParse(goldTilesStr, out var gt) ? gt : 2,
            SupplementalMinPlayers = int.TryParse(GetSettingValue("SupplementalMinPlayers"), out var sm) ? sm : 5,
            GriefDodgy = bool.TryParse(GetSettingValue("GriefDodgy"), out var gd) && gd
        };
    }

    private class SettingsResponse
    {
        public List<SettingItem>? Settings { get; set; }
    }

    private class SettingItem
    {
        public string SettingName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string? InputType { get; set; }
        public string[]? Options { get; set; }
        public object? Value { get; set; }
        public object? DefaultValue { get; set; }
        public string? Tooltip { get; set; }
        public string? Category { get; set; }
    }
}
