@page "/newgame"
@using Catan3.Shared.Models
@using Catan3.Shared.Profiles
@using System.Net.Http.Json
@using Catan3.WebUI.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject GameServiceConfig Config
@inject IJSRuntime JS

<PageTitle>New Game - Catan</PageTitle>

<div class="new-game-container">
    <h1>New Game</h1>

    @if (IsLoading)
    {
        <div class="loading">Loading players from @Config.BaseUrl ...</div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error">@ErrorMessage</div>
    }
    else
    {
        <div class="players-section">
            <h2>Select Players</h2>
            <div class="players-grid">
                @foreach (var player in Players)
                {
                    <div class="player-card @(IsSelected(player.Id) ? "selected" : "")"
                         @onclick="() => TogglePlayer(player.Id)"
                         style="background: @player.Colors.CssGradient">
                        <div class="player-avatar" style="border-color: @player.ForegroundColor">
                            @if (!string.IsNullOrEmpty(player.ImageUri))
                            {
                                <img src="@GetFullImageUri(player.ImageUri)" alt="@player.Name" />
                            }
                            else
                            {
                                <span class="avatar-initials" style="color: @player.ForegroundColor">@GetInitials(player.Name)</span>
                            }
                        </div>
                        <div class="player-name" style="color: @player.ForegroundColor">
                            @player.Name
                        </div>
                        @if (IsSelected(player.Id))
                        {
                            <div class="selection-indicator">✓</div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="options-section">
            <div class="option-row">
                <label for="gameType">Game Type:</label>
                <select id="gameType" @bind="SelectedGameType">
                    <option value="@GameType.Regular">Regular</option>
                    <option value="@GameType.Expansion">Expansion</option>
                </select>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="UseHouseRules" />
                    <span>House Rules</span>
                </label>
            </div>
        </div>

        <div class="actions-section">
            <button class="btn btn-secondary" @onclick="OnCancel" disabled="@IsCreatingGame">Cancel</button>
            <button class="btn btn-primary" @onclick="OnStart" disabled="@(!CanStart)">
                @if (IsCreatingGame)
                {
                    <span>Creating Game...</span>
                }
                else
                {
                    <span>Start Game</span>
                }
            </button>
        </div>

        @if (SelectedPlayers.Count > 0)
        {
            <div class="selected-info">
                Selected: @string.Join(", ", SelectedPlayers.Select(id => Players.First(p => p.Id == id).Name))
            </div>
        }

        @if (SavedGames.Count > 0)
        {
            <div class="saved-games-section">
                <h2>Continue Game</h2>
                <table class="saved-games-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Size</th>
                            <th>Type</th>
                            <th>Players</th>
                            <th>Turns</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in SavedGames)
                        {
                            <tr @onclick="() => LoadSavedGame(game.GameId)" class="saved-game-row">
                                <td>@game.SavedAt.ToLocalTime().ToString("M/d HH:mm")</td>
                                <td>@FormatSize(game.Size)</td>
                                <td>@game.GameType</td>
                                <td>@game.PlayerNames</td>
                                <td>@game.TurnCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private List<PlayerProfile> Players { get; set; } = new();
    private HashSet<string> SelectedPlayers { get; set; } = new();
    private GameType SelectedGameType { get; set; } = GameType.Expansion;
    private bool IsLoading { get; set; } = true;
    private bool IsCreatingGame { get; set; } = false;
    private bool IsLoadingGame { get; set; } = false;
    private string? ErrorMessage { get; set; }
    private List<SavedGameInfo> SavedGames { get; set; } = new();

    // House Rules option
    private bool UseHouseRules { get; set; } = true;

    private bool CanStart => SelectedPlayers.Count >= 3 && SelectedPlayers.Count <= 6 && !IsCreatingGame && !IsLoadingGame;

    protected override async Task OnInitializedAsync()
    {
        // Load players and saved games in parallel
        var playersTask = LoadPlayersAsync();
        var savedGamesTask = LoadSavedGamesAsync();
        await Task.WhenAll(playersTask, savedGamesTask);
    }

    private async Task LoadPlayersAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var response = await Http.GetFromJsonAsync<GetPlayersApiResponse>($"{Config.BaseUrl}/api/players");

            if (response?.Success == true && response.Players != null)
            {
                Players = response.Players;
            }
            else
            {
                ErrorMessage = "Failed to load players from GameService";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading players: {ex.Message}";
            Console.WriteLine($"Error loading players: {ex}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetFullImageUri(string relativeUri)
    {
        // Combine GameService base URL with relative image path
        if (string.IsNullOrEmpty(relativeUri))
            return string.Empty;

        return $"{Config.BaseUrl}{relativeUri}";
    }

    private bool IsSelected(string playerId) => SelectedPlayers.Contains(playerId);

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private void TogglePlayer(string playerId)
    {
        if (SelectedPlayers.Contains(playerId))
        {
            SelectedPlayers.Remove(playerId);
        }
        else
        {
            SelectedPlayers.Add(playerId);
        }
    }

    private void OnCancel()
    {
        // If we have a return URL, go back there, otherwise go to root
        var destination = ReturnUrl ?? "/";
        Navigation.NavigateTo(destination);
    }

    private async Task OnStart()
    {
        if (!CanStart) return;

        try
        {
            IsCreatingGame = true;
            ErrorMessage = null;

            // Send the actual player IDs (e.g., "joe-001"), not display names
            var playerIds = SelectedPlayers.ToList();

            // Load HouseRules from Settings (saved as complete JSON object)
            HouseRules? houseRules = null;
            if (UseHouseRules)
            {
                var houseRulesJson = await JS.InvokeAsync<string?>("localStorage.getItem", "HouseRules");
                if (!string.IsNullOrEmpty(houseRulesJson))
                {
                    houseRules = System.Text.Json.JsonSerializer.Deserialize<HouseRules>(houseRulesJson);
                }
                // Fallback to defaults if no saved settings
                houseRules ??= new HouseRules
                {
                    GoldTiles = SelectedGameType == GameType.Expansion ? 2 : 1
                };
            }

            // Create the new game request
            var request = new NewGameRequest
            {
                GameType = SelectedGameType,
                PlayerIds = playerIds,
                GameName = $"Game {DateTime.Now:HH:mm}",
                HouseRules = houseRules
            };

            // Call the GameService API
            var response = await Http.PostAsJsonAsync($"{Config.BaseUrl}/api/game/new", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NewGameResponse>();
                if (result?.Success == true && !string.IsNullOrEmpty(result.GameId))
                {
                    // Navigate to the game page
                    Navigation.NavigateTo($"/game/{result.GameId}");
                }
                else
                {
                    ErrorMessage = "Failed to create game - invalid response";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Failed to create game: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error creating game: {ex.Message}";
            Console.WriteLine($"Error creating game: {ex}");
        }
        finally
        {
            IsCreatingGame = false;
        }
    }

    // Response classes for the API
    private class GetPlayersApiResponse
    {
        public bool Success { get; set; }
        public List<PlayerProfile> Players { get; set; } = new();
        public int Count { get; set; }
        public string Timestamp { get; set; } = string.Empty;
    }

    private class NewGameRequest
    {
        public GameType GameType { get; set; }
        public List<string> PlayerIds { get; set; } = new();
        public string GameName { get; set; } = string.Empty;
        public HouseRules? HouseRules { get; set; }
    }

    private class NewGameResponse
    {
        public bool Success { get; set; }
        public string GameId { get; set; } = string.Empty;
    }

    private async Task LoadSavedGamesAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<GetSavedGamesResponse>($"{Config.BaseUrl}/api/games?playerId=WebUI");
            if (response?.Success == true && response.Games != null)
            {
                SavedGames = response.Games;
            }
        }
        catch (Exception ex)
        {
            // Don't show error for saved games - just log it
            Console.WriteLine($"Error loading saved games: {ex.Message}");
        }
    }

    private async Task LoadSavedGame(string gameId)
    {
        if (IsLoadingGame) return;

        try
        {
            IsLoadingGame = true;
            ErrorMessage = null;

            // Load the game from database into memory
            var response = await Http.PostAsync($"{Config.BaseUrl}/api/game/{gameId}/load", null);

            if (response.IsSuccessStatusCode)
            {
                // Navigate to the game page
                Navigation.NavigateTo($"/game/{gameId}");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Failed to load game: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading game: {ex.Message}";
            Console.WriteLine($"Error loading game: {ex}");
        }
        finally
        {
            IsLoadingGame = false;
        }
    }

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        var kb = bytes / 1024.0;
        return $"{kb:F1} KB";
    }

    private class GetSavedGamesResponse
    {
        public bool Success { get; set; }
        public List<SavedGameInfo> Games { get; set; } = new();
        public int Count { get; set; }
        public string Timestamp { get; set; } = string.Empty;
    }

    private class SavedGameInfo
    {
        public string GameId { get; set; } = string.Empty;
        public string GameName { get; set; } = string.Empty;
        public string GameState { get; set; } = string.Empty;
        public string GameType { get; set; } = string.Empty;
        public int PlayerCount { get; set; }
        public string PlayerNames { get; set; } = string.Empty;
        public int TurnCount { get; set; }
        public int Size { get; set; }
        public DateTime SavedAt { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
