@page "/game/{GameId}"
@using Microsoft.AspNetCore.SignalR.Client
@using Catan3.Shared.Models
@using Catan3.Shared.Utility
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering
@using Catan3.WebUI.Components.Board
@using Catan3.WebUI.Components.Resources
@using Catan3.WebUI.Components.Players
@using Catan3.WebUI.Components.Shared
@inject GameServiceConfig Config
@inject GameCommandProxy CommandProxy
@inject HttpClient Http
@inject GameStateService GameStateService
@inject IAssetService AssetService
@implements IAsyncDisposable

<PageTitle>Catan Game</PageTitle>

<div class="game-viewport">
<div class="game-layout">
    @if (IsConnecting)
    {
        <div class="loading-overlay">
            <h2>Connecting to game...</h2>
            <p>Game ID: @GameId</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-overlay">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
            <button class="btn btn-primary" @onclick="RetryConnection">Retry</button>
        </div>
    }
    else if (GameModel != null)
    {
        <!-- LEFT PANEL -->
        <div class="left-panel">
            <div class="left-panel-content">
            <!-- Game Controls (Undo/Next/Redo) -->
            <div class="game-controls" style="@GetCurrentPlayerGradient()">
                <div class="control-buttons">
                    <button class="game-btn" @onclick="OnUndoClick" disabled="@(!GameModel.ActionFlags.UndoEnabled)">
                        <span class="btn-icon">&#x21A9;</span>
                        <span class="btn-label">Undo</span>
                    </button>
                    <button class="game-btn" @onclick="OnNextClick" disabled="@(!GameModel.ActionFlags.NextEnabled)">
                        <span class="btn-icon">&#x25B6;</span>
                        <span class="btn-label">Next</span>
                    </button>
                    <button class="game-btn" @onclick="OnRedoClick" disabled="@(!GameModel.ActionFlags.RedoEnabled)">
                        <span class="btn-icon">&#x21AA;</span>
                        <span class="btn-label">Redo</span>
                    </button>
                </div>
                <div class="state-message" style="color: @GetCurrentPlayerForeground()">@GetStateMessage()</div>
                @if (!string.IsNullOrEmpty(CommandError))
                {
                    <div class="command-error">@CommandError</div>
                }
            </div>

            <!-- Purchase Controls -->
            <div class="purchase-controls">
                <div class="purchase-grid">
                    <PurchaseButton Entitlement="Entitlement.Road"
                                    SpentCount="@GetSpentCount(Entitlement.Road)"
                                    MaxCount="@(GameModel?.ResourceRules?.MaxRoads ?? 15)"
                                    UnspentCount="@GetUnspentCount(Entitlement.Road)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.Road)"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.Road))" />
                    <PurchaseButton Entitlement="Entitlement.Settlement"
                                    SpentCount="@GetSpentCount(Entitlement.Settlement)"
                                    MaxCount="@(GameModel?.ResourceRules?.MaxSettlements ?? 5)"
                                    UnspentCount="@GetUnspentCount(Entitlement.Settlement)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.Settlement)"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.Settlement))" />
                    <PurchaseButton Entitlement="Entitlement.City"
                                    SpentCount="@GetSpentCount(Entitlement.City)"
                                    MaxCount="@(GameModel?.ResourceRules?.MaxCities ?? 4)"
                                    UnspentCount="@GetUnspentCount(Entitlement.City)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.City)"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.City))" />
                    <PurchaseButton Entitlement="Entitlement.Soldier"
                                    SpentCount="@GetSpentCount(Entitlement.Soldier)"
                                    MaxCount="0"
                                    UnspentCount="@GetUnspentCount(Entitlement.Soldier)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.Soldier)"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.Soldier))" />
                </div>
            </div>

            <!-- Roll Entry -->
            <div class="roll-entry" style="@GetCurrentPlayerGradient()">
                <div class="roll-grid">
                    @for (int i = 2; i <= 12; i++)
                    {
                        var roll = i;
                        <div class="roll-cell" @onclick="() => OnRollClick(roll)">
                            <div class="roll-count">@GetRollCount(roll)</div>
                            <div class="roll-catan-number">
                                @((MarkupString)RenderCatanNumberSvg(roll))
                            </div>
                            <div class="roll-percentage">@GetRollPercentage(roll)</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Board Measurements (only during PickingBoard) -->
            @if (GameModel?.GameState == GameState.PickingBoard)
            {
                <div class="board-measurements" style="@GetCurrentPlayerGradient()">
                    <BoardMeasurement GameModel="@GameModel"
                                      OnShuffle="OnShuffleClick"
                                      ShownStars="@ShownStars"
                                      ShownStarsChanged="HandleShownStarsChanged"
                                      SelectedResourcesChanged="HandleSelectedResourcesChanged" />
                </div>
            }

            <!-- Player Tracking (always visible during gameplay) -->
            @if (GameModel.GameState != GameState.PickingBoard && CurrentPlayer != null)
            {
                <div class="player-tracking" style="@GetCurrentPlayerGradient()">
                    <PlayerTracking GameModel="@GameModel"
                                    CurrentPlayerId="@CurrentPlayer.Id" />
                </div>
            }
            </div>
        </div>

        <!-- CENTER PANEL - Game Board -->
        <div class="center-panel">
            <div class="panel-section game-board">
                <div class="board-container">
                    <BoardContainer GameModel="@GameModel"
                                    Players="@GameStateService.Players"
                                    AssetService="@AssetService"
                                    ShownStars="@ShownStars"
                                    FilteredResources="@FilteredResources" />
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">
            <!-- Resource Tracking -->
            <ResourceTracking GameModel="@GameModel" />

            <!-- Players Panel -->
            <PlayersPanel GameModel="@GameModel"
                          PlayerColorMap="@PlayerColorMap"
                          PlayerProfiles="@PlayerProfiles" />
        </div>
    }
    else
    {
        <div class="loading-overlay">
            <h2>Waiting for game data...</h2>
            <p>Connection State: @(_hubConnection?.State.ToString() ?? "Not created")</p>
        </div>
    }
</div>
</div>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    private HubConnection? _hubConnection;
    private GameModel? GameModel { get; set; }
    private Dictionary<string, PlayerProfile> PlayerProfiles { get; set; } = new();

    /// <summary>
    /// Dictionary mapping player IDs to their PlayerColors for gradient display.
    /// Populated during OnInitializedAsync when loading player profiles.
    /// </summary>
    private Dictionary<string, PlayerColors> PlayerColorMap { get; set; } = new();

    private string? TestOverridePlayerId { get; set; } // For testing: click player to see their colors
    private bool IsConnecting { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string? CommandError { get; set; }
    private int ShownStars { get; set; } = 13;  // Default to 13 to show only premium building sites (matches Desktop)
    private HashSet<ResourceType> FilteredResources { get; set; } = new();  // Resources selected for filtering buildings (max 3)

    // Purchase button test override state (null = use game state, true = force face up, false = force face down)
    // Right-click toggles the override to flip the card for testing
    private Dictionary<Entitlement, bool?> _purchaseTestOverride = new()
    {
        { Entitlement.Road, null },
        { Entitlement.Settlement, null },
        { Entitlement.City, null },
        { Entitlement.Soldier, null }
    };

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to theme changes to re-render the board
        AssetService.ThemeChanged += OnThemeChanged;
        await ConnectToGameAsync();
    }

    private void OnThemeChanged(string themeName)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task EnsurePlayerProfilesLoadedAsync()
    {
        // Check if we need to load profiles for current game players
        if (GameModel == null) return;

        var missingProfiles = GameModel.Players
            .Where(p => !PlayerProfiles.ContainsKey(p.Id))
            .Select(p => p.Id)
            .ToList();

        if (missingProfiles.Count == 0) return;

        try
        {
            var response = await Http.GetFromJsonAsync<PlayersResponse>($"{Config.BaseUrl}/api/players");
            if (response?.Players != null)
            {
                foreach (var player in response.Players)
                {
                    PlayerProfiles[player.Id] = player;

                    // Populate PlayerColorMap for PlayersPanel component
                    // PlayerProfile.Colors already contains the PlayerColors record
                    PlayerColorMap[player.Id] = player.Colors;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load player profiles: {ex.Message}");
        }
    }

    /// <summary>
    /// Gets the current player from the GameModel.
    /// </summary>
    private PlayerModel? CurrentPlayer
    {
        get
        {
            if (GameModel == null) return null;
            return GameModel.Players.FirstOrDefault(p => p.Id == GameModel.CurrentPlayerId);
        }
    }

    private string GetCurrentPlayerGradient()
    {
        if (GameModel == null) return "background: #666;";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return $"background: {player.Colors.CssGradient};";
        }

        return $"background: {PlayerColors.Default.CssGradient};";
    }

    private string GetCurrentPlayerForeground()
    {
        if (GameModel == null) return "#FFFFFF";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return player.ForegroundColor;
        }

        return "#FFFFFF";
    }

    private PlayerColors GetCurrentPlayerColors()
    {
        if (GameModel == null) return PlayerColors.Default;

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return player.Colors;
        }

        return PlayerColors.Default;
    }

    private void OnPlayerClick(string playerId)
    {
        // Toggle: if clicking same player, clear override; otherwise set it
        TestOverridePlayerId = (TestOverridePlayerId == playerId) ? null : playerId;
        StateHasChanged();
    }

    private int GetSpentCount(Entitlement entitlement)
    {
        if (GameModel == null) return 0;

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;
        var player = GameModel.Players.FirstOrDefault(p => p.Id == playerId);

        return player?.SpentEntitlementsThisGame?.Count(e => e == entitlement) ?? 0;
    }

    private int GetUnspentCount(Entitlement entitlement)
    {
        if (GameModel == null) return 0;

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;
        var player = GameModel.Players.FirstOrDefault(p => p.Id == playerId);

        return player?.UnspentEntitlements?.Count(e => e == entitlement) ?? 0;
    }

    private bool GetIsFaceUp(Entitlement entitlement)
    {
        // Get the game's actual enabled state for this entitlement
        var gameEnabled = GameModel?.PurchaseModel(entitlement).Enabled ?? false;

        // Check if there's a test override
        if (_purchaseTestOverride.TryGetValue(entitlement, out var testOverride) && testOverride.HasValue)
        {
            // Override is set - use it (XOR with game state to toggle)
            return testOverride.Value;
        }

        // No override - use game state
        return gameEnabled;
    }

    private void ToggleFaceUp(Entitlement entitlement)
    {
        // Get current displayed state and toggle it as the override
        var currentState = GetIsFaceUp(entitlement);
        _purchaseTestOverride[entitlement] = !currentState;
        StateHasChanged();
    }

    private async Task HandleShownStarsChanged(int newValue)
    {
        ShownStars = newValue;
        StateHasChanged(); // Trigger re-render with new star threshold
        await Task.CompletedTask;
    }

    private async Task HandleSelectedResourcesChanged(HashSet<ResourceType> selectedResources)
    {
        FilteredResources = selectedResources;
        StateHasChanged(); // Trigger re-render with new resource filter
        await Task.CompletedTask;
    }

    private class PlayersResponse
    {
        public List<PlayerProfile> Players { get; set; } = new();
    }

    private async Task ConnectToGameAsync()
    {
        try
        {
            IsConnecting = true;
            ErrorMessage = null;

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Config.HubUrl)
                .WithAutomaticReconnect()
                .AddJsonProtocol(options =>
                {
                    JsonHelper.ConfigureOptions(options.PayloadSerializerOptions);
                })
                .Build();

            _hubConnection.On<GameModel>("GameStateUpdated", OnGameStateUpdated);

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinGame", GameId, "WebUI-Client");

            IsConnecting = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to connect: {ex.Message}";
            IsConnecting = false;
        }
    }

    private void OnGameStateUpdated(GameModel gameModel)
    {
        GameModel = gameModel;
        GameStateService.UpdateGameModel(gameModel);

        InvokeAsync(async () =>
        {
            await EnsurePlayerProfilesLoadedAsync();
            GameStateService.UpdatePlayerData(PlayerProfiles);
            StateHasChanged();
        });
    }

    private async Task RetryConnection()
    {
        await ConnectToGameAsync();
    }

    private async Task OnUndoClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Undo", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                CommandError = $"Undo failed: {ex.Message}";
            }
        }
    }

    private async Task OnRedoClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Redo", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                CommandError = $"Redo failed: {ex.Message}";
            }
        }
    }

    private async Task OnNextClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Next", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                CommandError = $"Next failed: {ex.Message}";
            }
        }
    }

    private async Task OnRollClick(int roll)
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Roll", GameId, GameModel.CurrentPlayerId, roll);
            }
            catch (Exception ex)
            {
                CommandError = $"Roll failed: {ex.Message}";
            }
        }
    }

    private async Task OnShuffleClick()
    {
        if (GameModel != null)
        {
            try
            {
                CommandError = null;
                var result = await CommandProxy.ShuffleAsync(GameId, GameModel.CurrentPlayerId);
                if (!result.Success)
                {
                    CommandError = result.Error;
                }
            }
            catch (Exception ex)
            {
                CommandError = ex.Message;
            }
        }
    }

    private string GetStateMessage()
    {
        return GameModel?.GameState switch
        {
            GameState.WaitingForNewGame => "New Game",
            GameState.PickingBoard => "Accept Board",
            GameState.AllocateResourceForward => "Place Settlement",
            GameState.AllocateResourceReverse => "Place Settlement",
            GameState.WaitingForRoll => "Roll Dice",
            GameState.Supplemental => "Supplemental Phase",
            _ => GameModel?.GameState.ToString() ?? "Unknown"
        };
    }

    private string GetRollCount(int roll)
    {
        if (GameModel?.RollModel?.GameRollModel?.RollCounts == null) return "0";
        var index = roll - 2; // RollCounts array is 0-indexed for rolls 2-12
        if (index < 0 || index >= GameModel.RollModel.GameRollModel.RollCounts.Length) return "0";
        return GameModel.RollModel.GameRollModel.RollCounts[index].ToString();
    }

    private string GetRollPercentage(int roll)
    {
        if (GameModel?.RollModel?.GameRollModel == null) return "0%";
        var rollCounts = GameModel.RollModel.GameRollModel.RollCounts;
        var totalRolls = GameModel.RollModel.GameRollModel.TotalRolls;

        if (totalRolls == 0) return "0%";

        var index = roll - 2;
        if (index < 0 || index >= rollCounts.Length) return "0%";

        var count = rollCounts[index];
        var percent = (double)count / (double)totalRolls * 100;
        return $"{Math.Round(percent, 2)}%";
    }

    private string RenderCatanNumberSvg(int number)
    {
        // Use the shared CatanNumberSvg helper for consistent rendering
        // Default radius (30) matches BoardSvgConstants.NumberTokenRadius used on tiles
        return CatanNumberSvg.RenderStandalone(number);
    }

    private string GetDebugInfo()
    {
        if (GameModel == null) return "No game data";

        var profileIds = string.Join(", ", PlayerProfiles.Keys);
        var gamePlayerIds = string.Join(", ", GameModel.Players.Select(p => p.Id));
        var currentId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;
        var hasProfile = PlayerProfiles.ContainsKey(currentId);

        var debugInfo = $"State: {GameModel.GameState}\n" +
               $"Game Players: {gamePlayerIds}\n" +
               $"Profiles Loaded: {PlayerProfiles.Count} [{profileIds}]\n" +
               $"Current/Override: {currentId}\n" +
               $"Has Profile: {hasProfile}";

        if (!string.IsNullOrEmpty(CommandError))
        {
            debugInfo += $"\n<span class=\"error-line\">ERROR: {CommandError}</span>";
        }

        return debugInfo;
    }

    public async ValueTask DisposeAsync()
    {
        AssetService.ThemeChanged -= OnThemeChanged;
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
