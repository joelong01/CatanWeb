@page "/game/{GameId}"
@using Microsoft.AspNetCore.SignalR.Client
@using Catan3.Shared.Models
@using Catan3.Shared.Utility
@using Catan3.WebUI.Services
@inject GameServiceConfig Config
@inject GameCommandProxy CommandProxy
@implements IAsyncDisposable

<PageTitle>Catan Game</PageTitle>

<div class="game-layout">
    @if (IsConnecting)
    {
        <div class="loading-overlay">
            <h2>Connecting to game...</h2>
            <p>Game ID: @GameId</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-overlay">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
            <button class="btn btn-primary" @onclick="RetryConnection">Retry</button>
        </div>
    }
    else if (GameModel != null)
    {
        <!-- LEFT PANEL -->
        <div class="left-panel">
            <!-- Game Controls (Undo/Next/Redo) -->
            <div class="panel-section game-controls" style="background: #FF7F50;">
                <div class="panel-label">Game Controls</div>
                <div class="panel-content">
                    <div class="control-buttons">
                        <button class="game-btn" disabled="@(!GameModel.ActionFlags.UndoEnabled)">
                            <span class="btn-icon">↶</span>
                            <span class="btn-label">Undo</span>
                        </button>
                        <button class="game-btn" @onclick="OnNextClick" disabled="@(!GameModel.ActionFlags.NextEnabled)">
                            <span class="btn-icon">▶</span>
                            <span class="btn-label">Next</span>
                        </button>
                        <button class="game-btn" disabled="@(!GameModel.ActionFlags.RedoEnabled)">
                            <span class="btn-icon">↷</span>
                            <span class="btn-label">Redo</span>
                        </button>
                    </div>
                    <div class="state-message">@GetStateMessage()</div>
                </div>
            </div>

            <!-- Purchase Controls -->
            <div class="panel-section purchase-controls" style="background: #FFD700;">
                <div class="panel-label">Purchase Controls</div>
                <div class="panel-content">
                    <div class="purchase-grid">
                        <div class="purchase-card">Road</div>
                        <div class="purchase-card">Settlement</div>
                        <div class="purchase-card">City</div>
                        <div class="purchase-card">Dev Card</div>
                    </div>
                </div>
            </div>

            <!-- Roll Entry -->
            <div class="panel-section roll-entry" style="background: #FF6347;">
                <div class="panel-label">Roll Entry (2-12)</div>
                <div class="panel-content">
                    <div class="roll-grid">
                        @for (int i = 2; i <= 12; i++)
                        {
                            var roll = i;
                            <div class="roll-button @(roll == 6 || roll == 8 ? "high-prob" : "")">
                                <span class="roll-number">@roll</span>
                                <span class="roll-pips">@GetPips(roll)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Board Measurements (only during PickingBoard) -->
            @if (GameModel.GameState == GameState.PickingBoard)
            {
                <div class="panel-section board-measurements" style="background: #FFA500;">
                    <div class="panel-label">Board Measurements</div>
                    <div class="panel-content">
                        <button class="btn btn-sm" @onclick="OnShuffleClick">Shuffle</button>
                        <div class="star-counts">Star balance info here</div>
                    </div>
                </div>
            }
        </div>

        <!-- CENTER PANEL - Game Board -->
        <div class="center-panel">
            <div class="panel-section game-board" style="background: #1E90FF;">
                <div class="board-container">
                    <object data="@($"{Config.BaseUrl}/api/game/{GameId}/board.svg?v={GameModel.GameHash}")"
                            type="image/svg+xml"
                            style="max-width: 100%; max-height: 100%; width: auto; height: auto;">
                        Game Board
                    </object>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">
            <!-- Tracked Resources -->
            <div class="panel-section tracked-resources" style="background: #3CB371;">
                <div class="panel-label">Tracked Resources</div>
                <div class="panel-content">
                    <div class="resource-cards">
                        <div class="resource-card">🌾</div>
                        <div class="resource-card">🪵</div>
                        <div class="resource-card">🪨</div>
                        <div class="resource-card">🧱</div>
                        <div class="resource-card">🐑</div>
                    </div>
                </div>
            </div>

            <!-- Player List -->
            <div class="panel-section player-list" style="background: #6A5ACD;">
                <div class="panel-label">Player List & Stats</div>
                <div class="panel-content">
                    @foreach (var player in GameModel.Players)
                    {
                        <div class="player-row @(player.Id == GameModel.CurrentPlayerId ? "current-player" : "")">
                            <div class="player-avatar">👤</div>
                            <div class="player-info">
                                <span class="player-name">@player.Name</span>
                                <span class="player-score">Score: @player.Score</span>
                            </div>
                            @if (player.Id == GameModel.CurrentPlayerId)
                            {
                                <span class="current-indicator">◀</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Debug Panel -->
            <div class="panel-section debug-panel" style="background: #444;">
                <details>
                    <summary style="color: white; cursor: pointer;">Debug Info</summary>
                    <pre style="color: #aaa; font-size: 10px; margin: 5px 0;">@GetDebugInfo()</pre>
                </details>
            </div>
        </div>
    }
    else
    {
        <div class="loading-overlay">
            <h2>Waiting for game data...</h2>
            <p>Connection State: @(_hubConnection?.State.ToString() ?? "Not created")</p>
        </div>
    }
</div>

<style>
    .game-layout {
        display: grid;
        grid-template-columns: 280px 1fr 280px;
        gap: 10px;
        height: calc(100vh - 60px);
        padding: 10px;
        background: #222;
    }

    .left-panel, .right-panel {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
    }

    .center-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0; /* Allow flex item to shrink below content size */
    }

    .panel-section {
        border-radius: 8px;
        padding: 10px;
        display: flex;
        flex-direction: column;
    }

    .panel-label {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        margin-bottom: 8px;
        color: #333;
        text-transform: uppercase;
    }

    .panel-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    /* Game Controls */
    .game-controls {
        min-height: 120px;
    }

    .control-buttons {
        display: flex;
        gap: 5px;
        margin-bottom: 10px;
    }

    .game-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 12px;
        border: none;
        border-radius: 4px;
        background: rgba(0,0,0,0.3);
        color: white;
        cursor: pointer;
    }

    .game-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-icon {
        font-size: 20px;
    }

    .btn-label {
        font-size: 10px;
    }

    .state-message {
        font-size: 11px;
        text-align: center;
        color: #333;
    }

    /* Purchase Controls */
    .purchase-controls {
        min-height: 140px;
    }

    .purchase-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
    }

    .purchase-card {
        background: rgba(0,0,0,0.3);
        color: white;
        padding: 15px 10px;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
    }

    /* Roll Entry */
    .roll-entry {
        min-height: 200px;
    }

    .roll-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }

    .roll-button {
        background: rgba(0,0,0,0.5);
        color: white;
        padding: 8px;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .roll-button.high-prob {
        color: #ff4444;
    }

    .roll-number {
        font-size: 16px;
        font-weight: bold;
    }

    .roll-pips {
        font-size: 10px;
    }

    /* Board Measurements */
    .board-measurements {
        min-height: 100px;
    }

    /* Game Board */
    .game-board {
        flex: 1;
        min-height: 0; /* Allow flex item to shrink */
        overflow: hidden;
    }

    .board-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Tracked Resources */
    .tracked-resources {
        min-height: 100px;
    }

    .resource-cards {
        display: flex;
        gap: 5px;
    }

    .resource-card {
        background: rgba(0,0,0,0.3);
        padding: 10px;
        border-radius: 4px;
        font-size: 20px;
    }

    /* Player List */
    .player-list {
        flex: 1;
        min-height: 200px;
    }

    .player-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        background: rgba(0,0,0,0.2);
        border-radius: 4px;
        margin-bottom: 5px;
        color: white;
    }

    .player-row.current-player {
        background: rgba(255,255,255,0.2);
        border: 1px solid white;
    }

    .player-avatar {
        font-size: 24px;
    }

    .player-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .player-name {
        font-weight: bold;
        font-size: 12px;
    }

    .player-score {
        font-size: 10px;
        opacity: 0.8;
    }

    .current-indicator {
        font-size: 12px;
    }

    /* Loading/Error overlays */
    .loading-overlay, .error-overlay {
        grid-column: 1 / -1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .error-overlay {
        color: #ff6b6b;
    }
</style>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    private HubConnection? _hubConnection;
    private GameModel? GameModel { get; set; }
    private bool IsConnecting { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string? CommandError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ConnectToGameAsync();
    }

    private async Task ConnectToGameAsync()
    {
        try
        {
            IsConnecting = true;
            ErrorMessage = null;

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Config.HubUrl)
                .WithAutomaticReconnect()
                .AddJsonProtocol(options =>
                {
                    JsonHelper.ConfigureOptions(options.PayloadSerializerOptions);
                })
                .Build();

            _hubConnection.On<GameModel>("GameStateUpdated", OnGameStateUpdated);

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinGame", GameId, "WebUI-Client");

            IsConnecting = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to connect: {ex.Message}";
            IsConnecting = false;
        }
    }

    private void OnGameStateUpdated(GameModel gameModel)
    {
        GameModel = gameModel;
        InvokeAsync(StateHasChanged);
    }

    private async Task RetryConnection()
    {
        await ConnectToGameAsync();
    }

    private async Task OnNextClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                await _hubConnection.InvokeAsync("Next", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending Next: {ex}");
            }
        }
    }

    private async Task OnShuffleClick()
    {
        if (GameModel != null)
        {
            try
            {
                CommandError = null;
                var result = await CommandProxy.ShuffleAsync(GameId, GameModel.CurrentPlayerId);
                if (!result.Success)
                {
                    CommandError = result.Error;
                }
            }
            catch (Exception ex)
            {
                CommandError = ex.Message;
            }
        }
    }

    private string GetStateMessage()
    {
        return GameModel?.GameState switch
        {
            GameState.WaitingForNewGame => "New Game",
            GameState.PickingBoard => "Accept Board",
            GameState.AllocateResourceForward => "Place Settlement",
            GameState.AllocateResourceReverse => "Place Settlement",
            GameState.WaitingForRoll => "Roll Dice",
            GameState.Supplemental => "Supplemental Phase",
            _ => GameModel?.GameState.ToString() ?? "Unknown"
        };
    }

    private string GetPips(int roll)
    {
        return roll switch
        {
            2 or 12 => "•",
            3 or 11 => "••",
            4 or 10 => "•••",
            5 or 9 => "••••",
            6 or 8 => "•••••",
            7 => "",
            _ => ""
        };
    }

    private string GetDebugInfo()
    {
        if (GameModel == null) return "No game data";
        return $"State: {GameModel.GameState}\nPlayers: {GameModel.Players.Count}\nTiles: {GameModel.Tiles.Count}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
