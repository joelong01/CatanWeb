    /// <summary>
    /// Handles tile click for robber placement (touch/click alternative to right-click).
    /// Shows the robber target menu centered on screen for the selected tile.
    /// </summary>
    private async Task OnTileClickForRobber(MouseEventArgs e)
    {
        // Only handle during MustMoveRobber state
        if (GameModel?.GameState != GameState.MustMoveRobber) return;

        // Use the ONE FUNCTION to get tile at click position
        var tile = await GetTileAtClientCoords(e.ClientX, e.ClientY);
        if (tile == null) return;

        // Can't place on sea
        if (tile.ResourceTileType == ResourceType.Sea) return;

        // Can't place on current robber location unless it's desert (house rule)
        if (tile.TileKey.Equals(GameModel.Robber.Coordinates) && tile.ResourceTileType != ResourceType.Desert) return;

        // Get target players for this tile
        _robberMenuTargets = GetRobberTargetsForTile(tile);
        _robberMenuTile = tile;

        // Position menu in center of viewport for mobile-friendly display
        try
        {
            var viewportInfo = await JSRuntime.InvokeAsync<ViewportInfo?>("eval",
                "({ width: window.innerWidth, height: window.innerHeight })");

            if (viewportInfo != null)
            {
                // Center the menu (menu will be ~200px wide, ~150px tall estimate)
                _robberMenuX = (viewportInfo.Width - 200) / 2;
                _robberMenuY = (viewportInfo.Height - 200) / 2;
            }
            else
            {
                // Fallback to reasonable defaults
                _robberMenuX = 100;
                _robberMenuY = 100;
            }
        }
        catch
        {
            // Fallback position
            _robberMenuX = 100;
            _robberMenuY = 100;
        }

        _robberMenuVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Viewport dimensions for menu centering.
    /// </summary>
    private record ViewportInfo(double Width, double Height);

    /// <summary>
    /// Converts client (screen) coordinates to the tile at that position.
    /// Uses JS interop to get SVG coordinates, then PixelToHex for accurate tile detection.
    /// This is the ONE FUNCTION for all coordinate-to-tile conversion.
    /// </summary>
    private async Task<TileModel?> GetTileAtClientCoords(double clientX, double clientY)
    {
        if (GameModel == null) return null;

        try
        {
            // Use JS to convert client coordinates to SVG viewBox coordinates
            var svgCoords = await JSRuntime.InvokeAsync<double[]?>("clientToSvgCoords", clientX, clientY);
            if (svgCoords == null || svgCoords.Length < 2) return null;

            // Convert SVG pixel coords to hex coordinates and find tile
            var coords = BoardGeometry.PixelToHex(svgCoords[0], svgCoords[1]);
            return GameModel.Tiles.FirstOrDefault(t => t.TileKey == coords);
        }
        catch
        {
            return null;
        }
    }

