    private void StartRollDimTimer()
    {
        // Cancel any existing timer
        _rollDimCts?.Cancel();
        _rollDimCts = new CancellationTokenSource();
        var token = _rollDimCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(BoardSvgConstants.TileDimDurationSeconds), token);
                if (!token.IsCancellationRequested)
                {
                    _lastKnownRoll = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException)
            {
                // Timer was cancelled, ignore
            }
        }, token);
    }

