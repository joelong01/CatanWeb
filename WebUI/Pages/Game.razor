        if (e.Key == "Enter")
        {
            await SaveGameName();
        }
        else if (e.Key == "Escape")
        {
            _editingName = _originalName;
            _isEditingName = false;
            StateHasChanged();
        }
    }

    private async Task SaveGameName()
    {
        _isEditingName = false;

        // Only save if name changed and not empty
        if (string.IsNullOrWhiteSpace(_editingName) || _editingName == _originalName)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var url = $"{Config.BaseUrl}/api/game/{GameId}/rename?newName={Uri.EscapeDataString(_editingName)}";
            var request = new HttpRequestMessage(HttpMethod.Patch, url);
            var response = await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Failed to rename game: {response.StatusCode}");
                // The SignalR update will refresh the name anyway
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error renaming game: {ex.Message}");
        }

        StateHasChanged();
    }

    #endregion

    public async ValueTask DisposeAsync()
    {
        _disposed = true; // Set first to guard against callbacks
        AssetService.ThemeChanged -= OnThemeChanged;
        Connection.GameStateUpdated -= OnGameStateUpdated;
        _rollDimCts?.Cancel();
        _rollDimCts?.Dispose();
        _flipAnimationCts?.Cancel();
        _flipAnimationCts?.Dispose();
        _dotNetRef?.Dispose();
        // Don't dispose the Connection service - it's a singleton that persists across pages
        await Task.CompletedTask;
    }
}
