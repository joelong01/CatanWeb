@page "/game/{GameId}"
@using Microsoft.AspNetCore.SignalR.Client
@using Catan3.Shared.Models
@using Catan3.Shared.Utility
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering
@using Catan3.WebUI.Components.Board
@inject GameServiceConfig Config
@inject GameCommandProxy CommandProxy
@inject HttpClient Http
@inject GameStateService GameStateService
@implements IAsyncDisposable

<PageTitle>Catan Game</PageTitle>

<div class="game-layout">
    @if (IsConnecting)
    {
        <div class="loading-overlay">
            <h2>Connecting to game...</h2>
            <p>Game ID: @GameId</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-overlay">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
            <button class="btn btn-primary" @onclick="RetryConnection">Retry</button>
        </div>
    }
    else if (GameModel != null)
    {
        <!-- LEFT PANEL -->
        <div class="left-panel">
            <!-- Game Controls (Undo/Next/Redo) -->
            <div class="game-controls" style="@GetCurrentPlayerGradient()">
                <div class="control-buttons">
                    <button class="game-btn" @onclick="OnUndoClick" disabled="@(!GameModel.ActionFlags.UndoEnabled)">
                        <span class="btn-icon">&#xE10E;</span>
                        <span class="btn-label">Undo</span>
                    </button>
                    <button class="game-btn" @onclick="OnNextClick" disabled="@(!GameModel.ActionFlags.NextEnabled)">
                        <span class="btn-icon">&#xE768;</span>
                        <span class="btn-label">Next</span>
                    </button>
                    <button class="game-btn" @onclick="OnRedoClick" disabled="@(!GameModel.ActionFlags.RedoEnabled)">
                        <span class="btn-icon">&#xE10D;</span>
                        <span class="btn-label">Redo</span>
                    </button>
                </div>
                <div class="state-message" style="color: @GetCurrentPlayerForeground()">@GetStateMessage()</div>
            </div>

            <!-- Purchase Controls -->
            <div class="purchase-controls" style="@GetCurrentPlayerGradient()">
                <div class="purchase-grid">
                    <div class="purchase-card">Road</div>
                    <div class="purchase-card">Settlement</div>
                    <div class="purchase-card">City</div>
                    <div class="purchase-card">Dev Card</div>
                </div>
            </div>

            <!-- Roll Entry -->
            <div class="roll-entry" style="@GetCurrentPlayerGradient()">
                <div class="roll-grid">
                    @for (int i = 2; i <= 12; i++)
                    {
                        var roll = i;
                        <div class="roll-cell" @onclick="() => OnRollClick(roll)">
                            <div class="roll-count">@GetRollCount(roll)</div>
                            <div class="roll-catan-number">
                                @((MarkupString)RenderCatanNumberSvg(roll))
                            </div>
                            <div class="roll-percentage">@GetRollPercentage(roll)</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Board Measurements (only during PickingBoard) -->
            @if (GameModel.GameState == GameState.PickingBoard)
            {
                <div class="board-measurements" style="@GetCurrentPlayerGradient()">
                    <BoardMeasurement GameModel="@GameModel"
                                      OnShuffle="OnShuffleClick"
                                      OnUndo="OnUndoClick"
                                      ShownStars="@ShownStars"
                                      ShownStarsChanged="HandleShownStarsChanged"
                                      SelectedResourcesChanged="HandleSelectedResourcesChanged" />
                </div>
            }
        </div>

        <!-- CENTER PANEL - Game Board -->
        <div class="center-panel">
            <div class="panel-section game-board">
                <div class="board-container">
                    @((MarkupString)GenerateBoardSvg())
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">
            <!-- Tracked Resources -->
            <div class="panel-section tracked-resources">
                <div class="panel-label">Tracked Resources</div>
                <div class="panel-content">
                    <div class="resource-cards">
                        <div class="resource-card">🌾</div>
                        <div class="resource-card">🪵</div>
                        <div class="resource-card">🪨</div>
                        <div class="resource-card">🧱</div>
                        <div class="resource-card">🐑</div>
                    </div>
                </div>
            </div>

            <!-- Player List -->
            <div class="panel-section player-list">
                <div class="panel-label">Player List & Stats</div>
                <div class="panel-content">
                    @foreach (var player in GameModel.Players)
                    {
                        <div class="player-row @(player.Id == GameModel.CurrentPlayerId ? "current-player" : "") @(player.Id == TestOverridePlayerId ? "test-selected" : "")"
                             @onclick="() => OnPlayerClick(player.Id)"
                             style="cursor: pointer;">
                            <div class="player-avatar">&#xE77B;</div>
                            <div class="player-info">
                                <span class="player-name">@player.Name</span>
                                <span class="player-score">Score: @player.Score</span>
                            </div>
                            @if (player.Id == GameModel.CurrentPlayerId)
                            {
                                <span class="current-indicator">&#xE76B;</span>
                            }
                            @if (player.Id == TestOverridePlayerId)
                            {
                                <span class="test-indicator">&#xE790;</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Debug Panel -->
            <div class="panel-section debug-panel @(CommandError != null ? "has-error" : "")">
                <details open="@(CommandError != null)">
                    <summary style="cursor: pointer;">Debug Info</summary>
                    <pre style="font-size: 10px; margin: 5px 0;">@((MarkupString)GetDebugInfo())</pre>
                </details>
            </div>
        </div>
    }
    else
    {
        <div class="loading-overlay">
            <h2>Waiting for game data...</h2>
            <p>Connection State: @(_hubConnection?.State.ToString() ?? "Not created")</p>
        </div>
    }
</div>

<style>
    .game-layout {
        display: grid;
        grid-template-columns: 280px 1fr 280px;
        gap: 10px;
        height: 100vh;
        padding: 10px;
        background: var(--game-bg-primary);
        box-sizing: border-box;
    }

    .left-panel, .right-panel {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        background: #000;
    }

    .center-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0; /* Allow flex item to shrink below content size */
        background: #000;
    }

    /* Section containers - no borders, natural flow */
    .game-controls,
    .purchase-controls,
    .roll-entry,
    .board-measurements {
        padding: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-radius: 4px;
        margin-bottom: 10px;
    }

    /* Game Controls */
    .control-buttons {
        display: flex;
        gap: 5px;
        margin-bottom: 10px;
    }

    .game-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 12px;
        border: none;
        border-radius: 4px;
        background: var(--overlay-dark);
        color: var(--text-primary);
        cursor: pointer;
    }

    .game-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-icon {
        font-family: 'Segoe MDL2 Assets';
        font-size: 20px;
    }

    .btn-label {
        font-size: 10px;
    }

    .state-message {
        font-size: 11px;
        text-align: center;
    }

    /* Purchase Controls */
    .purchase-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
        width: 100%;
    }

    .purchase-card {
        background: var(--overlay-dark);
        color: var(--text-primary);
        padding: 15px 10px;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
    }

    /* Roll Entry */
    .roll-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
        width: 100%;
    }

    .roll-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 5px;
        background: var(--overlay-darker);
        border-radius: 4px;
        cursor: pointer;
    }

    .roll-cell:hover {
        background: var(--overlay-dark);
    }

    .roll-count {
        font-size: 11px;
        color: var(--text-secondary);
        min-height: 14px;
    }

    .roll-catan-number svg {
        display: block;
    }

    .roll-percentage {
        font-size: 10px;
        color: var(--text-secondary);
        min-height: 12px;
    }

    /* Board Measurements */
    .board-measurements {
        min-height: 100px;
    }

    /* Game Board */
    .game-board {
        flex: 1;
        min-height: 0; /* Allow flex item to shrink */
        overflow: hidden;
    }

    .board-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Tracked Resources */
    .tracked-resources {
        min-height: 100px;
    }

    .resource-cards {
        display: flex;
        gap: 5px;
    }

    .resource-card {
        background: var(--overlay-dark);
        padding: 10px;
        border-radius: 4px;
        font-size: 20px;
    }

    /* Player List */
    .player-list {
        flex: 1;
        min-height: 200px;
    }

    .player-list .panel-content {
        justify-content: flex-start;
        align-items: stretch;
    }

    .player-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        background: var(--overlay-dark);
        border-radius: 4px;
        margin-bottom: 5px;
        color: var(--text-primary);
    }

    .player-row.current-player {
        background: var(--overlay-lighter);
        border: 1px solid var(--text-primary);
    }

    .player-avatar {
        font-family: 'Segoe MDL2 Assets';
        font-size: 24px;
    }

    .player-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .player-name {
        font-weight: bold;
        font-size: 12px;
    }

    .player-score {
        font-size: 10px;
        opacity: 0.8;
    }

    .current-indicator, .test-indicator {
        font-family: 'Segoe MDL2 Assets';
        font-size: 12px;
    }

    .player-row.test-selected {
        border: 2px solid var(--accent-success);
        background: rgba(76, 175, 80, 0.3);
    }

    .player-row:hover {
        background: var(--overlay-lighter);
    }

    /* Panel-specific backgrounds */
    .game-board {
        background: #000 !important;
    }

    .debug-panel {
        background: var(--game-bg-secondary) !important;
        transition: background-color 0.3s ease;
    }

    .debug-panel.has-error {
        background: rgba(255, 107, 107, 0.3) !important;
        animation: flash-error 0.5s ease-in-out 3;
    }

    @@keyframes flash-error {
        0%, 100% { background: var(--game-bg-secondary); }
        50% { background: rgba(255, 107, 107, 0.5); }
    }

    .debug-panel summary {
        color: var(--text-primary);
    }

    .debug-panel pre {
        color: var(--text-muted);
    }

    .debug-panel .error-line {
        color: #ff6b6b;
        font-weight: bold;
    }

    /* Loading/Error overlays */
    .loading-overlay, .error-overlay {
        grid-column: 1 / -1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .error-overlay {
        color: #ff6b6b;
    }
</style>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    private HubConnection? _hubConnection;
    private GameModel? GameModel { get; set; }
    private Dictionary<string, PlayerProfile> PlayerProfiles { get; set; } = new();
    private string? TestOverridePlayerId { get; set; } // For testing: click player to see their colors
    private bool IsConnecting { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string? CommandError { get; set; }
    private int ShownStars { get; set; } = 13;  // Default to 13 to show only premium building sites (matches Desktop)
    private HashSet<ResourceType> FilteredResources { get; set; } = new();  // Resources selected for filtering buildings (max 3)

    protected override async Task OnInitializedAsync()
    {
        await ConnectToGameAsync();
    }

    private async Task EnsurePlayerProfilesLoadedAsync()
    {
        // Check if we need to load profiles for current game players
        if (GameModel == null) return;

        var missingProfiles = GameModel.Players
            .Where(p => !PlayerProfiles.ContainsKey(p.Id))
            .Select(p => p.Id)
            .ToList();

        if (missingProfiles.Count == 0) return;

        try
        {
            var response = await Http.GetFromJsonAsync<PlayersResponse>($"{Config.BaseUrl}/api/players");
            if (response?.Players != null)
            {
                foreach (var player in response.Players)
                {
                    PlayerProfiles[player.Id] = player;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load player profiles: {ex.Message}");
        }
    }

    private string GetCurrentPlayerGradient()
    {
        if (GameModel == null) return "background: #666;";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return $"background: linear-gradient(135deg, {player.PrimaryBackgroundColor}, {player.SecondaryBackgroundColor});";
        }

        return "background: #666;";
    }

    private string GetCurrentPlayerForeground()
    {
        if (GameModel == null) return "#FFFFFF";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return player.ForegroundColor;
        }

        return "#FFFFFF";
    }

    private void OnPlayerClick(string playerId)
    {
        // Toggle: if clicking same player, clear override; otherwise set it
        TestOverridePlayerId = (TestOverridePlayerId == playerId) ? null : playerId;
        StateHasChanged();
    }

    private async Task HandleShownStarsChanged(int newValue)
    {
        ShownStars = newValue;
        StateHasChanged(); // Trigger re-render with new star threshold
        await Task.CompletedTask;
    }

    private async Task HandleSelectedResourcesChanged(HashSet<ResourceType> selectedResources)
    {
        FilteredResources = selectedResources;
        StateHasChanged(); // Trigger re-render with new resource filter
        await Task.CompletedTask;
    }

    private class PlayersResponse
    {
        public List<PlayerProfile> Players { get; set; } = new();
    }

    private async Task ConnectToGameAsync()
    {
        try
        {
            IsConnecting = true;
            ErrorMessage = null;

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Config.HubUrl)
                .WithAutomaticReconnect()
                .AddJsonProtocol(options =>
                {
                    JsonHelper.ConfigureOptions(options.PayloadSerializerOptions);
                })
                .Build();

            _hubConnection.On<GameModel>("GameStateUpdated", OnGameStateUpdated);

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinGame", GameId, "WebUI-Client");

            IsConnecting = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to connect: {ex.Message}";
            IsConnecting = false;
        }
    }

    private void OnGameStateUpdated(GameModel gameModel)
    {
        GameModel = gameModel;
        GameStateService.UpdateGameModel(gameModel);

        InvokeAsync(async () =>
        {
            await EnsurePlayerProfilesLoadedAsync();
            GameStateService.UpdatePlayerData(PlayerProfiles);
            StateHasChanged();
        });
    }

    private string GenerateBoardSvg()
    {
        if (GameModel == null)
            return "<svg><text x='50' y='50'>Waiting for game data...</text></svg>";

        try
        {
            return GameModel.GenerateSvg(
                GameStateService.Players,
                shownStars: ShownStars,
                dimmedTiles: null,
                filteredResources: FilteredResources
            );
        }
        catch (Exception ex)
        {
            return $"<svg><text x='50' y='50'>Error generating board: {ex.Message}</text></svg>";
        }
    }

    private async Task RetryConnection()
    {
        await ConnectToGameAsync();
    }

    private async Task OnUndoClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Undo", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                CommandError = $"Undo failed: {ex.Message}";
            }
        }
    }

    private async Task OnRedoClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Redo", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                CommandError = $"Redo failed: {ex.Message}";
            }
        }
    }

    private async Task OnNextClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Next", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                CommandError = $"Next failed: {ex.Message}";
            }
        }
    }

    private async Task OnRollClick(int roll)
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                CommandError = null;
                await _hubConnection.InvokeAsync("Roll", GameId, GameModel.CurrentPlayerId, roll);
            }
            catch (Exception ex)
            {
                CommandError = $"Roll failed: {ex.Message}";
            }
        }
    }

    private async Task OnShuffleClick()
    {
        if (GameModel != null)
        {
            try
            {
                CommandError = null;
                var result = await CommandProxy.ShuffleAsync(GameId, GameModel.CurrentPlayerId);
                if (!result.Success)
                {
                    CommandError = result.Error;
                }
            }
            catch (Exception ex)
            {
                CommandError = ex.Message;
            }
        }
    }

    private string GetStateMessage()
    {
        return GameModel?.GameState switch
        {
            GameState.WaitingForNewGame => "New Game",
            GameState.PickingBoard => "Accept Board",
            GameState.AllocateResourceForward => "Place Settlement",
            GameState.AllocateResourceReverse => "Place Settlement",
            GameState.WaitingForRoll => "Roll Dice",
            GameState.Supplemental => "Supplemental Phase",
            _ => GameModel?.GameState.ToString() ?? "Unknown"
        };
    }

    private int GetStarCountForNumber(int number)
    {
        // Uses the same logic as TileModel.Stars property
        return number switch
        {
            2 or 12 => 1,
            3 or 11 => 2,
            4 or 10 => 3,
            5 or 9 => 4,
            6 or 8 => 5,
            7 => 0,
            _ => 0
        };
    }

    private string GetStarsString(int starCount)
    {
        return starCount switch
        {
            1 => "★",
            2 => "★★",
            3 => "★★★",
            4 => "★★★★",
            5 => "★★★★★",
            _ => ""
        };
    }

    private string GetRollCount(int roll)
    {
        if (GameModel?.RollModel?.GameRollModel?.RollCounts == null) return "0";
        var index = roll - 2; // RollCounts array is 0-indexed for rolls 2-12
        if (index < 0 || index >= GameModel.RollModel.GameRollModel.RollCounts.Length) return "0";
        return GameModel.RollModel.GameRollModel.RollCounts[index].ToString();
    }

    private string GetRollPercentage(int roll)
    {
        if (GameModel?.RollModel?.GameRollModel == null) return "0%";
        var rollCounts = GameModel.RollModel.GameRollModel.RollCounts;
        var totalRolls = GameModel.RollModel.GameRollModel.TotalRolls;

        if (totalRolls == 0) return "0%";

        var index = roll - 2;
        if (index < 0 || index >= rollCounts.Length) return "0%";

        var count = rollCounts[index];
        var percent = (double)count / (double)totalRolls * 100;
        return $"{Math.Round(percent, 2)}%";
    }

    private string RenderCatanNumberSvg(int number)
    {
        // Render a standalone CatanNumber SVG matching tile number tokens
        var isHighProb = number == 6 || number == 8;
        var numberColor = isHighProb ? "#DC143C" : "white"; // Crimson for 6/8, white for others
        var starCount = GetStarCountForNumber(number);
        var starsString = GetStarsString(starCount);

        const int radius = 30;
        const int centerX = 30;
        const int centerY = 30;
        const int svgSize = 60;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($@"<svg width=""{svgSize}"" height=""{svgSize}"" viewBox=""0 0 {svgSize} {svgSize}"">");

        // Background circle (matches tile number token)
        sb.AppendLine($@"  <circle cx=""{centerX}"" cy=""{centerY}"" r=""{radius}"" fill=""#2B4F81"" opacity=""0.9"" stroke=""black"" stroke-width=""2""/>");

        // Number
        sb.AppendLine($@"  <text x=""{centerX}"" y=""{centerY - 10}"" text-anchor=""middle"" dominant-baseline=""middle"" font-family=""sans-serif"" font-size=""24"" font-weight=""bold"" fill=""{numberColor}"">{number}</text>");

        // Stars (if any)
        if (!string.IsNullOrEmpty(starsString))
        {
            sb.AppendLine($@"  <text x=""{centerX}"" y=""{centerY + 10}"" text-anchor=""middle"" font-size=""12"" fill=""{numberColor}"">{starsString}</text>");
        }

        sb.AppendLine("</svg>");
        return sb.ToString();
    }

    private string GetDebugInfo()
    {
        if (GameModel == null) return "No game data";

        var profileIds = string.Join(", ", PlayerProfiles.Keys);
        var gamePlayerIds = string.Join(", ", GameModel.Players.Select(p => p.Id));
        var currentId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;
        var hasProfile = PlayerProfiles.ContainsKey(currentId);

        var debugInfo = $"State: {GameModel.GameState}\n" +
               $"Game Players: {gamePlayerIds}\n" +
               $"Profiles Loaded: {PlayerProfiles.Count} [{profileIds}]\n" +
               $"Current/Override: {currentId}\n" +
               $"Has Profile: {hasProfile}";

        if (!string.IsNullOrEmpty(CommandError))
        {
            debugInfo += $"\n<span class=\"error-line\">ERROR: {CommandError}</span>";
        }

        return debugInfo;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
