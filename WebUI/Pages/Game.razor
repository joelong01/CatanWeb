    /// <summary>
    /// Gets the state message to display, matching Desktop app behavior.
    /// Shows unspent entitlement count during allocation/next phases, otherwise shows Description attribute.
    /// </summary>
    private string GetStateMessage()
    {
        if (GameModel == null) return "Unknown";

        var state = GameModel.GameState;

        // During allocation or WaitingForNext, show unspent entitlements count (matches Desktop)
        if (state == GameState.WaitingForNext ||
            state == GameState.AllocateResourceForward ||
            state == GameState.AllocateResourceReverse)
        {
            var player = GameModel.CurrentPlayer();
            var count = player.UnspentEntitlements.Count;
            if (count == 1)
                return $"[{count} Unspent Entitlement]";
            if (count > 1)
                return $"[{count} Unspent Entitlements]";
            // count == 0, fall through to description
        }

        // Use Description attribute from GameState enum (matches Desktop)
        return state.Description();
    }

    private string GetRollCount(int roll)
    {
        if (GameModel?.RollModel?.GameRollModel?.RollCounts == null) return "0";
        var index = roll - 2; // RollCounts array is 0-indexed for rolls 2-12
        if (index < 0 || index >= GameModel.RollModel.GameRollModel.RollCounts.Length) return "0";
        return GameModel.RollModel.GameRollModel.RollCounts[index].ToString();
    }

    private string GetRollPercentage(int roll)
    {
        if (GameModel?.RollModel?.GameRollModel == null) return "0%";
        var rollCounts = GameModel.RollModel.GameRollModel.RollCounts;
        var totalRolls = GameModel.RollModel.GameRollModel.TotalRolls;

        if (totalRolls == 0) return "0%";

        var index = roll - 2;
        if (index < 0 || index >= rollCounts.Length) return "0%";

        var count = rollCounts[index];
        var percent = (double)count / (double)totalRolls * 100;
        return $"{Math.Round(percent, 2)}%";
    }

