@page "/game/{GameId}"
@using Microsoft.AspNetCore.SignalR.Client
@using Catan3.Shared.Models
@using Catan3.Shared.Utility
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering
@inject GameServiceConfig Config
@inject GameCommandProxy CommandProxy
@inject HttpClient Http
@inject GameStateService GameStateService
@implements IAsyncDisposable

<PageTitle>Catan Game</PageTitle>

<div class="game-layout">
    @if (IsConnecting)
    {
        <div class="loading-overlay">
            <h2>Connecting to game...</h2>
            <p>Game ID: @GameId</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-overlay">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
            <button class="btn btn-primary" @onclick="RetryConnection">Retry</button>
        </div>
    }
    else if (GameModel != null)
    {
        <!-- LEFT PANEL -->
        <div class="left-panel">
            <!-- Game Controls (Undo/Next/Redo) -->
            <div class="panel-section game-controls" style="@GetCurrentPlayerGradient()">
                <div class="panel-label" style="color: @GetCurrentPlayerForeground()">Game Controls</div>
                <div class="panel-content">
                    <div class="control-buttons">
                        <button class="game-btn" disabled="@(!GameModel.ActionFlags.UndoEnabled)">
                            <span class="btn-icon">↶</span>
                            <span class="btn-label">Undo</span>
                        </button>
                        <button class="game-btn" @onclick="OnNextClick" disabled="@(!GameModel.ActionFlags.NextEnabled)">
                            <span class="btn-icon">▶</span>
                            <span class="btn-label">Next</span>
                        </button>
                        <button class="game-btn" disabled="@(!GameModel.ActionFlags.RedoEnabled)">
                            <span class="btn-icon">↷</span>
                            <span class="btn-label">Redo</span>
                        </button>
                    </div>
                    <div class="state-message" style="color: @GetCurrentPlayerForeground()">@GetStateMessage()</div>
                </div>
            </div>

            <!-- Purchase Controls -->
            <div class="panel-section purchase-controls" style="@GetCurrentPlayerGradient()">
                <div class="panel-label" style="color: @GetCurrentPlayerForeground()">Purchase Controls</div>
                <div class="panel-content">
                    <div class="purchase-grid">
                        <div class="purchase-card">Road</div>
                        <div class="purchase-card">Settlement</div>
                        <div class="purchase-card">City</div>
                        <div class="purchase-card">Dev Card</div>
                    </div>
                </div>
            </div>

            <!-- Roll Entry -->
            <div class="panel-section roll-entry" style="@GetCurrentPlayerGradient()">
                <div class="panel-label" style="color: @GetCurrentPlayerForeground()">Roll Entry (2-12)</div>
                <div class="panel-content">
                    <div class="roll-grid">
                        @for (int i = 2; i <= 12; i++)
                        {
                            var roll = i;
                            <div class="roll-button @(roll == 6 || roll == 8 ? "high-prob" : "")">
                                <span class="roll-number">@roll</span>
                                <span class="roll-pips">@GetPips(roll)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Board Measurements (only during PickingBoard) -->
            @if (GameModel.GameState == GameState.PickingBoard)
            {
                <div class="panel-section board-measurements" style="@GetCurrentPlayerGradient()">
                    <div class="panel-label" style="color: @GetCurrentPlayerForeground()">Board Measurements</div>
                    <div class="panel-content">
                        <button class="btn btn-sm" @onclick="OnShuffleClick">Shuffle</button>
                        <div class="star-counts" style="color: @GetCurrentPlayerForeground()">Star balance info here</div>
                    </div>
                </div>
            }
        </div>

        <!-- CENTER PANEL - Game Board -->
        <div class="center-panel">
            <div class="panel-section game-board">
                <div class="board-container">
                    @((MarkupString)GenerateBoardSvg())
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">
            <!-- Tracked Resources -->
            <div class="panel-section tracked-resources">
                <div class="panel-label">Tracked Resources</div>
                <div class="panel-content">
                    <div class="resource-cards">
                        <div class="resource-card">🌾</div>
                        <div class="resource-card">🪵</div>
                        <div class="resource-card">🪨</div>
                        <div class="resource-card">🧱</div>
                        <div class="resource-card">🐑</div>
                    </div>
                </div>
            </div>

            <!-- Player List -->
            <div class="panel-section player-list">
                <div class="panel-label">Player List & Stats</div>
                <div class="panel-content">
                    @foreach (var player in GameModel.Players)
                    {
                        <div class="player-row @(player.Id == GameModel.CurrentPlayerId ? "current-player" : "") @(player.Id == TestOverridePlayerId ? "test-selected" : "")"
                             @onclick="() => OnPlayerClick(player.Id)"
                             style="cursor: pointer;">
                            <div class="player-avatar">👤</div>
                            <div class="player-info">
                                <span class="player-name">@player.Name</span>
                                <span class="player-score">Score: @player.Score</span>
                            </div>
                            @if (player.Id == GameModel.CurrentPlayerId)
                            {
                                <span class="current-indicator">◀</span>
                            }
                            @if (player.Id == TestOverridePlayerId)
                            {
                                <span class="test-indicator">🎨</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Debug Panel -->
            <div class="panel-section debug-panel">
                <details>
                    <summary style="cursor: pointer;">Debug Info</summary>
                    <pre style="font-size: 10px; margin: 5px 0;">@GetDebugInfo()</pre>
                </details>
            </div>
        </div>
    }
    else
    {
        <div class="loading-overlay">
            <h2>Waiting for game data...</h2>
            <p>Connection State: @(_hubConnection?.State.ToString() ?? "Not created")</p>
        </div>
    }
</div>

<style>
    .game-layout {
        display: grid;
        grid-template-columns: 280px 1fr 280px;
        gap: 10px;
        height: 100vh;
        padding: 10px;
        background: var(--game-bg-primary);
        box-sizing: border-box;
    }

    .left-panel, .right-panel {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        background: #000;
    }

    .center-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0; /* Allow flex item to shrink below content size */
        background: #000;
    }

    .panel-section {
        border-radius: 8px;
        padding: 10px;
        display: flex;
        flex-direction: column;
    }

    .panel-label {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        margin-bottom: 8px;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    .panel-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    /* Game Controls */
    .game-controls {
        min-height: 120px;
    }

    .control-buttons {
        display: flex;
        gap: 5px;
        margin-bottom: 10px;
    }

    .game-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 12px;
        border: none;
        border-radius: 4px;
        background: var(--overlay-dark);
        color: var(--text-primary);
        cursor: pointer;
    }

    .game-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-icon {
        font-size: 20px;
    }

    .btn-label {
        font-size: 10px;
    }

    .state-message {
        font-size: 11px;
        text-align: center;
    }

    /* Purchase Controls */
    .purchase-controls {
        min-height: 140px;
    }

    .purchase-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
    }

    .purchase-card {
        background: var(--overlay-dark);
        color: var(--text-primary);
        padding: 15px 10px;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
    }

    /* Roll Entry */
    .roll-entry {
        min-height: 200px;
    }

    .roll-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }

    .roll-button {
        background: var(--overlay-darker);
        color: var(--text-primary);
        padding: 8px;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .roll-button.high-prob {
        color: var(--accent-error);
    }

    .roll-number {
        font-size: 16px;
        font-weight: bold;
    }

    .roll-pips {
        font-size: 10px;
    }

    /* Board Measurements */
    .board-measurements {
        min-height: 100px;
    }

    /* Game Board */
    .game-board {
        flex: 1;
        min-height: 0; /* Allow flex item to shrink */
        overflow: hidden;
    }

    .board-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Tracked Resources */
    .tracked-resources {
        min-height: 100px;
    }

    .resource-cards {
        display: flex;
        gap: 5px;
    }

    .resource-card {
        background: var(--overlay-dark);
        padding: 10px;
        border-radius: 4px;
        font-size: 20px;
    }

    /* Player List */
    .player-list {
        flex: 1;
        min-height: 200px;
    }

    .player-list .panel-content {
        justify-content: flex-start;
        align-items: stretch;
    }

    .player-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        background: var(--overlay-dark);
        border-radius: 4px;
        margin-bottom: 5px;
        color: var(--text-primary);
    }

    .player-row.current-player {
        background: var(--overlay-lighter);
        border: 1px solid var(--text-primary);
    }

    .player-avatar {
        font-size: 24px;
    }

    .player-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .player-name {
        font-weight: bold;
        font-size: 12px;
    }

    .player-score {
        font-size: 10px;
        opacity: 0.8;
    }

    .current-indicator {
        font-size: 12px;
    }

    .player-row.test-selected {
        border: 2px solid var(--accent-success);
        background: rgba(76, 175, 80, 0.3);
    }

    .test-indicator {
        font-size: 12px;
    }

    .player-row:hover {
        background: var(--overlay-lighter);
    }

    /* Panel-specific backgrounds */
    .game-board {
        background: #000 !important;
    }

    .debug-panel {
        background: var(--game-bg-secondary) !important;
    }

    .debug-panel summary {
        color: var(--text-primary);
    }

    .debug-panel pre {
        color: var(--text-muted);
    }

    /* Loading/Error overlays */
    .loading-overlay, .error-overlay {
        grid-column: 1 / -1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .error-overlay {
        color: #ff6b6b;
    }
</style>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    private HubConnection? _hubConnection;
    private GameModel? GameModel { get; set; }
    private Dictionary<string, PlayerProfile> PlayerProfiles { get; set; } = new();
    private string? TestOverridePlayerId { get; set; } // For testing: click player to see their colors
    private bool IsConnecting { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string? CommandError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ConnectToGameAsync();
    }

    private async Task EnsurePlayerProfilesLoadedAsync()
    {
        // Check if we need to load profiles for current game players
        if (GameModel == null) return;

        var missingProfiles = GameModel.Players
            .Where(p => !PlayerProfiles.ContainsKey(p.Id))
            .Select(p => p.Id)
            .ToList();

        if (missingProfiles.Count == 0) return;

        try
        {
            var response = await Http.GetFromJsonAsync<PlayersResponse>($"{Config.BaseUrl}/api/players");
            if (response?.Players != null)
            {
                foreach (var player in response.Players)
                {
                    PlayerProfiles[player.Id] = player;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load player profiles: {ex.Message}");
        }
    }

    private string GetCurrentPlayerGradient()
    {
        if (GameModel == null) return "background: #666;";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return $"background: linear-gradient(135deg, {player.PrimaryBackgroundColor}, {player.SecondaryBackgroundColor});";
        }

        return "background: #666;";
    }

    private string GetCurrentPlayerForeground()
    {
        if (GameModel == null) return "#FFFFFF";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return player.ForegroundColor;
        }

        return "#FFFFFF";
    }

    private void OnPlayerClick(string playerId)
    {
        // Toggle: if clicking same player, clear override; otherwise set it
        TestOverridePlayerId = (TestOverridePlayerId == playerId) ? null : playerId;
        StateHasChanged();
    }

    private class PlayersResponse
    {
        public List<PlayerProfile> Players { get; set; } = new();
    }

    private async Task ConnectToGameAsync()
    {
        try
        {
            IsConnecting = true;
            ErrorMessage = null;

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Config.HubUrl)
                .WithAutomaticReconnect()
                .AddJsonProtocol(options =>
                {
                    JsonHelper.ConfigureOptions(options.PayloadSerializerOptions);
                })
                .Build();

            _hubConnection.On<GameModel>("GameStateUpdated", OnGameStateUpdated);

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinGame", GameId, "WebUI-Client");

            IsConnecting = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to connect: {ex.Message}";
            IsConnecting = false;
        }
    }

    private void OnGameStateUpdated(GameModel gameModel)
    {
        GameModel = gameModel;
        GameStateService.UpdateGameModel(gameModel);

        InvokeAsync(async () =>
        {
            await EnsurePlayerProfilesLoadedAsync();
            GameStateService.UpdatePlayerData(PlayerProfiles);
            StateHasChanged();
        });
    }

    private string GenerateBoardSvg()
    {
        if (GameModel == null)
            return "<svg><text x='50' y='50'>Waiting for game data...</text></svg>";

        try
        {
            return GameModel.GenerateSvg(
                GameStateService.Players,
                shownStars: 0,
                dimmedTiles: null
            );
        }
        catch (Exception ex)
        {
            return $"<svg><text x='50' y='50'>Error generating board: {ex.Message}</text></svg>";
        }
    }

    private async Task RetryConnection()
    {
        await ConnectToGameAsync();
    }

    private async Task OnNextClick()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && GameModel != null)
        {
            try
            {
                await _hubConnection.InvokeAsync("Next", GameId, GameModel.CurrentPlayerId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending Next: {ex}");
            }
        }
    }

    private async Task OnShuffleClick()
    {
        if (GameModel != null)
        {
            try
            {
                CommandError = null;
                var result = await CommandProxy.ShuffleAsync(GameId, GameModel.CurrentPlayerId);
                if (!result.Success)
                {
                    CommandError = result.Error;
                }
            }
            catch (Exception ex)
            {
                CommandError = ex.Message;
            }
        }
    }

    private string GetStateMessage()
    {
        return GameModel?.GameState switch
        {
            GameState.WaitingForNewGame => "New Game",
            GameState.PickingBoard => "Accept Board",
            GameState.AllocateResourceForward => "Place Settlement",
            GameState.AllocateResourceReverse => "Place Settlement",
            GameState.WaitingForRoll => "Roll Dice",
            GameState.Supplemental => "Supplemental Phase",
            _ => GameModel?.GameState.ToString() ?? "Unknown"
        };
    }

    private string GetPips(int roll)
    {
        return roll switch
        {
            2 or 12 => "•",
            3 or 11 => "••",
            4 or 10 => "•••",
            5 or 9 => "••••",
            6 or 8 => "•••••",
            7 => "",
            _ => ""
        };
    }

    private string GetDebugInfo()
    {
        if (GameModel == null) return "No game data";

        var profileIds = string.Join(", ", PlayerProfiles.Keys);
        var gamePlayerIds = string.Join(", ", GameModel.Players.Select(p => p.Id));
        var currentId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;
        var hasProfile = PlayerProfiles.ContainsKey(currentId);

        return $"State: {GameModel.GameState}\n" +
               $"Game Players: {gamePlayerIds}\n" +
               $"Profiles Loaded: {PlayerProfiles.Count} [{profileIds}]\n" +
               $"Current/Override: {currentId}\n" +
               $"Has Profile: {hasProfile}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
