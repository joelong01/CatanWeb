@page "/game/{GameId}"
@using Microsoft.AspNetCore.SignalR.Client
@using Catan3.Shared.Models
@using Catan3.Shared.Extensions
@using Catan3.Shared.Utility
@using Catan3.Shared.Profiles
@using Catan3.WebUI.Models
@using Catan3.WebUI.Services
@using Catan3.WebUI.Services.Rendering
@using Catan3.WebUI.Components.Board
@using Microsoft.JSInterop
@using Catan3.WebUI.Components.Resources
@using Catan3.WebUI.Components.Players
@using Catan3.WebUI.Components.Shared
@inject GameServiceConfig Config
@inject GameConnectionService Connection
@inject HttpClient Http
@inject GameStateService GameStateService
@inject IAssetService AssetService
@inject IJSRuntime JSRuntime
@inject ClientHouseRulesService ClientHouseRules
@implements IAsyncDisposable

<PageTitle>Catan Game</PageTitle>

<div class="game-viewport">
<div class="game-container" data-layout-mode="@(_isPortrait ? "portrait" : "landscape")" data-game-active="@(IsGameActive ? "true" : "false")" data-allocation-phase="@(GameModel?.AllocationPhase() == true ? "true" : "false")">
    <!-- Portrait mode tab bar (hidden in landscape) -->
    <div class="portrait-tabs">
        <button class="portrait-tab @(_portraitTab == "board" ? "active" : "")" @onclick='() => SetPortraitTab("board")'>Board</button>
        <button class="portrait-tab @(_portraitTab == "controls" ? "active" : "")" @onclick='() => SetPortraitTab("controls")'>Controls</button>
        <button class="portrait-tab @(_portraitTab == "players" ? "active" : "")" @onclick='() => SetPortraitTab("players")'>Players</button>
    </div>

    <div class="game-grid">
    @if (IsConnecting)
    {
        <div class="loading-overlay">
            <h2>Connecting to game...</h2>
            <p>Game ID: @GameId</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-overlay">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
            <button class="btn btn-primary" @onclick="RetryConnection">Retry</button>
        </div>
    }
    else if (GameModel != null)
    {
        <!-- LEFT PANEL (Controls in portrait mode) -->
        <div class="panel-viewbox left-viewbox left-panel @GetPanelClass("controls")">
            <div class="left-panel-content">
            <!-- Editable Game Name -->
            <div class="game-name-container">
                @if (_isEditingName)
                {
                    <input type="text"
                           class="game-name-input"
                           @bind="_editingName"
                           @onblur="OnGameNameBlur"
                           @onkeydown="OnGameNameKeyDown"
                           @ref="_nameInputRef" />
                }
                else
                {
                    <div class="game-name" @ondblclick="StartEditingName">@GameModel.GameName</div>
                }
            </div>

            <!-- Game Controls (Undo/Next/Redo) -->
            <div class="game-controls" style="@GetCurrentPlayerGradient()">
                <div class="control-buttons">
                    <button class="game-btn" @onclick="OnUndoClick" disabled="@(!GameModel.ActionFlags.UndoEnabled)">
                        <span class="btn-icon">&#x21A9;</span>
                        <span class="btn-label">Undo</span>
                    </button>
                    <button class="game-btn" @onclick="OnNextClick" disabled="@(!GameModel.ActionFlags.NextEnabled)">
                        <span class="btn-icon">&#x25B6;</span>
                        <span class="btn-label">Next</span>
                    </button>
                    <button class="game-btn" @onclick="OnRedoClick" disabled="@(!GameModel.ActionFlags.RedoEnabled)">
                        <span class="btn-icon">&#x21AA;</span>
                        <span class="btn-label">Redo</span>
                    </button>
                </div>
                <div class="state-message" style="color: @GetCurrentPlayerForeground()">@GetStateMessage()</div>
                @if (!string.IsNullOrEmpty(CommandError))
                {
                    <div class="command-error">@CommandError</div>
                }
            </div>

            <!-- Purchase Controls -->
            <div class="purchase-controls">
                <div class="purchase-grid">
                    <PurchaseButton Entitlement="Entitlement.Road"
                                    SpentCount="@GetSpentCount(Entitlement.Road)"
                                    MaxCount="@(GameModel?.ResourceRules?.MaxRoads ?? 15)"
                                    UnspentCount="@GetUnspentCount(Entitlement.Road)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.Road)"
                                    CanPurchase="@CanPurchase(Entitlement.Road)"
                                    OnPurchase="@OnPurchaseClick"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.Road))" />
                    <PurchaseButton Entitlement="Entitlement.Settlement"
                                    SpentCount="@GetSpentCount(Entitlement.Settlement)"
                                    MaxCount="@(GameModel?.ResourceRules?.MaxSettlements ?? 5)"
                                    UnspentCount="@GetUnspentCount(Entitlement.Settlement)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.Settlement)"
                                    CanPurchase="@CanPurchase(Entitlement.Settlement)"
                                    OnPurchase="@OnPurchaseClick"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.Settlement))" />
                    <PurchaseButton Entitlement="Entitlement.City"
                                    SpentCount="@GetSpentCount(Entitlement.City)"
                                    MaxCount="@(GameModel?.ResourceRules?.MaxCities ?? 4)"
                                    UnspentCount="@GetUnspentCount(Entitlement.City)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.City)"
                                    CanPurchase="@CanPurchase(Entitlement.City)"
                                    OnPurchase="@OnPurchaseClick"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.City))" />
                    <PurchaseButton Entitlement="Entitlement.Soldier"
                                    SpentCount="@GetSpentCount(Entitlement.Soldier)"
                                    MaxCount="0"
                                    UnspentCount="@GetUnspentCount(Entitlement.Soldier)"
                                    Colors="@GetCurrentPlayerColors()"
                                    IsFaceUp="@GetIsFaceUp(Entitlement.Soldier)"
                                    CanPurchase="@CanPurchase(Entitlement.Soldier)"
                                    OnPurchase="@OnPurchaseClick"
                                    OnRightClick="@(() => ToggleFaceUp(Entitlement.Soldier))" />
                </div>
            </div>

            <!-- Roll Entry (hidden during allocation phase - no dice rolling then) -->
            @if (GameModel?.AllocationPhase() != true)
            {
                <div class="roll-entry" style="@GetCurrentPlayerGradient()">
                    <div class="roll-grid">
                        @for (int i = 2; i <= 12; i++)
                        {
                            var roll = i;
                            <div class="roll-cell" @onclick="() => OnRollClick(roll)">
                                <div class="roll-count">@GetRollCount(roll)</div>
                                <div class="roll-catan-number">
                                    @((MarkupString)RenderCatanNumberSvg(roll))
                                </div>
                                <div class="roll-percentage">@GetRollPercentage(roll)</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Board Measurements (visible during entire allocation phase) -->
            @if (GameModel?.AllocationPhase() == true)
            {
                <div class="board-measurements" style="@GetCurrentPlayerGradient()">
                    <BoardMeasurement GameModel="@GameModel"
                                      OnShuffle="OnShuffleClick"
                                      CanShuffle="@(GameModel?.GameState == GameState.PickingBoard)"
                                      ShownStars="@ShownStars"
                                      ShownStarsChanged="HandleShownStarsChanged"
                                      SelectedResourcesChanged="HandleSelectedResourcesChanged" />
                </div>
            }

            </div>
        </div>

        <!-- CENTER PANEL - Game Board -->
        <div class="panel-viewbox center-viewbox center-panel @GetPanelClass("board")">
            <!-- Resource Tracking - shown here in portrait mode only -->
            <div class="portrait-resource-tracking">
                <ResourceTracking GameModel="@GameModel" />
            </div>

            <!-- Portrait Game-Active: Board area with overlay buttons -->
            <div class="portrait-board-area">
                <!-- Next button overlay (top-left) -->
                <button class="portrait-overlay-btn portrait-next-btn"
                        @onclick="OnNextClick"
                        disabled="@(!GameModel?.ActionFlags.NextEnabled ?? true)"
                        style="@GetCurrentPlayerGradient()">
                    <span class="btn-icon">&#x25B6;</span>
                </button>

                <!-- State message overlay (below Next button) -->
                <div class="portrait-state-message" style="@GetCurrentPlayerGradient(); color: @GetCurrentPlayerForeground()">
                    @GetStateMessage()
                </div>

                <!-- Undo button overlay (top-right) -->
                <button class="portrait-overlay-btn portrait-undo-btn"
                        @onclick="OnUndoClick"
                        disabled="@(!GameModel?.ActionFlags.UndoEnabled ?? true)"
                        style="@GetCurrentPlayerGradient()">
                    <span class="btn-icon">&#x21A9;</span>
                </button>

                <div class="panel-section game-board">
                    <div class="board-container"
                         @oncontextmenu="OnBoardRightClick"
                         @oncontextmenu:preventDefault="true">
                        <BoardContainer GameModel="@GameModel"
                                        Players="@GameStateService.Players"
                                        AssetService="@AssetService"
                                        ShownStars="@ShownStars"
                                        FilteredResources="@FilteredResources"
                                        RolledNumber="@GetRolledNumber()"
                                        OnBuildingClick="@OnBuildingSpotClick"
                                        OnRoadClick="@OnRoadSpotClick"
                                        OnTileClick="@OnTileClickForRobber"
                                        FlippedTiles="@GriefDodgyFlippedTiles"
                                        ClientHouseRules="@ClientHouseRules.HouseRules" />
                    </div>
                </div>
            </div>

            <!-- Portrait Game-Active: Bottom controls -->
            @if (GameModel?.AllocationPhase() == true)
            {
                <!-- Board Measurements (during allocation phase: PickingBoard through setup) -->
                <div class="portrait-bottom-controls">
                    <div class="portrait-board-measurements" style="@GetCurrentPlayerGradient()">
                        <BoardMeasurement GameModel="@GameModel"
                                          OnShuffle="OnShuffleClick"
                                          CanShuffle="@(GameModel?.GameState == GameState.PickingBoard)"
                                          ShownStars="@ShownStars"
                                          ShownStarsChanged="HandleShownStarsChanged"
                                          SelectedResourcesChanged="HandleSelectedResourcesChanged" />
                    </div>
                </div>
            }
            else
            {
                <!-- Rolls and Purchase (after board picking) -->
                <div class="portrait-bottom-controls">
                    <!-- Roll Grid (left side) -->
                    <div class="portrait-rolls" style="@GetCurrentPlayerGradient()">
                        <div class="roll-grid">
                            @for (int i = 2; i <= 12; i++)
                            {
                                var roll = i;
                                <div class="roll-cell" @onclick="() => OnRollClick(roll)">
                                    <div class="roll-count">@GetRollCount(roll)</div>
                                    <div class="roll-catan-number">
                                        @((MarkupString)RenderCatanNumberSvg(roll))
                                    </div>
                                    <div class="roll-percentage">@GetRollPercentage(roll)</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Purchase Pane (right side) -->
                    <div class="portrait-purchase">
                        <div class="purchase-grid">
                            <PurchaseButton Entitlement="Entitlement.Road"
                                            SpentCount="@GetSpentCount(Entitlement.Road)"
                                            MaxCount="@(GameModel?.ResourceRules?.MaxRoads ?? 15)"
                                            UnspentCount="@GetUnspentCount(Entitlement.Road)"
                                            Colors="@GetCurrentPlayerColors()"
                                            IsFaceUp="@GetIsFaceUp(Entitlement.Road)"
                                            CanPurchase="@CanPurchase(Entitlement.Road)"
                                            OnPurchase="@OnPurchaseClick"
                                            OnRightClick="@(() => ToggleFaceUp(Entitlement.Road))" />
                            <PurchaseButton Entitlement="Entitlement.Settlement"
                                            SpentCount="@GetSpentCount(Entitlement.Settlement)"
                                            MaxCount="@(GameModel?.ResourceRules?.MaxSettlements ?? 5)"
                                            UnspentCount="@GetUnspentCount(Entitlement.Settlement)"
                                            Colors="@GetCurrentPlayerColors()"
                                            IsFaceUp="@GetIsFaceUp(Entitlement.Settlement)"
                                            CanPurchase="@CanPurchase(Entitlement.Settlement)"
                                            OnPurchase="@OnPurchaseClick"
                                            OnRightClick="@(() => ToggleFaceUp(Entitlement.Settlement))" />
                            <PurchaseButton Entitlement="Entitlement.City"
                                            SpentCount="@GetSpentCount(Entitlement.City)"
                                            MaxCount="@(GameModel?.ResourceRules?.MaxCities ?? 4)"
                                            UnspentCount="@GetUnspentCount(Entitlement.City)"
                                            Colors="@GetCurrentPlayerColors()"
                                            IsFaceUp="@GetIsFaceUp(Entitlement.City)"
                                            CanPurchase="@CanPurchase(Entitlement.City)"
                                            OnPurchase="@OnPurchaseClick"
                                            OnRightClick="@(() => ToggleFaceUp(Entitlement.City))" />
                            <PurchaseButton Entitlement="Entitlement.Soldier"
                                            SpentCount="@GetSpentCount(Entitlement.Soldier)"
                                            MaxCount="0"
                                            UnspentCount="@GetUnspentCount(Entitlement.Soldier)"
                                            Colors="@GetCurrentPlayerColors()"
                                            IsFaceUp="@GetIsFaceUp(Entitlement.Soldier)"
                                            CanPurchase="@CanPurchase(Entitlement.Soldier)"
                                            OnPurchase="@OnPurchaseClick"
                                            OnRightClick="@(() => ToggleFaceUp(Entitlement.Soldier))" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT PANEL (Players in portrait mode) -->
        <div class="panel-viewbox right-viewbox right-panel @GetPanelClass("players")">
            <!-- Resource Tracking - shown here in landscape mode only -->
            <div class="landscape-resource-tracking">
                <ResourceTracking GameModel="@GameModel" />
            </div>

            <!-- Players Panel (Player Cards Stack) -->
            <PlayersPanel GameModel="@GameModel"
                          PlayerColorMap="@PlayerColorMap"
                          PlayerProfiles="@PlayerProfiles"
                          IsPortrait="@_isPortrait"
                          OnGoFirst="@OnGoFirstClick"
                          OnSupplementalChanged="@OnSupplementalChanged"
                          OnPickingSupplementalDone="@OnPickingSupplementalDone" />
        </div>
    }
    else
    {
        <div class="loading-overlay">
            <h2>Waiting for game data...</h2>
            <p>Connection State: @Connection.State</p>
        </div>
    }
    </div>
</div>

@* Robber target selection menu - outside game-container to avoid transform issues *@
@if (_robberMenuVisible && _robberMenuTile != null)
{
    <div class="robber-menu-backdrop" @onclick="CloseRobberMenu"></div>
    <div class="robber-menu" style="left: @(_robberMenuX)px; top: @(_robberMenuY)px;">
        <div class="robber-menu-header">Move Robber to Tile @GetTileIndex(_robberMenuTile)</div>
        @foreach (var target in _robberMenuTargets)
        {
            <div class="robber-menu-item" @onclick="() => SelectRobberTarget(target.Id)">
                Target @target.Name
            </div>
        }
        @if (_robberMenuTargets.Count > 0)
        {
            <div class="robber-menu-separator"></div>
        }
        <div class="robber-menu-item robber-menu-nobody" @onclick="() => SelectRobberTarget(null)">
            Nobody. Hatred Deferred.
        </div>
        <div class="robber-menu-separator"></div>
        <div class="robber-menu-item robber-menu-cancel" @onclick="CloseRobberMenu">
            Cancel
        </div>
    </div>
}

@* Grief Dodgy celebration animation - shows when Dodgy is targeted *@
@if (_showGriefCelebration)
{
    <div class="grief-celebration">
        @* Multiple burst points spread across the screen *@
        @{
            // Create 9 burst points in a 3x3 grid
            var burstPoints = new[] {
                (15, 20), (50, 15), (85, 20),
                (20, 50), (50, 50), (80, 50),
                (15, 80), (50, 85), (85, 80)
            };
            var particleIndex = 0;
        }
        @foreach (var (bx, by) in burstPoints)
        {
            @for (int i = 0; i < 12; i++)
            {
                var angle = i * 30 + particleIndex * 7; // Offset angles for variety
                var distance = 80 + (i % 3) * 40; // Vary distances
                var dx = Math.Cos(angle * Math.PI / 180) * distance;
                var dy = Math.Sin(angle * Math.PI / 180) * distance;
                var delay = (particleIndex % 8) * 0.08; // Stagger start times
                <div class="grief-particle"
                     style="left: @bx%; top: @by%; --dx: @(dx.ToString("F0"))px; --dy: @(dy.ToString("F0"))px; animation-delay: @(delay.ToString("F2"))s;">
                </div>
                particleIndex++;
            }
        }
    </div>
}
</div>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    private GameModel? GameModel { get; set; }
    private Dictionary<string, PlayerProfile> PlayerProfiles { get; set; } = new();

    /// <summary>
    /// Dictionary mapping player IDs to their PlayerColors for gradient display.
    /// Populated during OnInitializedAsync when loading player profiles.
    /// </summary>
    private Dictionary<string, PlayerColors> PlayerColorMap { get; set; } = new();

    private string? TestOverridePlayerId { get; set; } // For testing: click player to see their colors
    private bool IsConnecting { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string? CommandError { get; set; }
    private int ShownStars { get; set; } = 13;  // Default to 13 to show only premium building sites (matches Desktop)
    private HashSet<ResourceType> FilteredResources { get; set; } = new();  // Resources selected for filtering buildings (max 3)

    // Roll dimming: track last roll and timer (duration set in BoardSvgConstants.TileDimDurationSeconds)
    private int? _lastKnownRoll;
    private CancellationTokenSource? _rollDimCts;

    // Purchase button test override state (null = use game state, true = force face up, false = force face down)
    // Right-click toggles the override to flip the card for testing
    private Dictionary<Entitlement, bool?> _purchaseTestOverride = new()
    {
        { Entitlement.Road, null },
        { Entitlement.Settlement, null },
        { Entitlement.City, null },
        { Entitlement.Soldier, null }
    };

    // Robber placement menu state
    private bool _robberMenuVisible;
    private TileModel? _robberMenuTile;
    private double _robberMenuX;
    private double _robberMenuY;
    private List<RobberTarget> _robberMenuTargets = [];
    private record RobberTarget(string Name, string Id);

    // Grief Dodgy animation state
    private bool _showGriefCelebration;
    private HashSet<HexCoordinates>? _cachedFlippedTiles; // Cached tiles for animation duration
    private CancellationTokenSource? _flipAnimationCts; // Timer to clear cached tiles after animation
    private const int FlipAnimationDurationMs = 6000; // CSS animation duration
    private bool _flipAnimationCompleted; // Tracks if flip animation already ran for this MustMoveRobber entry

    // Game name editing state
    private bool _isEditingName;
    private string _editingName = string.Empty;
    private string _originalName = string.Empty;
    private ElementReference _nameInputRef;

    // Portrait mode tab state
    private string _portraitTab = "board"; // Default tab: "board", "controls", "players"
    private bool _isPortrait = false; // Layout mode from viewport scaler
    private DotNetObjectReference<Game>? _dotNetRef; // For JS callbacks
    private bool _disposed = false; // Guard against callbacks after dispose

    /// <summary>
    /// True when we should show the portrait game-active layout (PickingBoard onwards).
    /// </summary>
    private bool IsGameActive => GameModel?.GameState >= GameState.PickingBoard;

    /// <summary>
    /// Sets the active portrait mode tab and persists to session storage.
    /// </summary>
    private async Task SetPortraitTab(string tab)
    {
        _portraitTab = tab;
        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "portraitTab", tab);
        StateHasChanged();
    }

    /// <summary>
    /// Gets the CSS class for a panel based on portrait mode tab state.
    /// In landscape mode, returns empty (all panels visible).
    /// In portrait mode, returns "portrait-active" for the selected tab's panel.
    /// </summary>
    private string GetPanelClass(string panelName)
    {
        // This is handled by CSS based on data-layout-mode attribute
        // The portrait-active class is added when the panel matches the current tab
        return _portraitTab == panelName ? "portrait-active" : "";
    }

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to theme changes to re-render the board
        AssetService.ThemeChanged += OnThemeChanged;

        // Store current game ID so Settings page can update this game's house rules
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "current_gameId", GameId);

        await ConnectToGameAsync();

        // Store game type after connecting (GameModel is now available)
        if (GameModel != null)
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "current_gameType", GameModel.GameType.ToString());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize viewport scaler for uniform scaling with callback for orientation changes
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("viewportScaler.initialize", null, null, _dotNetRef);

            // Get initial layout mode
            await UpdateLayoutModeAsync();

            // Load saved portrait tab from session storage
            var savedTab = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "portraitTab");
            if (!string.IsNullOrEmpty(savedTab) && savedTab != _portraitTab)
            {
                _portraitTab = savedTab;
                StateHasChanged();
            }

            // Initialize client-side house rules (loads from localStorage)
            await ClientHouseRules.InitializeAsync();
        }
    }

    /// <summary>
    /// Updates the _isPortrait flag from JavaScript viewport scaler.
    /// </summary>
    private async Task UpdateLayoutModeAsync()
    {
        try
        {
            var layoutInfo = await JSRuntime.InvokeAsync<LayoutInfo?>("viewportScaler.getLayoutInfo");
            if (layoutInfo != null && layoutInfo.IsPortrait != _isPortrait)
            {
                _isPortrait = layoutInfo.IsPortrait;
                StateHasChanged();
            }
        }
        catch
        {
            // Ignore errors if viewportScaler not ready
        }
    }

    /// <summary>
    /// Called from JavaScript when orientation changes (landscape/portrait).
    /// </summary>
    [JSInvokable]
    public void OnOrientationChanged(bool isPortrait)
    {
        if (_disposed) return; // Guard against calls after dispose
        if (_isPortrait != isPortrait)
        {
            _isPortrait = isPortrait;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Called from JavaScript when page becomes visible (phone wake from sleep, tab switch, etc.)
    /// Re-syncs game state to handle cases where SignalR updates were missed while suspended.
    /// </summary>
    [JSInvokable]
    public async Task OnPageBecameVisible()
    {
        if (_disposed) return;

        Console.WriteLine($"[Game] Page became visible - checking connection state for game {GameId}");

        try
        {
            // Re-join the game to force a fresh state update from the server
            // This handles cases where:
            // 1. Phone was sleeping and missed SignalR updates
            // 2. Connection was lost and auto-reconnected but we need fresh state
            // 3. Tab was backgrounded and browser throttled WebSocket
            if (!string.IsNullOrEmpty(GameId))
            {
                await Connection.ConnectAndJoinAsync(GameId, "WebUI-Client");
                Console.WriteLine($"[Game] Re-joined game {GameId} after visibility change");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Failed to re-sync after visibility change: {ex.Message}");
        }
    }

    /// <summary>
    /// Layout info returned from JavaScript viewportScaler.getLayoutInfo()
    /// </summary>
    private class LayoutInfo
    {
        public double Scale { get; set; }
        public bool IsPortrait { get; set; }
        public int BaseWidth { get; set; }
        public int BaseHeight { get; set; }
    }

    private void OnThemeChanged(string themeName)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task EnsurePlayerProfilesLoadedAsync()
    {
        // Check if we need to load profiles for current game players
        if (GameModel == null) return;

        var missingProfiles = GameModel.Players
            .Where(p => !PlayerProfiles.ContainsKey(p.Id))
            .Select(p => p.Id)
            .ToList();

        if (missingProfiles.Count == 0) return;

        try
        {
            var response = await Http.GetFromJsonAsync<PlayersResponse>($"{Config.BaseUrl}/api/players");
            if (response?.Players != null)
            {
                foreach (var player in response.Players)
                {
                    PlayerProfiles[player.Id] = player;

                    // Populate PlayerColorMap for PlayersPanel component
                    // PlayerProfile.Colors already contains the PlayerColors record
                    PlayerColorMap[player.Id] = player.Colors;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load player profiles: {ex.Message}");
        }
    }

    /// <summary>
    /// Gets the current player from the GameModel.
    /// </summary>
    private PlayerModel? CurrentPlayer
    {
        get
        {
            if (GameModel == null) return null;
            return GameModel.Players.FirstOrDefault(p => p.Id == GameModel.CurrentPlayerId);
        }
    }

    private string GetCurrentPlayerGradient()
    {
        if (GameModel == null) return "background: #666;";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return $"background: {player.Colors.CssGradient};";
        }

        return $"background: {PlayerColors.Default.CssGradient};";
    }

    /// <summary>
    /// Gets the last rolled number (2-12) or null if no roll or timer expired.
    /// Used to dim non-matching tiles after a dice roll.
    /// </summary>
    private int? GetRolledNumber()
    {
        return _lastKnownRoll;
    }

    private string GetCurrentPlayerForeground()
    {
        if (GameModel == null) return "#FFFFFF";

        // Use test override if set, otherwise use current player
        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            return player.ForegroundColor;
        }

        return "#FFFFFF";
    }

    /// <summary>
    /// The player ID for Dodgy if present in the game.
    /// </summary>
    private const string DodgyPlayerIdConst = "Dodgy-001";

    /// <summary>
    /// Gets the Dodgy player ID if Dodgy is in the current game, null otherwise.
    /// </summary>
    private string? DodgyPlayerId
    {
        get
        {
            if (GameModel == null) return null;
            return GameModel.Players.Any(p => p.Id == DodgyPlayerIdConst) ? DodgyPlayerIdConst : null;
        }
    }

    /// <summary>
    /// Whether "Grief Dodgy" mode is currently active.
    /// True when: client-side setting enabled, Dodgy is in game, and game is in MustMoveRobber state.
    /// Uses ClientHouseRules service (localStorage) not GameModel - each client controls independently.
    /// </summary>
    private bool IsGriefDodgyActive
    {
        get
        {
            if (GameModel == null) return false;
            return ClientHouseRules.HouseRules.GriefDodgy
                && DodgyPlayerId != null
                && GameModel.GameState == GameState.MustMoveRobber;
        }
    }

    /// <summary>
    /// Gets the set of tiles that should be flipped during Grief Dodgy mode.
    /// Flips tiles where Dodgy is NOT the sole owner (no Dodgy buildings, or shared with others).
    /// Uses cached value during animation to prevent double-flip when state changes mid-animation.
    /// </summary>
    private HashSet<HexCoordinates>? GriefDodgyFlippedTiles
    {
        get
        {
            // If we have cached tiles from an ongoing animation, return those
            if (_cachedFlippedTiles != null) return _cachedFlippedTiles;

            // If animation already completed for this MustMoveRobber entry, don't restart
            if (_flipAnimationCompleted) return null;

            // Only calculate new flip tiles when entering MustMoveRobber state
            if (!IsGriefDodgyActive || GameModel == null) return null;

            var flippedTiles = new HashSet<HexCoordinates>();

            foreach (var tile in GameModel.Tiles)
            {
                // Skip sea tiles
                if (tile.ResourceTileType == ResourceType.Sea) continue;

                // Get all owners of buildings adjacent to this tile
                var adjacentOwners = GameModel.Buildings.OwnedBuildings(tile.TileKey)
                    .Select(b => b.OwnerId)
                    .Where(id => id != null)
                    .Distinct()
                    .ToList();

                // Flip if: no Dodgy buildings OR Dodgy shares with others
                bool hasDodgy = adjacentOwners.Contains(DodgyPlayerIdConst);
                bool hasOthers = adjacentOwners.Any(id => id != DodgyPlayerIdConst);

                if (!hasDodgy || (hasDodgy && hasOthers))
                {
                    flippedTiles.Add(tile.TileKey);
                }
            }

            // Cache the tiles and start the animation timer
            if (flippedTiles.Count > 0)
            {
                _cachedFlippedTiles = flippedTiles;
                _flipAnimationCompleted = true; // Mark animation as triggered for this state entry
                StartFlipAnimationTimer();
            }

            return flippedTiles;
        }
    }

    /// <summary>
    /// Starts a timer to clear cached flipped tiles after the CSS animation completes.
    /// This prevents the flip animation from being interrupted when game state changes.
    /// </summary>
    private void StartFlipAnimationTimer()
    {
        // Cancel any existing timer
        _flipAnimationCts?.Cancel();
        _flipAnimationCts?.Dispose();
        _flipAnimationCts = new CancellationTokenSource();

        var token = _flipAnimationCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(FlipAnimationDurationMs, token);
                if (!token.IsCancellationRequested && !_disposed)
                {
                    _cachedFlippedTiles = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException)
            {
                // Timer was cancelled, ignore
            }
        }, token);
    }

    private string GetCurrentPlayerFirstName()
    {
        if (GameModel == null) return "";

        var playerId = TestOverridePlayerId ?? GameModel.CurrentPlayerId;

        if (PlayerProfiles.TryGetValue(playerId, out var player))
        {
            // Get first name (first word of name)
            var name = player.Name ?? "";
            var firstSpace = name.IndexOf(' ');
            return firstSpace > 0 ? name.Substring(0, firstSpace) : name;
        }

        // Fallback to player from GameModel
        var gamePlayer = GameModel.Players.FirstOrDefault(p => p.Id == playerId);
        if (gamePlayer != null)
        {
            var name = gamePlayer.Name ?? "";
            var firstSpace = name.IndexOf(' ');
            return firstSpace > 0 ? name.Substring(0, firstSpace) : name;
        }

        return "";
    }

