    private async Task ConnectToGameAsync()
    {
        try
        {
            IsConnecting = true;
            ErrorMessage = null;

            // Subscribe to game state updates from the connection service
            Connection.GameStateUpdated += OnGameStateUpdated;

            // Connect and join the game
            await Connection.ConnectAndJoinAsync(GameId, "WebUI-Client");

            IsConnecting = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to connect: {ex.Message}";
            IsConnecting = false;
        }
    }

    private void OnGameStateUpdated(GameModel gameModel)
    {
        // Log gold tiles for debugging
        var goldTiles = gameModel.Tiles.Where(t => t.TemporarilyGold).ToList();
        var goldCoords = string.Join(", ", goldTiles.Select(t => $"({t.TileKey.Q},{t.TileKey.R})"));
        Console.WriteLine($"[GameStateUpdated] State={gameModel.GameState}, HouseRules.GoldTiles={gameModel.HouseRules.GoldTiles}, Actual gold tiles ({goldTiles.Count}): [{goldCoords}]");

        // Capture previous state before updating for tab switching logic
        var previousState = GameModel?.GameState;

        GameModel = gameModel;
        GameStateService.UpdateGameModel(gameModel);

        // Reset flip animation flag when leaving MustMoveRobber state
        // This allows the animation to play again on next MustMoveRobber entry
        if (previousState == GameState.MustMoveRobber && gameModel.GameState != GameState.MustMoveRobber)
        {
            _flipAnimationCompleted = false;
            _cachedFlippedTiles = null;
        }

        // Note: Tile dimming is triggered directly from OnRollClick, not from GameModel state

        InvokeAsync(async () =>
        {
            await EnsurePlayerProfilesLoadedAsync();
            GameStateService.UpdatePlayerData(PlayerProfiles);

            // Auto-switch tabs in portrait mode based on game state transitions
            if (_isPortrait)
            {
                // Switch to Players tab when entering states that require player interaction
                if ((gameModel.GameState == GameState.FinishedRollOrder && previousState != GameState.FinishedRollOrder) ||
                    (gameModel.GameState == GameState.PickSupplementalPlayers && previousState != GameState.PickSupplementalPlayers))
                {
                    await SetPortraitTab("players");
                }
                // Switch to Board tab when leaving FinishedRollOrder (after GoFirst selection)
                // Note: PickSupplementalPlayers doesn't auto-switch away - user clicks Done button
                else if (gameModel.GameState != GameState.FinishedRollOrder && previousState == GameState.FinishedRollOrder)
                {
                    await SetPortraitTab("board");
                }
            }

            StateHasChanged();
        });
    }
