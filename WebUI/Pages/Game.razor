    /// <summary>
    /// Handles right-click on the board for robber placement.
    /// Converts screen coordinates to hex coordinates and shows target menu.
    /// </summary>
    private async Task OnBoardRightClick(MouseEventArgs e)
    {
        // Only handle during MustMoveRobber state
        if (GameModel?.GameState != GameState.MustMoveRobber) return;

        // Use the ONE FUNCTION to get tile at click position
        var tile = await GetTileAtClientCoords(e.ClientX, e.ClientY);
        if (tile == null) return;

        // Can't place on sea
        if (tile.ResourceTileType == ResourceType.Sea) return;

        // Can't place on current robber location unless it's desert (house rule)
        if (tile.TileKey.Equals(GameModel.Robber.Coordinates) && tile.ResourceTileType != ResourceType.Desert) return;

        // Position menu at click location
        _robberMenuX = e.ClientX;
        _robberMenuY = e.ClientY;

        // Get target players (players with buildings on this tile, excluding current player)
        _robberMenuTargets = GetRobberTargetsForTile(tile);
        _robberMenuTile = tile;
        _robberMenuVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Gets players who can be targeted on the selected tile.
    /// </summary>
    private List<RobberTarget> GetRobberTargetsForTile(TileModel tile)
    {
        var targets = new List<RobberTarget>();
        if (GameModel == null) return targets;

        // Desert has no targets
        if (tile.ResourceTileType == ResourceType.Desert) return targets;

        // Get buildings on this tile
        var buildings = GameModel.Buildings.OwnedBuildings(tile.TileKey);

        // Get unique owners (excluding current player)
        var ownerIds = buildings
            .Where(b => b.OwnerId != null && b.OwnerId != GameModel.CurrentPlayerId)
            .Select(b => b.OwnerId!)
            .Distinct();

        foreach (var ownerId in ownerIds)
        {
            var player = GameStateService.Players.First(p => p.Id == ownerId);
            targets.Add(new RobberTarget(player.Name, ownerId));
        }

        return targets;
    }

    /// <summary>
    /// Gets the tile index for display in the robber menu.
    /// </summary>
    private int GetTileIndex(TileModel tile)
    {
        if (GameModel == null) return 0;
        var landTiles = GameModel.Tiles
            .Where(t => t.ResourceTileType != ResourceType.Sea)
            .ToList();
        return landTiles.IndexOf(tile) + 1;
    }

    /// <summary>
    /// Handles target selection from robber menu.
    /// </summary>
    private async Task SelectRobberTarget(string? targetPlayerId)
    {
        if (_robberMenuTile != null && Connection.State == ConnectionState.InGame)
        {
            try
            {
                CommandError = null;

                // Check if we should trigger Grief Dodgy celebration (uses client-side setting)
                var shouldCelebrate = ClientHouseRules.HouseRules.GriefDodgy
                    && targetPlayerId == DodgyPlayerIdConst;

                // Dismiss menu before animations start
                var tileKey = _robberMenuTile.TileKey;
                CloseRobberMenu();

                await Connection.MoveRobberAsync(tileKey, targetPlayerId);

                // Trigger celebration animation if targeting Dodgy
                if (shouldCelebrate)
                {
                    await TriggerGriefCelebration();
                }
            }
            catch (Exception ex)
            {
                CommandError = $"Move robber failed: {ex.Message}";
            }
        }
    }

