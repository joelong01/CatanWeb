<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.BoardMeasurementCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3" xmlns:c="using:Catan3.Controls"
        xmlns:models="using:Catan3.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="StarStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />

        </Style>
        <Style x:Key="StarCountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="GridStarCounterStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource ResourceCard.GoldMine}"/>
            <Setter Property="Height" Value="80" />
            <Setter Property="Width" Value="80" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="Margin" Value="6, 0, 0, 0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0, 0, 0, 0" HorizontalAlignment="Center">
        <StackPanel>
            <GridView ItemsSource="{x:Bind ResourceCards}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="3" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ResourceCardModel">
                        <c:ResourceCardCtrl ViewModel="{x:Bind}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel Orientation="Horizontal" >

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="13" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(13, GameModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="12" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(12, GameModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="11" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(11, GameModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="10" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(10, GameModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

            </StackPanel>
            <Button Content="Flip" Click="OnFlip" />
        </StackPanel>
    </Grid>
</UserControl>
