<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.BoardMeasurementCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3" xmlns:c="using:Catan3.Controls"
        xmlns:models="using:Catan3.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="StarStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />

        </Style>
        <Style x:Key="StarCountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="GridStarCounterStyle" TargetType="Grid">
            <Setter Property="Background"
                    Value="{StaticResource ResourceCard.GoldMine}" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Width" Value="80" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="Margin" Value="6, 0, 0, 0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0, 0, 0, 0" HorizontalAlignment="Center">
        <StackPanel>
            <GridView ItemsSource="{x:Bind ResourceCards}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="3" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ResourceCardModel">
                        <c:ResourceCardCtrl ViewModel="{x:Bind}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel Orientation="Horizontal">

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="13" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(13, GameViewModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="12" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(12, GameViewModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="11" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(11, GameViewModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

                <Grid Style="{StaticResource GridStarCounterStyle}">

                    <TextBlock Style="{StaticResource StarStyle}"
                            Foreground="Red"
                            Text="&#xE00A;&#xE00A;&#xE00A;&#xE00A;&#xE00A;" />

                    <TextBlock Text="10" Style="{StaticResource StarCountStyle}" />
                    <TextBlock
                            Text="{x:Bind BIND_StarCount(10, GameViewModel), Mode=OneWay}"
                            Style="{StaticResource StarCountStyle}"
                            FontFamily="SegoeUi" VerticalAlignment="Bottom" />
                </Grid>

            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,20"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                    <Button Content="&#xE10E;"
                            Style="{StaticResource GameControllerStyle}"
                            Background="Transparent" Foreground="White" />
                    <TextBlock Margin="10, 5, 0, 0" Text="Previous Board"
                            HorizontalAlignment="Center" Foreground="White"
                            TextLineBounds="Tight" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <Button Command="{x:Bind GameViewModel.ShuffleCommand}" Content="&#xE10D;"
                            Style="{StaticResource GameControllerStyle}"
                            Background="Transparent" Foreground="White" />
                    <TextBlock Margin="10, 5, 0, 0" Text="New Board"
                            HorizontalAlignment="Center" Foreground="White"
                            TextLineBounds="Tight" />
                </StackPanel>

            </StackPanel>
            <Slider HorizontalAlignment="Center" Width="300"
                    IsDirectionReversed="false" Minimum="0" Maximum="14"
                    Value="{x:Bind GameViewModel.ShownStars, Mode=TwoWay}"
                    Orientation="Horizontal" SmallChange="1" TickFrequency="1" />

          
        </StackPanel>
    </Grid>
</UserControl>
