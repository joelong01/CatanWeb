<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.PlayerCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Catan3.Controls" xmlns:models="using:Catan3.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid Background="{StaticResource bmMaple}" CornerRadius="5" Margin="5" IsHitTestVisible="False">
        <StackPanel>
            <StackPanel Name="SP_FirstRow" Height="45" Orientation="Horizontal" Margin="0,5, 0, 0"
                    HorizontalAlignment="Stretch" Background="Transparent">
                <Viewbox Stretch="Uniform">
                    <Button HorizontalContentAlignment="Stretch" IsHitTestVisible="True"
                            VerticalContentAlignment="Stretch" Width="100" Margin="-10"
                            Height="100"
                            Command="{x:Bind PlayerViewModel.GoFirstCommand, Mode=OneWay}">
                        <Button.Content>
                            <Grid CornerRadius="50"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    BorderBrush="{x:Bind PlayerViewModel.PlayerColors.ForegroundBrush, Mode=OneWay}"
                                    BorderThickness="1">
                                <Grid.Background>
                                    <ImageBrush
                                            ImageSource="{x:Bind PlayerViewModel.CroppedImageUri, Mode=OneWay}" />
                                </Grid.Background>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Viewbox>
                <GridView Height="45"
                        ItemsSource="{x:Bind PlayerViewModel.PlayerStats, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlayerStatsViewModel">
                            <Viewbox Stretch="Uniform">
                                <c:PlayerStatsCtrl
                                        ViewModel="{x:Bind Mode=OneWay}" />
                            </Viewbox>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="1,0,0,0" />
                            <Setter Property="Width" Value="45" />
                            <Setter Property="Height" Value="45" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </StackPanel>
            <StackPanel Name="SP_SecondRow" HorizontalAlignment="Stretch"
                    Orientation="Horizontal" Background="Transparent">
                <c:TrackedResourcesCtrl Height="130"
                        ResourcesViewModel="{x:Bind PlayerViewModel.ResourcesThisTurn, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
