<UserControl
    x:Class="Catan3.Controls.PlayerSettingsDialogCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Catan3.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:m="using:Catan3.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
          <!-- PlayerSettings Control -->
        <local:PlayerSettingsCtrl x:Name="PlayerSettingsControl" ViewModel="{x:Bind ViewModel, Mode=OneWay}"  Grid.Row="1"/>
        <Button Content="Close" Click="CloseButton_Click" />
    </Grid>
</UserControl>
