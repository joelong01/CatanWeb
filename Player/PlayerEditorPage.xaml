<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Catan3.Player.PlayerEditorPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3.Player" xmlns:c="using:Catan3.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="using:Catan3.Models" mc:Ignorable="d"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <DataTemplate x:Key="EditPlayerDataTemplate"
                x:DataType="m:PlayerViewModel">
            <StackPanel HorizontalAlignment="Stretch"
                    Background="{x:Bind PlayerColors.BackgroundBrush, Mode=OneWay}">

                <Ellipse Name="Player_Picture" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Width="100" Height="100"
                        Stroke="{x:Bind PlayerColors.ForegroundBrush, Mode=OneWay}">
                    <Ellipse.Fill>
                        <ImageBrush
                                ImageSource="{x:Bind ImageSource, Mode=OneWay}" />
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" />

            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal"
            VerticalAlignment="Stretch">
        <Grid Name="PlayerList" HorizontalAlignment="Left"
                VerticalAlignment="Stretch" Width="110">
            <ListView Margin="0" HorizontalAlignment="Left"
                    SelectionMode="Single" VerticalAlignment="Top"
                    Background="Gray"
                    SelectedItem="{x:Bind ViewModel.SelectedPlayer, Mode=TwoWay}"
                    ItemsSource="{x:Bind ViewModel.Players, Mode=OneWay}"
                    ItemTemplate="{StaticResource EditPlayerDataTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderBrush"
                                Value="{x:Bind Foreground, Mode=OneWay}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

        </Grid>
        <StackPanel>
            <c:PlayerCtrl
                    PlayerViewModel="{x:Bind ViewModel.SelectedPlayer, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <RadioButton Content="Primary Background" IsChecked="True" />
                    <Rectangle HorizontalAlignment="Stretch" Stroke="{x:Bind ViewModel.SelectedPlayer.PlayerColors.ForegroundBrush, Mode=OneWay}" StrokeThickness="2"
                               Fill="{x:Bind ViewModel.SelectedPlayer.PlayerColors.BackgroundBrush, Mode=OneWay}"
                            VerticalAlignment="Top" Height="50" />
                    <RadioButton Content="Secondary Background"  IsChecked="True" />
                    <RadioButton Content="Foreground" />
                </StackPanel>
                <ColorPicker ColorSpectrumShape="Box"
                        IsMoreButtonVisible="False"
                        HorizontalAlignment="Stretch"
                        IsColorSliderVisible="True"
                        IsColorChannelTextInputVisible="False"
                        IsHexInputVisible="False" IsAlphaEnabled="False"
                        IsAlphaSliderVisible="False"
                        IsAlphaTextInputVisible="False" />
            </StackPanel>
        </StackPanel>
    </StackPanel>

</Page>
