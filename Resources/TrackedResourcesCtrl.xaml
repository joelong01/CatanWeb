<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.TrackedResourcesCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Catan3.Controls" xmlns:models="using:Catan3.Models"
        x:Name="CTRL_BoardMeasurement"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid Height="{Binding ElementName=CTRL_BoardMeasurement, Path=Height, Mode=OneWay}">
        <GridView
                ItemsSource="{x:Bind ResourcesViewModel.ResourceCounters, Mode=OneWay}">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ResourceCounterViewModel">
                    <Viewbox Stretch="Uniform" Height="120">
                        <c:ResourceCardCtrl ViewModel="{x:Bind Mode=OneWay}" />
                    </Viewbox>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>
