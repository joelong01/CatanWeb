<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Text.Json" #>
<#@ import namespace="System.Text" #>
<#@ assembly name="System.Memory"#>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Diagnostics" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>


<#
   Debug.WriteLine($"starting");
    string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
    var path = Path.Combine(templateDirectory, "models.json");
    var jsonText = File.ReadAllText(path);
    Debug.WriteLine(jsonText);
    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
    var models = JsonSerializer.Deserialize<List<Model>>(jsonText, options);
    Debug.WriteLine(models);
    foreach (var model in models)
    {
        string modelDirectory = Path.Combine(templateDirectory, model.Path ?? "");
        if (!Directory.Exists(modelDirectory))
        {
            Directory.CreateDirectory(modelDirectory);
        }

        string modelFile = Path.Combine(modelDirectory, model.ClassName + ".cs");
        var modelContent = GenerateClass(model);
        File.WriteAllText(modelFile, modelContent);
    }
#>

<#+
    public class Property
    {
        public string Name { get; set; }
        public string Type { get; set; }
        public bool ReadOnly { get; set; }
        public List<string> AdditionalNotifications { get; set; } = new List<string>();
    }

    public class Model
    {
        public string ClassName { get; set; }
        public string Namespace { get; set; }
        public List<Property> Properties { get; set; }
        public string Path { get; set; }
        public bool Ctor { get; set; }
    }


  string GenerateClass(Model model)
{
    var classBuilder = new StringBuilder();
    classBuilder.AppendLine("/* WARNING: this is an autogenerated file.  Do Not edit directly.  Edit the /Models/models.json file instead */");
    classBuilder.AppendLine("using System.ComponentModel;");
    classBuilder.AppendLine($"namespace {model.Namespace}");
    classBuilder.AppendLine("{");

    classBuilder.AppendLine($"    public partial class {model.ClassName} : INotifyPropertyChanged");
    classBuilder.AppendLine("    {");
    
    // Generate constructor if Ctor is true
    if (model.Ctor)
    {
        classBuilder.Append($"        public {model.ClassName}(");
        var parameters = model.Properties
            .Where(p => !p.ReadOnly)
            .Select(p => $"{p.Type} {Char.ToLowerInvariant(p.Name[0])}{p.Name.Substring(1)}")
            .ToArray();
        classBuilder.Append(string.Join(", ", parameters));
        classBuilder.AppendLine(")");
        classBuilder.AppendLine("        {");
        foreach (var property in model.Properties.Where(p => !p.ReadOnly))
        {
            var paramName = $"{Char.ToLowerInvariant(property.Name[0])}{property.Name.Substring(1)}";
            classBuilder.AppendLine($"            _{paramName} = {paramName};"); 
        }
        classBuilder.AppendLine("        }");
    }

    classBuilder.AppendLine("        public event PropertyChangedEventHandler? PropertyChanged;");
    classBuilder.AppendLine();

    // Property definitions
    foreach (var property in model.Properties)
    {
        var fieldName = $"_{Char.ToLowerInvariant(property.Name[0])}{property.Name.Substring(1)}";
        classBuilder.AppendLine($"        private {property.Type} {fieldName};"); // Field with underscore
        
        // Adjust property definition to use the fieldName with underscore
        classBuilder.AppendLine($"        public {property.Type} {property.Name}");
        classBuilder.AppendLine("        {");
        classBuilder.AppendLine($"            get => {fieldName};");
        if (!property.ReadOnly)
        {
            classBuilder.AppendLine($"            set");
            classBuilder.AppendLine("            {");
            classBuilder.AppendLine($"                if (Equals(value, {fieldName})) return;");
            classBuilder.AppendLine($"                {fieldName} = value;");
            classBuilder.AppendLine($"                OnPropertyChanged(nameof({property.Name}));");
            foreach (var additionalProperty in property.AdditionalNotifications)
            {
                classBuilder.AppendLine($"                OnPropertyChanged(nameof({additionalProperty}));");
            }
            classBuilder.AppendLine("            }");
        }
        classBuilder.AppendLine("        }");
        classBuilder.AppendLine();
    }

    classBuilder.AppendLine("        protected virtual void OnPropertyChanged(string propertyName) =>");
    classBuilder.AppendLine("            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));");
    classBuilder.AppendLine("    }");
    classBuilder.AppendLine("}");
    
    return classBuilder.ToString();
}




#>
