<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Text.Json" #>
<#@ import namespace="System.Text.Json" #>
<#@ import namespace="System.Text" #>
<#@ assembly name="System.Memory"#>
<#@ import namespace="System.IO" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.ComponentModel" #>

<#

    // Global version number
    string version = "0.7"; 
    string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
    var jsonFiles = Directory.GetFiles(templateDirectory, "*.json");
    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
    string logFilePath = Path.Combine(templateDirectory, "ModelGenerationLog.log");
    // Ensure the log file is empty at the beginning of the transformation
    File.WriteAllText(logFilePath, $"Model Generation Log - Version {version}\n");

    foreach (var jsonFilePath in jsonFiles)
    {
        try
        {
            File.AppendAllText(logFilePath, $"Parsing {jsonFilePath}\n");
            var jsonText = File.ReadAllText(jsonFilePath);
            var models = JsonSerializer.Deserialize<List<Model>>(jsonText, options);
            if (models == null) throw new InvalidOperationException("Failed to deserialize JSON into a list of models.");

          foreach (var model in models)
            {
                try
                {
                    string modelDirectory = Path.Combine(templateDirectory, model.Path ?? "");
                    if (!Directory.Exists(modelDirectory))
                    {
                        Directory.CreateDirectory(modelDirectory);
                    }

                    string modelFile = Path.Combine(modelDirectory, model.ClassName + ".tt_generated.cs");
                    var modelContent = GenerateClass(model, version, jsonFilePath);
                    File.WriteAllText(modelFile, modelContent);
                    // Pass templateDirectory as an argument
                    LogModelProcessing(logFilePath,  "CREATED", version, model.ClassName, modelFile);
                }
                catch (Exception ex)
                {
                    // Pass templateDirectory as an argument
                    LogModelProcessing(logFilePath, "FAILED", version, model.ClassName, jsonFilePath, ex.Message);
                    throw;
                }
            }

        }
        catch (Exception e)
        {
            // General exception handling for logging, not specific to a model
            File.AppendAllText(logFilePath, $"General Error: {e.Message}\n");
            throw;
        }
    }
#>
<#+
void LogModelProcessing(string logFilePath, string status, string version, string className, string filePath, string exceptionMessage = "")
{
   

    string logEntry = $"{status}, Version: {version}, ClassName: {className}, FilePath: {filePath}\n";
    if (!string.IsNullOrEmpty(exceptionMessage))
    {
        logEntry += $"Exception Message: {exceptionMessage}\n";
    }
    File.AppendAllText(logFilePath, logEntry);
}


#>
<#+
    public class Property
    {
        public string Name { get; set; }
        public string Type { get; set; }
        public bool ReadOnly { get; set; }
        public List<string> AdditionalNotifications { get; set; } = new List<string>();
        public bool Nullable {get;set;}
        public string Default {get;set;}
    }

    public class Model
    {
        public string ClassName { get; set; }
        public string Namespace { get; set; }
        public List<Property> ConstructedProperties { get; set; }
        public List<Property> NormalProperties { get; set; }
        public string Path { get; set; }
        public List<string> Usings {get;set;}
        public bool CallInit {get;set;} = false;
       
    }

string GenerateClass(Model model, string version, string jsonFilePath)
{
    var classBuilder = new StringBuilder();
    classBuilder.AppendLine($"/* WARNING: This is an autogenerated file. Do not edit directly. Edit the {jsonFilePath} file instead. Version {version} */");

    // Including using statements
    if (model.Usings != null && model.Usings.Count > 0)
    {
        foreach (var usingStatement in model.Usings)
        {
            classBuilder.AppendLine($"using {usingStatement};");
        }
        classBuilder.AppendLine(); // For readability
    }

    classBuilder.AppendLine($"namespace {model.Namespace}");
    classBuilder.AppendLine("{");
    classBuilder.AppendLine($"    public partial class {model.ClassName} : INotifyPropertyChanged");
    classBuilder.AppendLine("    {");
    classBuilder.AppendLine("        public event PropertyChangedEventHandler? PropertyChanged;");

    // Generate properties for both constructed and normal properties
    foreach (var property in model.ConstructedProperties.Concat(model.NormalProperties))
    {
        GenerateProperty(classBuilder, property);
    }

    // Generate constructor
    var constructorParams = model.ConstructedProperties.Select(p => $"{p.Type}{(p.Nullable ? "?" : "")} {p.Name.ToLower()}").ToList();
    string constructorSignature = string.Join(", ", constructorParams);

    // Check if we need to generate a constructor
    if (constructorParams.Any() || model.CallInit)
    {
        classBuilder.AppendLine();
        classBuilder.AppendLine($"        public {model.ClassName}({constructorSignature})");
        classBuilder.AppendLine("        {");
        // Iterate over constructed properties to initialize private backing fields directly
        foreach (var property in model.ConstructedProperties)
        {
            string fieldName = $"_{Char.ToLowerInvariant(property.Name[0])}{property.Name.Substring(1)}"; // Generate field name
            // Assign constructor parameters to backing fields
            classBuilder.AppendLine($"            {fieldName} = {property.Name.ToLower()};");
        }
        if (model.CallInit)
        {
            // Add Init call if specified
            classBuilder.AppendLine("            Init();");
        }
        classBuilder.AppendLine("        }");
    }

    classBuilder.AppendLine();
    classBuilder.AppendLine("        protected virtual void OnPropertyChanged(string propertyName) =>");
    classBuilder.AppendLine("            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));");
    classBuilder.AppendLine("    }"); // End of class
    classBuilder.AppendLine("}"); // End of namespace

    return classBuilder.ToString();
}

// The implementation for GenerateProperty and GetDefaultValue remains the same


void GenerateProperty(StringBuilder classBuilder, Property property)
{
    string propType = property.Type + (property.Nullable ? "?" : "");
    string fieldName = $"_{Char.ToLowerInvariant(property.Name[0])}{property.Name.Substring(1)}";
    string defaultValue = property.Default != null ? $" = {GetDefaultValue(property)};" : ";";

    classBuilder.AppendLine($"        private {propType} {fieldName}{defaultValue}");
    classBuilder.AppendLine($"        public {propType} {property.Name}");
    classBuilder.AppendLine("         {");
    classBuilder.AppendLine($"            get => {fieldName};");
    classBuilder.AppendLine("            set");
    classBuilder.AppendLine("            {");
    classBuilder.AppendLine($"                if (Equals(value, {fieldName})) return;");
    classBuilder.AppendLine($"                {fieldName} = value;");
    classBuilder.AppendLine($"                OnPropertyChanged(nameof({property.Name}));");
    foreach (var notifyProp in property.AdditionalNotifications)
    {
        classBuilder.AppendLine($"                OnPropertyChanged(nameof({notifyProp}));");
    }
    classBuilder.AppendLine("             }");
    classBuilder.AppendLine("         }");
    classBuilder.AppendLine();
}

string GetDefaultValue(Property property)
{
    return property.Default == null ? "null" : (property.Type == "string" ? $"\"{property.Default}\"" : property.Default);
}





#>
