<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Catan3.App"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3" xmlns:converters="using:Catan3.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="CatanFont">ms-appx:///Assets/Fonts/Catan.ttf#Catan</FontFamily>

            <ImageBrush x:Key="bmWater" ImageSource="Assets/water.png" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Back"
                    ImageSource="Assets/Tiles/back.jpg" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Sea"
                    ImageSource="Assets/Tiles/back.jpg" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Brick"
                    ImageSource="Assets/Tiles/brick.png" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.GoldMine"
                    ImageSource="Assets/Tiles/goldMine.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Ore"
                    ImageSource="Assets/Tiles/ore.png" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Sheep"
                    ImageSource="Assets/Tiles/sheep.png" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Wheat"
                    ImageSource="Assets/Tiles/wheat.png" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Wood"
                    ImageSource="Assets/Tiles/wood.png" Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Desert"
                    ImageSource="Assets/Tiles/desert.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="ResourceType.Invasion"
                    ImageSource="Assets/Tiles/gpt invasion.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="bmMaple" ImageSource="Assets/maple.jpg"
                    Stretch="UniformToFill" />

            <!--  ResourceType HarborType - should be one per enum value  -->
            <ImageBrush x:Key="HarborType.Brick"
                    ImageSource="Assets/Harbors/2 for 1 brick.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="HarborType.Ore"
                    ImageSource="Assets/Harbors/2 for 1 ore.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="HarborType.Sheep"
                    ImageSource="Assets/Harbors/2 for 1 sheep.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="HarborType.Wheat"
                    ImageSource="Assets/Harbors/2 for 1 wheat.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="HarborType.Wood"
                    ImageSource="Assets/Harbors/2 for 1 wood.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="HarborType.ThreeForOne"
                    ImageSource="Assets/Harbors/3 for 1.png"
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="HarborType.None" ImageSource="Assets/water.png"
                    Stretch="UniformToFill" />

            <converters:ResourceTypeToImageBrush
                    x:Key="ResourceTypeToImageBrush" />
            <converters:NumberToPipsVisibility x:Key="NumberToPipsVisibility" />
            <converters:NumberToVisibilityConverter
                    x:Key="NumberToVisibilityConverter" />
            <converters:NumberToPipsForegroundConverter
                    x:Key="NumberToPipsForegroundConverter" />
            <converters:BoolToVisibilityConverter
                    x:Key="BoolToVisibilityConverter" />
            <converters:MetroToScaleConverter x:Key="MetroToScaleConverter" />
            <converters:ScaleConverter x:Key="ScaleConverter" />
            <converters:BuildingPositionToFillConverter
                    x:Key="BuildingPositionToFillConverter" />

            <converters:NullToDefaultValueConverter
                    x:Key="NullToDefaultValueConverter" />

            <converters:DoubleToThickness x:Key="DoubleToThickness" />

            <Style TargetType="ListViewItem" x:Key="ListViewItemStyle">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
