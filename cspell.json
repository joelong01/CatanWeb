  "ignorePaths": [
    // Build and generated directories
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/wwwroot/lib/**",
    "**/.vs/**",
    "**/.vscode/**",
    "**/packages/**",
    
    // Specific generated files
    "**/*.min.js",
    "**/*.min.css",
    "**/*.deps.json",
    "**/*.runtimeconfig.json",
    "**/project.assets.json",
    "**/*.nuget.dgspec.json",
    "**/MvcTestingAppManifest.json",
    
    // Log and temporary files
    "**/*.log",
    "**/*.tmp",
    "**/*.temp",
    
    // Package manager files
    "**/package-lock.json",
    "**/yarn.lock",
    
    // IDE and editor files
    "**/.idea/**",
    "**/*.suo",
    "**/*.user",
    "**/*.sln.docstates"
  ],
  "overrides": [
    {
      "filename": "**/*.md",
      "language": "en",
      "dictionaries": ["markdown", "technical"]
    },
    {
      "filename": "**/*.cs",
      "language": "en",
      "dictionaries": ["csharp", "dotnet", "technical"]
    },
    {
      "filename": "**/*.xaml",
      "language": "en", 
      "dictionaries": ["xml", "technical"]
    },
    {
      "filename": "**/*.json",
      "language": "en",
      "dictionaries": ["json", "technical"]
    }
  ],
  "enabledLanguageIds": [
    "csharp",
    "xml",
    "xaml", 
    "json",
    "markdown",
    "plaintext",
    "typescript",
    "javascript"
  ],
  "allowCompoundWords": true,
  "caseSensitive": false
}
