<UserControl x:Class="Catan3.Controls.RoadCtrl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:c="using:Catan3.Controls"
        xmlns:models="using:Catan3.Models" d:DataContext="{d:DesignInstance Type=models:RoadViewModel}"
        mc:Ignorable="d" d:DesignHeight="12" d:DesignWidth="70.8">
    <UserControl.Resources>
        <Style x:Key="RoadLineStyle" TargetType="Line">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeEndLineCap" Value="Triangle" />
            <Setter Property="StrokeStartLineCap" Value="Triangle" />
        </Style>
    </UserControl.Resources>
    <Border BorderThickness="0" BorderBrush="Black">
        <Grid Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                PointerPressed="Grid_PointerPressed" IsHitTestVisible="True"
                RenderTransformOrigin="{Binding TransformOrigin, Mode=OneWay}">
            <Polygon Fill="{Binding Background, Mode=TwoWay}" Points="{Binding BorderPoints, Mode=OneWay}" />
            <!--<TextBlock Text="{Binding Index, Mode=OneWay}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />-->
            <Grid.RenderTransform>
                <RotateTransform Angle="{Binding Angle, Mode=OneWay}" />
            </Grid.RenderTransform>
        </Grid>
    </Border>
</UserControl>
