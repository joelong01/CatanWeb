<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.PurchaseCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Catan3.Controls" xmlns:u="using:Catan3.Utility"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" x:Name="CTRL_Purchase">

    <UserControl.Resources>
        <Storyboard x:Name="SB_AnimatePush">
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                    Storyboard.TargetProperty="ScaleX" To="0.98"
                    AutoReverse="False" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                    Storyboard.TargetProperty="ScaleY" To="0.98"
                    AutoReverse="False" Duration="0:0:0.1" />
        </Storyboard>
        <Storyboard x:Name="SB_AnimateRelease">
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                    Storyboard.TargetProperty="ScaleX" To="1"
                    AutoReverse="False" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                    Storyboard.TargetProperty="ScaleY" To="1"
                    AutoReverse="False" Duration="0:0:0.1" />
        </Storyboard>
    </UserControl.Resources>

    <u:FlipperCtrl Orientation="{x:Bind ViewModel.Orientation, Mode=OneWay}"
            Width="100" Height="100">
        <u:FlipperCtrl.RenderTransform>
            <ScaleTransform />
        </u:FlipperCtrl.RenderTransform>
        <u:FlipperCtrl.Back>
            <Grid Background="{StaticResource ResourceCard.Back}"
                    CornerRadius="10" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
        </u:FlipperCtrl.Back>
        <u:FlipperCtrl.Front>

            <Grid x:Name="GRID_Front" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerEntered="OnPointerEntered" CornerRadius="10"
                    PointerExited="OnPointerExited"
                    PointerPressed="OnPointerPressed"
                    Background="{x:Bind ViewModel.Background, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.Foreground, Mode=OneWay}">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ScaleTransform" />
                </Grid.RenderTransform>

                <TextBlock HorizontalAlignment="Left" FontSize="22"
                        Margin="5,0,0,0" VerticalAlignment="Top"
                        Text="{x:Bind ViewModel.Unspent, Mode=OneWay}"
                        Foreground="{Binding ElementName=CTRL_Purchase, Path=Foreground, Mode=OneWay}" />

                <TextBlock HorizontalAlignment="Center"
                        VerticalAlignment="Center" FontSize="44"
                        Text="{x:Bind ViewModel.Glyph, Mode=OneWay}"
                        FontFamily="{StaticResource CatanFont}"
                        Foreground="{Binding ElementName=CTRL_Purchase, Path=Foreground, Mode=OneWay}" />

                <TextBlock HorizontalAlignment="Center" FontSize="12"
                        Margin="0,0,0,10" VerticalAlignment="Bottom"
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}" />

            </Grid>

        </u:FlipperCtrl.Front>
    </u:FlipperCtrl>

</UserControl>
