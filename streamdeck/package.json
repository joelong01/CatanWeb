{
  "name": "com.catan.streamdeck",
  "version": "1.0.0",
  "description": "Stream Deck plugin for Catan game controls",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.catan.streamdeck\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.1",
    "@microsoft/signalr": "^8.0.7"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.19.13",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
