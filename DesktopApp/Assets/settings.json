      "options": ["0", "1", "2", "3", "4"],
      "value": 2,
      "defaultValue": 2,
      "validation": {
        "required": true
      }
    },
    {
      "settingName": "RegularGoldTiles",
      "description": "Number of gold tiles in regular games",
      "inputType": "dropdown",
      "options": ["0", "1", "2"],
      "value": 1,
      "defaultValue": 1,
      "validation": {
        "required": true
      }
    },
    {
      "settingName": "ExpansionForLessThanFivePlayers",
      "description": "Enable expansion mode for games with less than 5 players",
      "inputType": "checkbox",
      "value": false,
      "defaultValue": false,
      "validation": {
        "required": false
      }
    }
  ]
