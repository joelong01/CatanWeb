{
  "settings": [
    {
      "settingName": "SaveFileLocation",
      "description": "Directory to save game files",
      "inputType": "textbox",
      "value": "",
      "defaultValue": "",
      "validation": {
        "required": true,
        "directoryMustExist": true
      },
      "environmentVariable": "CATAN_DOCUMENTS_PATH"
    },
    {
      "settingName": "ExpansionGoldTiles",
      "description": "Number of gold tiles in expansion games",
