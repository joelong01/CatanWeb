<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Catan3.Settings.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Catan3.Settings"
    xmlns:models="using:Catan3.Shared.Models"
    xmlns:vm="using:Catan3.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Save"
    SecondaryButtonText="Defaults"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}"
    MaxWidth="500"
    MaxHeight="600">

    <ContentDialog.Resources>
        <!-- TextBox Setting Template -->
        <DataTemplate x:Key="TextBoxSettingTemplate" x:DataType="vm:SettingItemViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <TextBox Text="{x:Bind TextValue, Mode=TwoWay}"
                         PlaceholderText="Enter value..."
                         Width="400"
                         HorizontalAlignment="Left"
                         BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                         BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                         ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ValidationErrorMessage, Mode=OneWay}"
                           Foreground="Red"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Directory Picker Setting Template -->
        <DataTemplate x:Key="DirectoryPickerSettingTemplate" x:DataType="vm:SettingItemViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{x:Bind TextValue, Mode=TwoWay}"
                             PlaceholderText="Choose directory..."
                             Width="320"
                             BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                             BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"/>
                    <Button Content="Browse..."
                           Style="{ThemeResource DefaultButtonStyle}"
                           Click="OnBrowseDirectory"
                           Tag="{x:Bind Model}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ValidationErrorMessage, Mode=OneWay}"
                           Foreground="Red"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Dropdown Setting Template -->
        <DataTemplate x:Key="DropdownSettingTemplate" x:DataType="vm:SettingItemViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{x:Bind Options, Mode=OneWay}"
                         SelectedItem="{x:Bind TextValue, Mode=TwoWay}"
                         Width="200"
                         HorizontalAlignment="Left"
                         BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                         BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                         ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ValidationErrorMessage, Mode=OneWay}"
                           Foreground="Red"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Checkbox Setting Template -->
        <DataTemplate x:Key="CheckboxSettingTemplate" x:DataType="vm:SettingItemViewModel">
            <StackPanel Spacing="8">
                <CheckBox Content="{x:Bind Description, Mode=OneWay}"
                         IsChecked="{x:Bind BooleanValue, Mode=TwoWay}"
                         ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Setting Item Template Selector -->
        <local:SettingItemTemplateSelector x:Key="SettingItemTemplateSelector"
                TextBoxTemplate="{StaticResource TextBoxSettingTemplate}"
                DirectoryPickerTemplate="{StaticResource DirectoryPickerSettingTemplate}"
                DropdownTemplate="{StaticResource DropdownSettingTemplate}"
                CheckboxTemplate="{StaticResource CheckboxSettingTemplate}" />
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="0,10,0,0">
            <!-- Settings Description -->
            <TextBlock Text="Configure game preferences and file locations" 
                      Style="{ThemeResource CaptionTextBlockStyle}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Margin="0,0,0,10"/>

            <!-- Dynamic Settings Content -->
            <ItemsControl x:Name="SettingsItemsControl" 
                         ItemsSource="{x:Bind ViewModel.SettingItems, Mode=OneWay}"
                         ItemTemplateSelector="{StaticResource SettingItemTemplateSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>