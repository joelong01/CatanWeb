<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Catan3.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Catan3.Settings"
    xmlns:models="using:Catan3.Shared.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <CubicEase x:Key="StandardEaseInOut" EasingMode="EaseInOut"/>
        
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation 
                Storyboard.TargetName="SettingsContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="-350"
                To="0"
                Duration="0:0:0.3"
                EasingFunction="{StaticResource StandardEaseInOut}"/>
            <DoubleAnimation 
                Storyboard.TargetName="SettingsContainer"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.3"/>
        </Storyboard>
        
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation 
                Storyboard.TargetName="SettingsContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="0"
                To="-350"
                Duration="0:0:0.3"
                EasingFunction="{StaticResource StandardEaseInOut}"/>
            <DoubleAnimation 
                Storyboard.TargetName="SettingsContainer"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.3"/>
        </Storyboard>

        <!-- TextBox Setting Template -->
        <DataTemplate x:Key="TextBoxSettingTemplate" x:DataType="models:SettingItem">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <TextBox Text="{x:Bind TextValue, Mode=TwoWay}"
                         PlaceholderText="Enter value..."
                         Width="300"
                         HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- Directory Picker Setting Template -->
        <DataTemplate x:Key="DirectoryPickerSettingTemplate" x:DataType="models:SettingItem">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{x:Bind TextValue, Mode=TwoWay}"
                             PlaceholderText="Choose directory..."
                             Width="250"/>
                    <Button Content="Browse..." 
                           Style="{ThemeResource DefaultButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Dropdown Setting Template -->
        <DataTemplate x:Key="DropdownSettingTemplate" x:DataType="models:SettingItem">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{x:Bind Options, Mode=OneWay}"
                         SelectedItem="{x:Bind TextValue, Mode=TwoWay}"
                         Width="200"
                         HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- Checkbox Setting Template -->
        <DataTemplate x:Key="CheckboxSettingTemplate" x:DataType="models:SettingItem">
            <StackPanel Spacing="8">
                <CheckBox Content="{x:Bind Description, Mode=OneWay}"
                         IsChecked="{x:Bind BooleanValue, Mode=TwoWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Setting Item Template Selector (must be defined AFTER the templates it references) -->
        <local:SettingItemTemplateSelector x:Key="SettingItemTemplateSelector"
                TextBoxTemplate="{StaticResource TextBoxSettingTemplate}"
                DirectoryPickerTemplate="{StaticResource DirectoryPickerSettingTemplate}"
                DropdownTemplate="{StaticResource DropdownSettingTemplate}"
                CheckboxTemplate="{StaticResource CheckboxSettingTemplate}" />
    </Page.Resources>

    <Grid>
        <!-- Semi-transparent overlay for clicking outside to close -->
        <Rectangle Fill="Black" 
                   Opacity="0.3" 
                   Tapped="OnOverlayTapped"/>
        
        <!-- Settings Panel - positioned on the left side, not full height -->
        <Border x:Name="SettingsContainer" 
                Width="350"
                MaxHeight="600"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.RenderTransform>
                <TranslateTransform X="-350"/>
            </Border.RenderTransform>
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
                    <TextBlock Text="Settings" 
                              Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Configure game preferences and file locations" 
                              Style="{ThemeResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Dynamic Settings Content -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SettingsItemsControl" 
                                 ItemsSource="{x:Bind ViewModel.SettingItems, Mode=OneWay}"
                                 ItemTemplateSelector="{StaticResource SettingItemTemplateSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Buttons -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Button Content="Defaults" 
                           Style="{ThemeResource DefaultButtonStyle}"
                           Click="OnDefaults"
                           HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" 
                               Spacing="12" 
                               HorizontalAlignment="Right">
                        <Button Content="Close" 
                               Style="{ThemeResource DefaultButtonStyle}"
                               Click="OnClose"/>
                        <Button Content="Save" 
                               Style="{ThemeResource AccentButtonStyle}"
                               Click="OnSave"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>