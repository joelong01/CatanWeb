<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Catan3.Player.PlayerEditorPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Catan3.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="using:Catan3.Models"
        xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
        mc:Ignorable="d" Name="EditPage"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- PlayerSettings Control -->
        <c:PlayerSettingsCtrl x:Name="PlayerSettingsControl"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}" Grid.Row="0" Margin="0"/>
        <Button Content="Close" Click="CloseButton_Click" Grid.Row="1" HorizontalAlignment="Right" Margin="10" />
    </Grid>

</Page>
