<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
		<!-- Allow cross-platform IDEs (VS Code on macOS) to analyze this project -->
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>preview</LangVersion>
		<RootNamespace>Catan3</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<!-- Default platform for design-time builds (language server) when no platform specified -->
		<Platform Condition="'$(Platform)' == '' OR '$(Platform)' == 'AnyCPU'">x64</Platform>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
		<SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
		<StartupObject></StartupObject>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Configure for MSIX packaging -->
		<WindowsPackageType>MSIX</WindowsPackageType>
		<WindowsAppSDKBootstrapAutoInitializeOptions_Default>true</WindowsAppSDKBootstrapAutoInitializeOptions_Default>
		<!-- Optional developer-friendly prompts; keep disabled for CI
		<WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
		<WindowsAppSDKBootstrapAutoInitializeOptions_OnError_FailFast>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnError_FailFast>
		-->
		
		<!-- Package signing configuration -->
		<GenerateTemporaryStoreCertificate>true</GenerateTemporaryStoreCertificate>
		<PackageCertificateKeyFile>Catan Desktop_TemporaryKey.pfx</PackageCertificateKeyFile>
		<!-- Suppress warnings about version-specific runtime identifiers -->
		<NoWarn>$(NoWarn);NETSDK1206</NoWarn>
		
		<!-- Assembly and Product Information -->
		<AssemblyTitle>Catan Desktop</AssemblyTitle>
		<AssemblyDescription>Catan Desktop - Settlers of Catan companion game</AssemblyDescription>
		<AssemblyProduct>Catan Desktop</AssemblyProduct>
		<Product>Catan Desktop</Product>
		<Copyright>© 2025 Catan Desktop</Copyright>
		<Company>Catan Desktop</Company>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		
        <!-- Auto-deployment configuration (disabled by default to avoid nested publish copy issues) -->
        <AutoDeploy Condition="'$(AutoDeploy)' == ''">false</AutoDeploy>
        <PackageCertificateThumbprint>B8336920F26C7FB4AD1DDF3B48B837E8CA73CFE5</PackageCertificateThumbprint>
        <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
	</PropertyGroup>
	
	<!-- Custom deployment target - call manually with: dotnet build -t:BuildAndDeploy -->
    <Target Name="BuildAndDeploy">
		<Message Text="🚀 Starting deployment for $(Configuration) configuration ($(Platform))..." Importance="high" />
		
		<!-- Set deployment properties based on configuration -->
		<PropertyGroup>
			<DeploymentRuntimeIdentifier>win-$(Platform)</DeploymentRuntimeIdentifier>
			<DeploymentPublishDir>$(OutputPath)publish</DeploymentPublishDir>
			<DeploymentSingleFile Condition="'$(Configuration)' == 'Release'">true</DeploymentSingleFile>
			<DeploymentSingleFile Condition="'$(Configuration)' == 'Debug'">false</DeploymentSingleFile>
		</PropertyGroup>
		
        <!-- Clean and (re)create deployment directory to prevent recursive publish nesting -->
        <RemoveDir Directories="$(DeploymentPublishDir)" />
		<MakeDir Directories="$(DeploymentPublishDir)" />
		
		<!-- Copy build output to deployment directory -->
		<ItemGroup>
            <BuildOutputFiles Include="$(OutputPath)**\*" Exclude="$(DeploymentPublishDir)/**;$(OutputPath)ref/**;$(OutputPath)refint/**;$(OutputPath)**/publish/**" />
		</ItemGroup>
		
		<Copy SourceFiles="@(BuildOutputFiles)" DestinationFolder="$(DeploymentPublishDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
		      
		<Message Text="✅ Deployment completed successfully!" Importance="high" />
		<Message Text="📂 Deployed to: $(DeploymentPublishDir)" Importance="high" />
		<Message Text="💡 To disable auto-deployment, set AutoDeploy=false in project properties" Importance="normal" />
	</Target>
	
	<!-- Auto-deploy after successful build (now enabled by default) -->
	<Target Name="AutoDeploy" AfterTargets="AfterBuild" Condition="'$(AutoDeploy)' == 'true'">
		<Message Text="🔄 Auto-deploying $(Configuration) build..." Importance="high" />
		<CallTarget Targets="BuildAndDeploy" />
	</Target>

