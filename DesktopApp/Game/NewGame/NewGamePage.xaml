<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Catan3.NewGamePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3" xmlns:m="using:Catan3.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AutomationProperties.AutomationId="Page_NewGame" AutomationProperties.Name="Page_NewGame"
       
      x:Name="Page_NewGame">

    <Page.Resources>
        <DataTemplate x:Key="PlayerDataTemplate" x:DataType="m:PlayerViewModel">
            <Grid HorizontalAlignment="Stretch" Height="120"
                    Background="{x:Bind PlayerColors.BackgroundBrush, Mode=OneWay}"
                    AutomationProperties.AutomationId="{x:Bind Id, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                <Ellipse Name="Player_Picture" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Width="100" Height="100"
                        Stroke="{x:Bind PlayerColors.ForegroundBrush, Mode=OneWay}">
                    <Ellipse.Fill>
                        <ImageBrush
                                ImageSource="{x:Bind CroppedImageUri, Mode=OneWay}" />
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <SplitView x:Name="NewGameSplitView" OpenPaneLength="75" CompactPaneLength="0" 
            Margin="0" PanePlacement="Left"
            IsPaneOpen="{x:Bind ViewModel.ShowMenu, Mode=OneWay}"
            DisplayMode="CompactOverlay">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Hamburger Menu Button -->
            <AppBarButton Icon="GlobalNavigationButton" Click="OnShowMenu"
     HorizontalAlignment="Left" VerticalAlignment="Top" 
     Margin="0,0,0,20" />

            <StackPanel Name="LayoutRoot" HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <GridView Margin="10" HorizontalAlignment="Stretch" Width="624"
                    x:Name="ListView_Players" SelectionMode="Multiple"
                    AutomationProperties.AutomationId="PlayersGridView"
                    VerticalAlignment="Top" Background="Transparent"
                    SelectionChanged="{x:Bind ViewModel.Players_SelectionChanged}"
                    ItemsSource="{x:Bind ViewModel.Players, Mode=OneWay}"
                    ItemTemplate="{StaticResource PlayerDataTemplate}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid MaximumRowsOrColumns="6" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                </GridView>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Game Type:" Foreground="White" FontSize="22"
                        VerticalAlignment="Center" TextLineBounds="Tight"
                        HorizontalAlignment="Left" Margin="10" />

                    <ComboBox ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                        AutomationProperties.AutomationId="GameTypeCombo"
                        SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=OneWay}"
                        SelectionChanged="{x:Bind ViewModel.Game_SelectionChanged}"
                        SelectionChangedTrigger="Always" HorizontalAlignment="Right"
                        FontSize="22" Foreground="White" VerticalAlignment="Top"
                        Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Padding="20"
                    Width="{Binding ElementName=LayoutRoot, Path=Width}">
                    <Button Content="Open" Width="125" Margin="5" Click="OnOpen" />

                    <Button Content="Cancel" Width="100" Click="OnCancel" Margin="5"
                        Visibility="{x:Bind Frame.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Start" Width="100" Click="OnStart" Margin="5"
                        AutomationProperties.AutomationId="StartButton"
                        AutomationProperties.Name="StartButton"
                        HorizontalAlignment="Right"
                        IsEnabled="{x:Bind ViewModel.IsStartEnabled, Mode=OneWay}" />

                    <Button Content="Load Test File" Width="120" Click="OnRunTests"
                        Margin="5" HorizontalAlignment="Right" />

                </StackPanel>
            </StackPanel>
        </Grid>
        <SplitView.Pane>
            <StackPanel>
                <AppBarButton Label="Hide" Click="OnShowMenu" Icon="ClosePane" />
                <AppBarButton Label="Settings" Click="OnSettings" Icon="Setting" />
                <AppBarButton Label="Manage Players" Click="OnManagePlayers" Icon="People" />
                <AppBarButton Label="Main Menu" Click="OnCancel" Icon="Back" />
            </StackPanel>
        </SplitView.Pane>
    </SplitView>
</Page>
