<UserControl x:Class="Catan3.Controls.GameBoardCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="using:Catan3.Controls" xmlns:m="using:Catan3.Models"
        xmlns:u="using:Catan3.Utility"
        d:DataContext="{d:DesignInstance Type=m:GameViewModel}" mc:Ignorable="d"
        Canvas.ZIndex="1" d:DesignHeight="450" d:DesignWidth="800"
        AutomationProperties.AutomationId="GameBoardCtrl">
    <UserControl.Resources>
        <Storyboard x:Key="MoveRobberAnimation">
            <DoubleAnimation Storyboard.TargetName="VB_Robber"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransfrom.TranslateX)"
                    Duration="{StaticResource AnimationMedium}" To="100" />
            <DoubleAnimation Storyboard.TargetName="VB_Robber"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransfrom.TranslateY)"
                    Duration="{StaticResource AnimationMedium}" To="100" />
        </Storyboard>
        <Storyboard x:Name="SB_AnimateOpacity">
            <DoubleAnimation x:Name="DA_AnimateOpacity"
                    Storyboard.TargetName="VB_Robber"
                    Storyboard.TargetProperty="Opacity" BeginTime="{StaticResource AnimationDelay}"
                    Duration="{StaticResource AnimationMedium}" From="0.0" To="1.0" />
        </Storyboard>
    </UserControl.Resources>
    <Canvas Background="Transparent" HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Height="{x:Bind GameViewModel.BoardInfo.Layout.BoardHeight, Mode=OneWay}"
            Width="{x:Bind GameViewModel.BoardInfo.Layout.BoardWidth, Mode=OneWay}">
        <!--Harbors-->
        <ItemsControl x:Name="IC_Harbors"
                ItemsSource="{x:Bind GameViewModel.Harbors, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.ZIndex" Value="-1" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:HarborViewModel">
                    <c:HarborCtrl ViewModel="{x:Bind Mode=OneWay}"
                            VerticalAlignment="Top" HorizontalAlignment="Left">
                        <c:HarborCtrl.RenderTransform>
                            <CompositeTransform
                                    TranslateX="{x:Bind Left, Mode=OneWay}"
                                    TranslateY="{x:Bind Top, Mode=OneWay}" />
                        </c:HarborCtrl.RenderTransform>
                    </c:HarborCtrl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--Tiles-->
        <ItemsControl x:Name="IC_Tiles"
                AutomationProperties.AutomationId="GameBoardTiles"
                ItemsSource="{x:Bind GameViewModel.Tiles, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.ZIndex" Value="10" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:TileViewModel">
                    <c:TileCtrl TileViewModel="{x:Bind Mode=OneWay}"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Width="{Binding Layout.ControlWidth, Mode=OneWay}"
                            Height="{Binding Layout.ControlHeight, Mode=OneWay}"
                            RightTapped="Tile_RightMouseDown">
                        <c:TileCtrl.RenderTransform>
                            <CompositeTransform
                                    TranslateX="{x:Bind Left, Mode=OneWay}"
                                    TranslateY="{x:Bind Top, Mode=OneWay}" />
                        </c:TileCtrl.RenderTransform>
                    </c:TileCtrl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--Roads-->
        <ItemsControl x:Name="IC_Roads"
                AutomationProperties.AutomationId="IC_Roads"
                ItemsSource="{x:Bind GameViewModel.Roads, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.ZIndex" Value="20" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:RoadViewModel">
                    <c:RoadCtrl ViewModel="{x:Bind Mode=OneWay}"
                            Height="{Binding Layout.BuildingSize, Mode=OneWay}"
                            VerticalAlignment="Top" HorizontalAlignment="Left">
                        <c:RoadCtrl.RenderTransform>
                            <CompositeTransform
                                    TranslateX="{x:Bind Left, Mode=OneWay}"
                                    TranslateY="{x:Bind Top, Mode=OneWay}" />
                        </c:RoadCtrl.RenderTransform>
                    </c:RoadCtrl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--Buildings-->
        <ItemsControl x:Name="IC_Buildings"
                ItemsSource="{x:Bind GameViewModel.Buildings, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.ZIndex" Value="30" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:BuildingViewModel">
                    <c:BuildingCtrl BuildingViewModel="{x:Bind Mode=OneWay}"
                            Width="{Binding Layout.BuildingSize, Mode=OneWay}"
                            Height="{Binding Layout.BuildingSize, Mode=OneWay}"
                            VerticalAlignment="Top" HorizontalAlignment="Left">
                        <c:BuildingCtrl.RenderTransform>
                            <CompositeTransform
                                    TranslateX="{x:Bind Left, Mode=OneWay}"
                                    TranslateY="{x:Bind Top, Mode=OneWay}" />
                        </c:BuildingCtrl.RenderTransform>
                    </c:BuildingCtrl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--Robber-->
        <Viewbox x:Name="VB_Robber" Stretch="Uniform"
                Height="{x:Bind RobberHeight(GameViewModel.BoardInfo.Layout.OuterHexSize), Mode=OneWay}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="0,0,0,0">
            <Viewbox.RenderTransform>
                <CompositeTransform />
            </Viewbox.RenderTransform>
            <u:FlipperCtrl
                    Orientation="{x:Bind GameViewModel.RobberViewModel.Orientation, Mode=OneWay}">
                <u:FlipperCtrl.Front>
                    <Grid Opacity=".75">
                        <TextBlock FontFamily="{StaticResource CatanFont}"
                                FontSize="100" Text="&#xE925;"
                                Foreground="{x:Bind GameViewModel.RobberViewModel.Background(GameViewModel.RobberViewModel.RobberModel, GameViewModel.RobberViewModel.RobberModel.MovedBy), Mode=OneWay}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        <TextBlock FontFamily="Catan" FontSize="80"
                                Text="&#xE90C;"
                                Foreground="{x:Bind GameViewModel.RobberViewModel.Foreground(GameViewModel.RobberViewModel.RobberModel, GameViewModel.RobberViewModel.RobberModel.MovedBy), Mode=OneWay}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        <TextBlock FontFamily="Segoe UI" FontSize="22"
                                Text="{x:Bind GameViewModel.RobberViewModel.BIND_ResourcesStolen(GameViewModel.RobberViewModel.RobberModel, GameViewModel.RobberViewModel.RobberModel.ResourcesStolen), Mode=OneWay}"
                                Foreground="{x:Bind GameViewModel.RobberViewModel.Foreground(GameViewModel.RobberViewModel.RobberModel, GameViewModel.RobberViewModel.RobberModel.MovedBy), Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                TextAlignment="Center" />
                    </Grid>
                </u:FlipperCtrl.Front>
                <u:FlipperCtrl.Back>
                    <Grid Opacity="0" />
                </u:FlipperCtrl.Back>
            </u:FlipperCtrl>
        </Viewbox>
    </Canvas>
</UserControl>
