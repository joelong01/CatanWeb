<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Catan3.App"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Ensure converters are available before dictionaries that reference them -->
                <ResourceDictionary Source="ValueConverters/ConverterDictionary.xaml" />
                <ResourceDictionary Source="Themes/Generic.xaml" />
                <ResourceDictionary Source="Themes/StyleResourceDictionary.xaml" />
                <ResourceDictionary Source="Themes/ImageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Centralized Animation Durations -->
            <!-- These are updated to Duration.Forever (zero) when in test mode -->
            <Duration x:Key="AnimationFast">0:0:0.1</Duration>
            <Duration x:Key="AnimationMedium">0:0:0.25</Duration>
            <Duration x:Key="AnimationSlow">0:0:0.5</Duration>
            <Duration x:Key="AnimationExtraSlow">0:0:2</Duration>
            <Duration x:Key="AnimationButtonPress">0:0:0.2</Duration>
            <Duration x:Key="AnimationColorTransition">0:0:0.3</Duration>
            <Duration x:Key="AnimationDelay">0:0:1</Duration>
        </ResourceDictionary>
    </Application.Resources>
</Application>
