<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".txt" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Diagnostics" #>
<#
    string templateDirectory = Host.ResolvePath(""); // Resolves the path of the directory containing the T4 template.
    string exePath = @"..\ModelGenerator\bin\Debug\net8.0\ModelGenerator.exe"; // Path to your console application's executable.

    ProcessStartInfo startInfo = new ProcessStartInfo()
    {
        FileName = exePath,
        Arguments = $"\"{templateDirectory}\"", // Passing the template directory as an argument to your console application.
        UseShellExecute = false,
        RedirectStandardOutput = true, // Assuming you want to capture output from the console app.
        CreateNoWindow = true
    };

    using (Process process = Process.Start(startInfo))
    {
        process.WaitForExit(); // Wait for the console app to complete.
        string output = process.StandardOutput.ReadToEnd(); // Read the output from the console app.
        Write(output); // Write the output to the T4 template's output, which could be useful for debugging or logging.
    }
#>
