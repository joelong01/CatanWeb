<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.TileCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:u="using:Catan3.Utility" xmlns:m="using:Catan3.Models"
        xmlns:c="using:Catan3.Controls"
        d:DataContext="{d:DesignInstance Type=m:TileViewModel}" mc:Ignorable="d">

    <Control.Resources>
        <Storyboard x:Name="DimAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="CANVAS_LayoutRoot" To="0.5"
                    Duration="0:0:0.5" AutoReverse="False" />
        </Storyboard>
        <Storyboard x:Name="RevertAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Storyboard.TargetName="CANVAS_LayoutRoot"
                    Duration="0:0:0.5" AutoReverse="False" />
        </Storyboard>
    </Control.Resources>

    <Canvas Name="CANVAS_LayoutRoot"
            Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
            Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">
        <u:FlipperCtrl
                Orientation="{x:Bind TileViewModel.Orientation, Mode=OneWay}">
            <u:FlipperCtrl.Back>
                <Canvas Name="C_Back" Canvas.ZIndex="1"
                        Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
                        Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">
                    <Polygon Stroke="{StaticResource bmCherry}"
                            StrokeThickness="{x:Bind TileViewModel.Layout.TileGap, Mode=OneWay}"
                            Points="{Binding Layout.OuterHexPoints, Mode=OneWay}"
                            Fill="{StaticResource bmWater}" />
                    <Canvas.Projection>
                        <PlaneProjection RotationY="-90" />
                    </Canvas.Projection>
                </Canvas>
            </u:FlipperCtrl.Back>
            <u:FlipperCtrl.Front>
                <Canvas Name="C_Front" HorizontalAlignment="Left" 
                        VerticalAlignment="Top"
                        Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
                        Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}"
                        RightTapped="OnRightClicked">


                    <Canvas.Projection>
                        <PlaneProjection RotationY="0" />
                    </Canvas.Projection>
                    <Polygon Stroke="{StaticResource bmCherry}"
                            StrokeThickness="{x:Bind TileViewModel.Layout.TileGap, Mode=OneWay}"
                            Points="{x:Bind TileViewModel.Layout.OuterHexPoints, Mode=OneWay}"
                            Fill="{x:Bind TileViewModel.GetTileBorderBrush(TileViewModel.Tile, TileViewModel.Tile.Highlighted), Mode=OneWay}" />
                    <Polygon Stroke="Transparent"
                            StrokeThickness="{Binding Layout.InnerHexStrokeThickness, Mode=OneWay}"
                            Points="{x:Bind TileViewModel.Layout.InnerHexPoints, Mode=OneWay}"
                            Fill="{x:Bind TileViewModel.GetTileResourceType(TileViewModel.Tile, TileViewModel.Tile.TemporarilyGold, TileViewModel.Tile.ResourceTileType), Mode=OneWay}" />
                    <Polygon Stroke="Blue" StrokeDashArray="1 1"
                            StrokeThickness="{x:Bind TileViewModel.Layout.LayoutGuideStrokeWidth, Mode=OneWay}"
                            Points="{x:Bind TileViewModel.Layout.PointyHexPoints, Mode=OneWay}"
                            Fill="Transparent" />
                    <Grid BorderBrush="Black" BorderThickness="0"
                            Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
                            Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">
                        <Grid Width="65" Height="65" VerticalAlignment="Top"
                                Margin="0" HorizontalAlignment="Center"
                                RenderTransformOrigin=".5 0"
                                Visibility="{x:Bind TileViewModel.Tile.Number, Mode=OneWay, Converter={StaticResource NumberToVisibilityConverter}}">
                            <c:CatanNumber
                                    Number="{x:Bind TileViewModel.Tile.Number, Mode=OneWay}" />
                            <Grid.RenderTransform>
                                <CompositeTransform
                                        ScaleX="{x:Bind NumberScale(TileViewModel.Layout.OuterHexSize), Mode=OneWay}"
                                        ScaleY="{x:Bind NumberScale(TileViewModel.Layout.OuterHexSize), Mode=OneWay}"
                                        TranslateY="{x:Bind NumberTop(TileViewModel.Layout.TileGap, TileViewModel.Layout.InnerHexStrokeThickness), Mode=OneWay}" />
                            </Grid.RenderTransform>
                        </Grid>
                        <Viewbox Height="50" Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0, 50, 0, 0">
                            <u:FlipperCtrl
                                    Orientation="{x:Bind TileViewModel.TempGoldOrientation(TileViewModel.Tile, TileViewModel.Tile.TemporarilyGold), Mode=OneWay}">
                                <u:FlipperCtrl.Front>
                                    <Border CornerRadius="5" Width="67"
                                            Height="100" BorderThickness=".5">
                                        <Rectangle RadiusX="1" RadiusY="1"
                                                Fill="{x:Bind TileViewModel.GetResourceImage(TileViewModel.Tile, TileViewModel.Tile.ResourceTileType), Mode=OneWay}" />
                                    </Border>
                                </u:FlipperCtrl.Front >
                                <u:FlipperCtrl.Back>
                                    <Grid Opacity="0" Background="Black"
                                            Width="67" Height="100"
                                            CornerRadius="5" />
                                </u:FlipperCtrl.Back>
                            </u:FlipperCtrl>
                        </Viewbox>
                        <Grid Name="GRID_TileCoordinates" Background="Black"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="{x:Bind CooordinateTextMargin(TileViewModel.Layout.TileGap, TileViewModel.Layout.InnerHexStrokeThickness), Mode=OneWay}"
                                Height="25">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="10" />
                            </Grid.RenderTransform>
                            <Viewbox Stretch="Uniform">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Visibility="{x:Bind TileViewModel.TileIndexVisability, Mode=OneWay}" TextLineBounds="Tight"
                                            Text="{x:Bind TileViewModel.Index, Mode=OneWay}"
                                            HorizontalAlignment="Center"
                                            Foreground="White" />
                                    <TextBlock  Visibility="Collapsed"
                                            Text="{x:Bind TileViewModel.Tile.TileKey}"
                                            HorizontalAlignment="Center"
                                            Foreground="White" />
                                </StackPanel>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Canvas>
            </u:FlipperCtrl.Front>
        </u:FlipperCtrl>
    </Canvas>
</UserControl>
