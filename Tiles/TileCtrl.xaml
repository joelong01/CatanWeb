<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.TileCtrl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:m="using:Catan3.Models"
        d:DataContext="{d:DesignInstance Type=m:TileViewModel}" mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="PipsStyle">
            <Setter Property="Text" Value="" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

    </UserControl.Resources>
    <Canvas Name="CANVAS_LayoutRoot"
            Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
            Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">
        <Canvas Name="C_Back" Canvas.ZIndex="1"
                Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
                Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">
            <Polygon Stroke="PaleVioletRed"
                    StrokeThickness="{x:Bind TileViewModel.Layout.TileGap, Mode=OneWay}"
                    Points="{Binding Layout.OuterHexPoints, Mode=OneWay}"
                    Fill="{StaticResource bmWater}" />
            <Canvas.Projection>
                <PlaneProjection RotationY="-90" />
            </Canvas.Projection>
        </Canvas>
        <Canvas Name="C_Front" HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
                Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">
            <Canvas.Projection>
                <PlaneProjection RotationY="0" />
            </Canvas.Projection>
            <Polygon Stroke="PaleVioletRed"
                    StrokeThickness="{x:Bind TileViewModel.Layout.TileGap, Mode=OneWay}"
                    Points="{x:Bind TileViewModel.Layout.OuterHexPoints, Mode=OneWay}"
                    Fill="{StaticResource bmMaple}" />

            <Polygon Stroke="Transparent"
                    StrokeThickness="{Binding Layout.InnerHexStrokeThickness, Mode=OneWay}"
                    Points="{x:Bind TileViewModel.Layout.InnerHexPoints, Mode=OneWay}"
                    Fill="{x:Bind TileViewModel.Tile.ResourceTileType, Mode=OneWay, Converter={StaticResource ResourceTypeToImageBrush}}" />

            <Polygon Stroke="Blue" StrokeDashArray="1 1"
                    StrokeThickness="{x:Bind TileViewModel.Layout.LayoutGuideStrokeWidth, Mode=OneWay}"
                    Points="{x:Bind TileViewModel.Layout.PointyHexPoints, Mode=OneWay}"
                    Fill="Transparent" />

            <Grid BorderBrush="Black" BorderThickness="0"
                    Width="{x:Bind TileViewModel.Layout.ControlWidth, Mode=OneWay}"
                    Height="{x:Bind TileViewModel.Layout.ControlHeight, Mode=OneWay}">

                <Grid Width="65" Height="65" VerticalAlignment="Top" Margin="0"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin=".5 0"
                        Visibility="{x:Bind TileViewModel.Tile.Number, Mode=OneWay, Converter={StaticResource NumberToVisibilityConverter}}">

                    <Ellipse Fill="#FF2F6999" Stroke="White"
                            StrokeThickness=".5" Opacity=".75" />

                    <TextBlock FontFamily="Segoe UI" FontWeight="Bold"
                            Text="{x:Bind TileViewModel.Tile.Number, Mode=OneWay}"
                            Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            FontSize="24" />
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource PipsStyle}"
                                Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 0), Mode=OneWay}"
                                Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PipsStyle}"
                                Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 1), Mode=OneWay}"
                                Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PipsStyle}"
                                Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 2), Mode=OneWay}"
                                Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PipsStyle}"
                                Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 3), Mode=OneWay}"
                                Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PipsStyle}"
                                Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 4), Mode=OneWay}"
                                Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                    </StackPanel>
                    <Grid.RenderTransform>
                        <CompositeTransform
                                ScaleX="{x:Bind NumberScale(TileViewModel.Layout.OuterHexSize), Mode=OneWay}"
                                ScaleY="{x:Bind NumberScale(TileViewModel.Layout.OuterHexSize), Mode=OneWay}"
                                TranslateY="{x:Bind NumberTop(TileViewModel.Layout.TileGap, TileViewModel.Layout.InnerHexStrokeThickness), Mode=OneWay}" />

                    </Grid.RenderTransform>
                </Grid>
                <Grid Background="Black" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="{x:Bind CooordinateTextMargin(TileViewModel.Layout.TileGap, TileViewModel.Layout.InnerHexStrokeThickness), Mode=OneWay}"
                        Height="32">
                    <Viewbox Stretch="Uniform">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock
                                    Text="{x:Bind TileViewModel.Index, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    Foreground="White" />
                            <TextBlock
                                    Text="{x:Bind TileViewModel.Tile.TileKey}"
                                    HorizontalAlignment="Center"
                                    Foreground="White" />
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </Grid>
        </Canvas>
    </Canvas>
</UserControl>
