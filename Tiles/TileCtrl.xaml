<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.TileCtrl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:Catan3.Controls"
        xmlns:m="using:Catan3.Models" d:DataContext="{d:DesignInstance Type=m:TileViewModel}" mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="PipsStyle">
            <Setter Property="Text" Value="" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />

        </Style>
    </UserControl.Resources>

    <Grid BorderBrush="Green" BorderThickness="1" Width="{Binding Layout.ControlWidth, Mode=OneWay}"
            Height="{Binding Layout.ControlHeight, Mode=OneWay}">
        <Polygon Stroke="Black"
                StrokeThickness="{Binding Layout.InnerHexStrokeThickness, Mode=OneWay}"
                Points="{Binding Layout.InnerHexPoints,Mode=OneWay}"
                Fill="{Binding Tile.ResourceType, Mode=OneWay, Converter={StaticResource ResourceTypeToImageBrush}}" />
        <Polygon Stroke="Red" StrokeThickness="2" Points="{x:Bind TileViewModel.Layout.OuterHexPoints, Mode=OneWay}"
                StrokeDashArray=".5 1" Fill="Transparent" Visibility="Visible" />
        <Grid Width="65" Height="65" VerticalAlignment="Top" Margin="0" HorizontalAlignment="Center"
                RenderTransformOrigin=".5 0"
                Visibility="{x:Bind TileViewModel.Tile.Number, Mode=OneWay, Converter={StaticResource NumberToVisibilityConverter}}">

            <Ellipse Fill="#FF2F6999" Stroke="White" StrokeThickness=".5" Opacity=".75" />

            <TextBlock FontFamily="Segoe UI" FontWeight="Bold" Text="{x:Bind TileViewModel.Tile.Number, Mode=OneWay}"
                    Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}"
                    VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="24" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="0,10,0,0">
                <TextBlock Style="{StaticResource PipsStyle}"
                        Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 0), Mode=OneWay}"
                        Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                <TextBlock Style="{StaticResource PipsStyle}"
                        Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 1), Mode=OneWay}"
                        Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                <TextBlock Style="{StaticResource PipsStyle}"
                        Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 2), Mode=OneWay}"
                        Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                <TextBlock Style="{StaticResource PipsStyle}"
                        Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 3), Mode=OneWay}"
                        Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
                <TextBlock Style="{StaticResource PipsStyle}"
                        Visibility="{x:Bind PipsVisibility(TileViewModel.Tile.Number, 4), Mode=OneWay}"
                        Foreground="{x:Bind GetPipsForeground(TileViewModel.Tile.Number), Mode=OneWay}" />
            </StackPanel>
            <Grid.RenderTransform>
                <CompositeTransform ScaleX="{x:Bind NumberScale(TileViewModel.Layout.OuterHexSize), Mode=OneWay}"
                        ScaleY="{x:Bind NumberScale(TileViewModel.Layout.OuterHexSize), Mode=OneWay}"
                        TranslateY="{x:Bind NumberTop(TileViewModel.Layout.TileGap, TileViewModel.Layout.InnerHexStrokeThickness), Mode=OneWay}" />

            </Grid.RenderTransform>
        </Grid>
        <Grid Background="Black" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Height="16">
            <Viewbox Stretch="Uniform">
                <TextBlock Text="{x:Bind TileViewModel.Tile.TileKey}" Foreground="White" />
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>
