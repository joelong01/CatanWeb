{
  "name": "Expansion Test Complete Flow",
  "description": "Full game flow from board setup through allocation phase, main game start with soldier purchase, robber movement, and supplemental building phase",
  "testFilePath": "Assets/TestFiles/Expansion-Test.catan",
  "gameType": "Expansion",
  "expectedPlayerCount": 5,
  "expectedFinalState": "WaitingForRoll",
  "timeoutMs": 300000,
  "recordMode": false,
  "actions": [
    {
      "type": "AdvanceNext",
      "playerId": "Joe-001",
      "expectedState": "WaitingForRollForOrder",
      "description": "Initial board setup transition"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Joe-001",
      "expectedState": "FinishedRollOrder",
      "description": "Roll order transition"
    },
    {
      "type": "GoFirst",
      "playerId": "Dodgy-001",
      "expectedState": "FinishedRollOrder",
      "parameters": {
        "playerId": "Dodgy-001"
      },
      "description": "Dodgy clicks Go First to reorder players"
    },
    {
      "type": "GoFirst",
      "playerId": "Doug-001",
      "expectedState": "FinishedRollOrder",
      "parameters": {
        "playerId": "Doug-001"
      },
      "description": "Doug clicks Go First to become first player"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "expectedState": "BeginResourceAllocation",
      "description": "Begin allocation phase"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "expectedState": "AllocateResourceForward",
      "description": "Start allocation forward"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Doug-001",
      "expectedState": "AllocateResourceForward",
      "parameters": {
        "automationId": "Building-(-3,3,0)-Right"
      },
      "description": "Doug places first settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Doug-001",
      "parameters": {
        "automationId": "Road-(-2,2,0)-Bottom"
      },
      "description": "Doug places first road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "description": "Doug advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Ryan-001",
      "expectedState": "AllocateResourceForward",
      "parameters": {
        "automationId": "Building-(-1,0,1)-BottomRight"
      },
      "description": "Ryan places first settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Ryan-001",
      "parameters": {
        "automationId": "Road-(-1,1,0)-TopRight"
      },
      "description": "Ryan places first road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Ryan-001",
      "description": "Ryan advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Adrian-001",
      "expectedState": "AllocateResourceForward",
      "parameters": {
        "buildingKey": "(1,-1,0)-BottomRight"
      },
      "description": "Adrian places first settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Adrian-001",
      "parameters": {
        "roadKey": "(1,0,-1)-TopRight"
      },
      "description": "Adrian places first road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Adrian-001",
      "description": "Adrian advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Joe-001",
      "expectedState": "AllocateResourceForward",
      "parameters": {
        "buildingKey": "(2,-1,-1)-Right"
      },
      "description": "Joe places first settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Joe-001",
      "parameters": {
        "roadKey": "(2,-1,-1)-BottomRight"
      },
      "description": "Joe places first road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Joe-001",
      "description": "Joe advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Dodgy-001",
      "expectedState": "AllocateResourceForward",
      "parameters": {
        "buildingKey": "(1,-2,1)-BottomRight"
      },
      "description": "Dodgy places first settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Dodgy-001",
      "parameters": {
        "roadKey": "(1,-2,1)-Bottom"
      },
      "description": "Dodgy places first road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Dodgy-001",
      "expectedState": "AllocateResourceReverse",
      "description": "Dodgy advances - triggers reverse allocation"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Dodgy-001",
      "expectedState": "AllocateResourceReverse",
      "parameters": {
        "buildingKey": "(0,2,-2)-Right"
      },
      "description": "Dodgy places second settlement (reverse order)"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Dodgy-001",
      "parameters": {
        "roadKey": "(0,2,-2)-BottomRight"
      },
      "description": "Dodgy places second road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Dodgy-001",
      "description": "Dodgy advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Joe-001",
      "expectedState": "AllocateResourceReverse",
      "parameters": {
        "buildingKey": "(2,0,-2)-Right"
      },
      "description": "Joe places second settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Joe-001",
      "parameters": {
        "roadKey": "(2,0,-2)-BottomRight"
      },
      "description": "Joe places second road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Joe-001",
      "description": "Joe advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Adrian-001",
      "expectedState": "AllocateResourceReverse",
      "parameters": {
        "automationId": "Building-(-3,2,1)-Right"
      },
      "description": "Adrian places second settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Adrian-001",
      "parameters": {
        "automationId": "Road-(-2,1,1)-Bottom"
      },
      "description": "Adrian places second road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Adrian-001",
      "description": "Adrian advances to next player"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Ryan-001",
      "expectedState": "AllocateResourceReverse",
      "parameters": {
        "buildingKey": "(0,-1,1)-BottomRight"
      },
      "description": "Ryan places second settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Ryan-001",
      "parameters": {
        "roadKey": "(0,0,0)-TopRight"
      },
      "description": "Ryan places wrong road (will be undone)"
    },
    {
      "type": "PreviousBoard",
      "playerId": "Ryan-001",
      "description": "Ryan undoes incorrect road placement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Ryan-001",
      "parameters": {
        "roadKey": "(0,-1,1)-Bottom"
      },
      "description": "Ryan places correct road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Ryan-001",
      "description": "Ryan completes turn"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Doug-001",
      "expectedState": "AllocateResourceReverse",
      "parameters": {
        "buildingKey": "(1,0,-1)-BottomRight"
      },
      "description": "Doug places second settlement"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Doug-001",
      "parameters": {
        "roadKey": "(1,0,-1)-Bottom"
      },
      "description": "Doug places second road"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "expectedState": "DoneResourceAllocation",
      "description": "Doug completes allocation phase"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "expectedState": "WaitingForRoll",
      "description": "Start main game"
    },
    {
      "type": "PurchaseSoldier",
      "playerId": "Doug-001",
      "expectedState": "MustMoveRobber",
      "description": "Doug purchases soldier to move robber"
    },
    {
      "type": "MoveRobber",
      "playerId": "Doug-001",
      "parameters": {
        "coordinates": "(1,-2,1)",
        "targetPlayerId": "Dodgy-001"
      },
      "description": "Doug moves robber and targets Dodgy"
    },
    {
      "type": "RollDice",
      "playerId": "Doug-001",
      "expectedState": "WaitingForNext",
      "parameters": {
        "roll": 6
      },
      "description": "Doug rolls dice"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "expectedState": "PickSupplementalPlayers",
      "description": "Advance to supplemental player selection"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Doug-001",
      "expectedState": "Supplemental",
      "description": "Start supplemental building phase"
    },
    {
      "type": "PurchaseRoad",
      "playerId": "Adrian-001",
      "expectedState": "Supplemental",
      "description": "Adrian purchases road"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Adrian-001",
      "parameters": {
        "automationId": "Road-(-3,2,1)-BottomRight"
      },
      "description": "Adrian places first road"
    },
    {
      "type": "PurchaseRoad",
      "playerId": "Adrian-001",
      "description": "Adrian purchases another road"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Adrian-001",
      "parameters": {
        "automationId": "Road-(-3,2,1)-Bottom"
      },
      "description": "Adrian places second road"
    },
    {
      "type": "PurchaseCity",
      "playerId": "Adrian-001",
      "description": "Adrian purchases city"
    },
    {
      "type": "UpgradeToCity",
      "playerId": "Adrian-001",
      "parameters": {
        "automationId": "Building-(-3,2,1)-Right"
      },
      "description": "Adrian upgrades settlement to city"
    },
    {
      "type": "PurchaseRoad",
      "playerId": "Adrian-001",
      "description": "Adrian purchases road (will undo)"
    },
    {
      "type": "PreviousBoard",
      "playerId": "Adrian-001",
      "description": "Adrian undoes road purchase"
    },
    {
      "type": "PurchaseSettlement",
      "playerId": "Adrian-001",
      "description": "Adrian purchases settlement instead"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Adrian-001",
      "parameters": {
        "automationId": "Building-(-3,2,1)-BottomLeft"
      },
      "description": "Adrian places new settlement"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Adrian-001",
      "description": "Adrian completes supplemental turn"
    },
    {
      "type": "PurchaseRoad",
      "playerId": "Joe-001",
      "expectedState": "Supplemental",
      "description": "Joe purchases road"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Joe-001",
      "parameters": {
        "roadKey": "(2,0,-2)-TopRight"
      },
      "description": "Joe places first road"
    },
    {
      "type": "PurchaseRoad",
      "playerId": "Joe-001",
      "description": "Joe purchases second road"
    },
    {
      "type": "PurchaseRoad",
      "playerId": "Joe-001",
      "description": "Joe purchases third road"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Joe-001",
      "parameters": {
        "roadKey": "(2,1,-3)-TopRight"
      },
      "description": "Joe places second road"
    },
    {
      "type": "PlaceRoad",
      "playerId": "Joe-001",
      "parameters": {
        "roadKey": "(3,0,-3)-Bottom"
      },
      "description": "Joe places third road"
    },
    {
      "type": "PurchaseSettlement",
      "playerId": "Joe-001",
      "description": "Joe purchases settlement"
    },
    {
      "type": "PlaceSettlement",
      "playerId": "Joe-001",
      "parameters": {
        "buildingKey": "(3,0,-3)-BottomRight"
      },
      "description": "Joe places new settlement"
    },
    {
      "type": "PurchaseCity",
      "playerId": "Joe-001",
      "description": "Joe purchases city"
    },
    {
      "type": "UpgradeToCity",
      "playerId": "Joe-001",
      "parameters": {
        "buildingKey": "(2,-1,-1)-Right"
      },
      "description": "Joe upgrades original settlement to city"
    },
    {
      "type": "AdvanceNext",
      "playerId": "Joe-001",
      "description": "Joe completes supplemental turn"
    }
  ]
}