<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Catan3.Controls.SingleRoll"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Catan3.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="RollTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel>

            <TextBlock
                    Text="{x:Bind GameRolls.GetRollCount(GameRolls.GameRollModel, ValidCatanRoll), Mode=OneWay}"
                    Style="{StaticResource RollTextStyle}" />

            <Button Command="{x:Bind TurnRoll.NormalRollCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind ValidCatanRoll, Mode=OneWay}">
                <Viewbox Stretch="Uniform" Height="80">
                    <local:CatanNumber Number="{x:Bind Number, Mode=OneWay}" />
                </Viewbox>
            </Button>
            <TextBlock
                    Text="{x:Bind GameRolls.GetRollPercent(GameRolls.GameRollModel, ValidCatanRoll), Mode=OneWay}"
                    Style="{StaticResource RollTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
