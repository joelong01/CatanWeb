<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="TextBlock" x:Key="NumberStarStyle">
        <Setter Property="Text" Value="" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="GameControllerStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="SlateGray" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style x:Key="ControlGridTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,-2" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>
    <Style TargetType="Grid" x:Key="Grid_ResourceCard">
        <Setter Property="Width" Value="67" />
        <Setter Property="Height" Value="100" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
</ResourceDictionary>
